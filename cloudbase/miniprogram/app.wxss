/* ============================================================
   全局样式 —— 与管理端运营中台 prototype/assets/console.css 同一套视觉
   色板、圆角、阴影、字号口径保持一致
   ============================================================ */

page {
  --brand: #4F46E5;
  --brand-2: #6366F1;
  --brand-soft: #EEF2FF;
  --brand-line: #DDE2FF;
  --ink: #101828;
  --ink-2: #344054;
  --muted: #667085;
  --line: #E7E9F0;
  --line-2: #F4F5F9;
  --paper: #F4F5F9;
  --card: #FFFFFF;
  --warn: #DC6803;
  --warn-soft: #FFF4E5;
  --warn-line: #F7DFC0;
  --danger: #D92D20;
  --danger-soft: #FEF0EF;
  --danger-line: #F5C2BE;
  --info: #0BA5EC;
  --info-soft: #E8F7FE;
  --info-line: #C6EAFB;
  --radius: 32rpx;
  --radius-sm: 20rpx;
  --shadow: 0 1rpx 4rpx rgba(16, 24, 40, .04), 0 16rpx 48rpx rgba(16, 24, 40, .05);

  background: var(--paper);
  color: var(--ink);
  font-size: 28rpx;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "PingFang SC", "Helvetica Neue", "Microsoft YaHei", sans-serif;
  -webkit-font-smoothing: antialiased;
}

view, text, button, input, textarea, scroll-view, swiper, swiper-item {
  box-sizing: border-box;
}

button {
  margin: 0;
  padding: 0;
  background: none;
  border: none;
  line-height: inherit;
  font-size: inherit;
  color: inherit;
}
button::after {
  border: none;
}

/* ============================================================
   组件级通用
   ============================================================ */

/* 容器 */
.page {
  min-height: 100vh;
  padding-bottom: 180rpx;
  box-sizing: border-box;
}

/* chip 标签 */
.chip {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  font-size: 22rpx;
  line-height: 36rpx;
  padding: 0 14rpx;
  border-radius: 10rpx;
  border: 1rpx solid var(--line);
  background: #fff;
  color: var(--ink-2);
  white-space: nowrap;
}
.chip.solid {
  background: var(--line-2);
  border-color: var(--line-2);
}
.chip.brand {
  border-color: var(--brand-line);
  background: var(--brand-soft);
  color: var(--brand);
}
.chip.warn {
  border-color: var(--warn-line);
  background: var(--warn-soft);
  color: var(--warn);
}
.chip.danger {
  border-color: var(--danger-line);
  background: var(--danger-soft);
  color: var(--danger);
}
.chip.info {
  border-color: var(--info-line);
  background: var(--info-soft);
  color: var(--info);
}
.chip.ghost {
  background: transparent;
  color: var(--muted);
}
.chip.on {
  border-color: var(--brand);
  background: var(--brand-soft);
  color: var(--brand);
  font-weight: 600;
}
/* 不可选：如保密发布时强制只能普通发布 */
.chip.disabled {
  border-color: var(--line-2);
  background: var(--line-2);
  color: var(--muted);
  font-weight: 400;
  opacity: .7;
}
.chip.lg {
  font-size: 24rpx;
  line-height: 44rpx;
  padding: 0 18rpx;
  border-radius: 12rpx;
}

/* 胶囊标签：flex 行内不压缩、不换行，避免与相邻元素挤在一起 */
.pill-tag {
  display: inline-block;
  flex: none;
  white-space: nowrap;
  font-size: 20rpx;
  line-height: 32rpx;
  padding: 0 10rpx;
  border-radius: 8rpx;
  background: var(--brand);
  color: #fff;
  letter-spacing: .02em;
  font-weight: 500;
}
.pill-tag.rent {
  background: var(--info);
}
.pill-tag.buy {
  background: var(--warn);
}
.pill-tag.soft {
  background: var(--brand-soft);
  color: var(--brand);
}

/* 按钮 */
.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  height: 76rpx;
  padding: 0 32rpx;
  border-radius: 16rpx;
  border: 1rpx solid var(--line);
  background: #fff;
  color: var(--ink);
  font-size: 28rpx;
  font-weight: 500;
}
.btn.primary {
  background: linear-gradient(180deg, #6366F1, #4F46E5);
  border-color: #4F46E5;
  color: #fff;
  box-shadow: 0 8rpx 20rpx rgba(79, 70, 229, .22);
}
.btn.primary:active {
  background: var(--brand);
  border-color: var(--brand);
  box-shadow: none;
}
.btn.ghost {
  background: transparent;
  border-color: transparent;
  color: var(--muted);
}
.btn.ghost:active {
  background: var(--line-2);
}
/* 分享 / 复制等次级按钮需要可见的底色与描边，避免在详情页看不出按钮边界 */
.btn.ghost.share-btn {
  background: var(--card, #fff);
  border: 1rpx solid var(--line);
  color: var(--ink-2, var(--ink));
}
.btn.ghost.share-btn:active {
  background: var(--line-2);
}
.btn.danger {
  color: var(--danger);
  border-color: var(--danger-line);
  background: var(--danger-soft);
}
/* 全宽按钮：重置 .block 容器样式，避免被区块的 margin / padding 影响 */
.btn.block {
  width: 100%;
  margin: 0;
  padding: 0 32rpx;
  border-radius: 16rpx;
}
.btn.sm {
  height: 56rpx;
  padding: 0 20rpx;
  font-size: 24rpx;
  border-radius: 12rpx;
}
.btn.lg {
  height: 92rpx;
  font-size: 30rpx;
  border-radius: 18rpx;
}
.btn[disabled] {
  background: var(--line-2) !important;
  border-color: var(--line) !important;
  color: #A1A1AA !important;
}

/* 提醒块 */
.callout {
  border: 1rpx solid var(--line);
  background: var(--line-2);
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  font-size: 24rpx;
  line-height: 1.65;
  color: var(--ink-2);
}
.callout .ttl {
  font-weight: 600;
  font-size: 24rpx;
  margin-bottom: 6rpx;
  color: var(--ink);
}
.callout.brand {
  border-color: var(--brand-line);
  background: var(--brand-soft);
}
.callout.brand .ttl {
  color: var(--brand);
}
.callout.warn {
  border-color: var(--warn-line);
  background: var(--warn-soft);
}
.callout.warn .ttl {
  color: var(--warn);
}
.callout.danger {
  border-color: var(--danger-line);
  background: var(--danger-soft);
}
.callout.danger .ttl {
  color: var(--danger);
}
.callout.info {
  border-color: var(--info-line);
  background: var(--info-soft);
}
.callout.info .ttl {
  color: var(--info);
}

/* 主体信息填写前的保密提示：与后续字段拉开间距 */
.sec-tip {
  margin: 0 0 20rpx;
}

/* 区块 */
.block {
  background: var(--card);
  margin: 20rpx 24rpx;
  border-radius: var(--radius);
  border: 1rpx solid var(--line);
  box-shadow: var(--shadow);
  padding: 28rpx;
}
.block.flush {
  padding: 0;
  overflow: hidden;
}
.block-hd {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 20rpx;
}
.block-hd .bt {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--ink);
}
.block-hd .bs {
  font-size: 22rpx;
  color: var(--muted);
}
.block-hd .r {
  margin-left: auto;
  font-size: 22rpx;
  color: var(--muted);
}

/* 表单区 */
.form-sec {
  background: var(--card);
  margin: 20rpx 24rpx;
  border-radius: var(--radius);
  border: 1rpx solid var(--line);
  box-shadow: var(--shadow);
  padding: 28rpx;
}
.form-sec .sh {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 20rpx;
}
.form-sec .sh .st {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--ink);
}
.form-sec .sh .sd {
  font-size: 22rpx;
  color: var(--muted);
  margin-left: auto;
}

.field {
  margin-bottom: 26rpx;
}
.field:last-child {
  margin-bottom: 0;
}
.field .f-label {
  display: block;
  font-size: 24rpx;
  font-weight: 600;
  color: var(--ink-2);
  margin-bottom: 12rpx;
}
.field .req {
  color: var(--danger);
  margin-left: 4rpx;
}
.field .opt {
  font-weight: 400;
  color: var(--muted);
  font-size: 22rpx;
  margin-left: 8rpx;
}
.field input,
.field textarea {
  width: 100%;
  border: 1rpx solid var(--line);
  border-radius: 12rpx;
  background: #fff;
  padding: 18rpx 20rpx;
  font-size: 26rpx;
  color: var(--ink);
  line-height: 1.6;
}
.field input {
  height: 72rpx;
}
.field .tip {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--muted);
  line-height: 1.5;
}

/* chip 选择组 */
.chip-group {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

/* 选择器按钮 */
.pick-btn {
  display: flex;
  align-items: center;
  height: 72rpx;
  padding: 0 20rpx;
  border-radius: 12rpx;
  border: 1rpx solid var(--line);
  background: #fff;
  font-size: 28rpx;
  color: var(--ink);
}
.pick-btn.placeholder {
  color: #A1A1AA;
}
.pick-btn .pb-t {
  flex: 1;
}
.pick-btn .pb-a {
  color: var(--muted);
  margin-left: 12rpx;
}

/* 空状态 */
.empty {
  margin: 48rpx 32rpx;
  padding: 56rpx 40rpx;
  background: var(--card);
  border: 1rpx dashed var(--line);
  border-radius: var(--radius);
  text-align: center;
  color: var(--muted);
  font-size: 26rpx;
  line-height: 1.7;
}
.empty .big {
  font-size: 52rpx;
  margin-bottom: 12rpx;
  opacity: .5;
}
/* 空态插图：代码生成的线稿图标，统一 96rpx 视觉尺寸 */
.empty .big-img {
  width: 96rpx;
  height: 96rpx;
  display: block;
  margin: 0 auto 16rpx;
}
.empty .ttl {
  font-size: 26rpx;
  color: var(--ink);
  font-weight: 600;
  margin-bottom: 8rpx;
}
.empty .ds {
  font-size: 24rpx;
  color: var(--muted);
  margin-bottom: 24rpx;
}
.empty .acts {
  display: flex;
  justify-content: center;
  gap: 16rpx;
  flex-wrap: wrap;
}

/* 价格 */
.price {
  color: var(--ink);
  font-weight: 700;
}
.price small {
  font-size: 22rpx;
  font-weight: 400;
  color: var(--muted);
  margin-left: 6rpx;
}
.price .unit {
  font-size: 22rpx;
  font-weight: 400;
  color: var(--muted);
}

/* 单色文本 */
.muted {
  color: var(--muted);
}
.ink2 {
  color: var(--ink-2);
}
.mono {
  font-family: ui-monospace, SFMono-Regular, "SF Mono", Menlo, Consolas, monospace;
  font-size: 22rpx;
}

/* 安全距离：固定底栏叠加 iPhone 底部安全区（提高优先级，避免被页面 padding 简写覆盖） */
page .safe-bottom {
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
}

/* 朋友圈单页模式：底部固定提示（此时没有 tabBar，提示条正好占住底部） */
.sp-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 900;
  padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
  background: rgba(17, 24, 39, 0.92);
  color: #FFFFFF;
  font-size: 24rpx;
  line-height: 34rpx;
  text-align: center;
}

