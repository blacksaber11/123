page {
  background: var(--line-2);
}
.ab {
  padding: 32rpx 28rpx calc(48rpx + env(safe-area-inset-bottom));
}

/* 顶部品牌区 */
.ab-hd {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  padding: 16rpx 0 32rpx;
}
.ab-logo {
  width: 120rpx;
  height: 120rpx;
  border-radius: 28rpx;
  background: var(--brand);
  color: #fff;
  font-size: 56rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 10rpx 24rpx rgba(79, 70, 229, .25);
}
.ab-name {
  margin-top: 8rpx;
  font-size: 36rpx;
  font-weight: 700;
  color: #18181B;
}
.ab-slogan {
  font-size: 24rpx;
  color: var(--muted);
}
.ab-ver {
  margin-top: 4rpx;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  background: var(--brand-soft);
  border: 1rpx solid var(--brand-line);
  font-size: 21rpx;
  color: var(--brand);
}

/* 一句话定位 */
.ab-hero {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  border-radius: 20rpx;
  background: #EAF6F0;
  border: 1rpx solid #BFE3D2;
}
.ah-t {
  font-size: 27rpx;
  font-weight: 600;
  color: var(--brand);
}
.ah-d {
  font-size: 23rpx;
  line-height: 1.7;
  color: var(--ink-2);
}

/* 正文分段 */
.ab-sec {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  border-radius: 20rpx;
  background: #fff;
  border: 1rpx solid var(--line);
}
.as-h {
  font-size: 28rpx;
  font-weight: 600;
  color: #18181B;
}
.as-p {
  font-size: 24rpx;
  line-height: 1.75;
  color: #52525B;
  word-break: break-all;
}

/* 版本介绍 */
.ab-log {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  padding-top: 12rpx;
  border-top: 1rpx solid var(--line-2);
}
.al-hd {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.al-v {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--brand);
}
.al-at {
  font-size: 21rpx;
  color: var(--muted);
}
.al-li {
  display: flex;
  align-items: flex-start;
  gap: 8rpx;
}
.al-dot {
  flex: none;
  color: var(--muted-2);
  font-size: 24rpx;
  line-height: 1.7;
}
.al-t {
  flex: 1;
  min-width: 0;
  font-size: 23rpx;
  line-height: 1.7;
  color: #52525B;
  word-break: break-all;
}

/* 协议与客服入口 */
.ab-links {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-wrap: wrap;
  gap: 8rpx 24rpx;
  padding: 8rpx 0 16rpx;
}
.ab-link {
  font-size: 23rpx;
  color: var(--brand);
}
.ab-ft {
  padding-top: 8rpx;
  font-size: 21rpx;
  line-height: 1.7;
  color: var(--muted);
  text-align: center;
}
