<view class="chat-page">

  <!-- 自定义导航：返回键常显，安卓系统返回 / iOS 侧滑同样是回到上一级页面 -->
  <view class="msg-nav" style="padding-top: {{statusBarH}}px">
    <view class="nav-bar" style="height: {{navH}}px">
      <view class="nav-back" bindtap="back">‹</view>
      <view class="nav-title" bindtap="openPeerHome"><text class="nav-title-name">{{chatTitle}}</text><text wx:if="{{!chatPrivate && chatMember}}" class="nav-member">{{chatMember}}</text><text wx:if="{{!chatPrivate && chatPeerKey}}" class="nav-title-arrow">›</text></view>
    </view>
  </view>

  <!-- 平台直连会话 -->
  <view class="chat-panel" style="top: {{navTotal}}px; bottom: {{panelBottom}}">
    <!-- 会话标的：从商品 / 需求发起聊天时固定在上方，双方可见；可关闭或点进详情 -->
    <view wx:if="{{chatTarget}}" class="chat-target">
      <view class="ct-main" bindtap="openChatTarget">
        <image wx:if="{{chatTarget.cover}}" class="ct-img" src="{{chatTarget.cover}}" mode="aspectFill" />
        <view wx:else class="ct-img ct-ph">{{chatTarget.type === 'demand' ? '需' : '货'}}</view>
        <view class="ct-body">
          <view class="ct-t">{{chatTarget.title}}</view>
          <view class="ct-m">
            <text wx:if="{{chatTarget.priceText}}" class="ct-price">{{chatTarget.priceText}}</text>
            <text wx:if="{{chatTarget.city}}" class="ct-city">{{chatTarget.city}}</text>
          </view>
        </view>
        <text class="ct-go">›</text>
      </view>
      <view class="ct-x" catchtap="closeChatTarget">✕</view>
    </view>
    <scroll-view class="chat-scroll" scroll-y scroll-into-view="{{chatAnchor}}" scroll-with-animation>
      <view class="chat-tip">
        {{chatThread ? '你正在与对方直接沟通。必须条件已满足，可协商条件可在会话中确认；可直接发送联系方式，但请自行保管身份证、银行卡等敏感信息。' : '你正在直接联系平台官方客服。留言仅平台可见，平台坐席会尽快回复。'}}
      </view>

      <!-- 对方已授权：展示其主体与联系方式（只在本会话出现） -->
      <view wx:if="{{peerContact}}" class="peer-card">
        <view class="pc-hd">对方已向本会话开放主体信息</view>
        <view wx:if="{{peerContact.subject}}" class="pc-row"><text class="pc-k">主体</text><text class="pc-v">{{peerContact.subject}}</text></view>
        <view wx:if="{{peerContact.contact}}" class="pc-row"><text class="pc-k">联系人</text><text class="pc-v">{{peerContact.contact}}</text></view>
        <view wx:if="{{peerContact.phone}}" class="pc-row" bindtap="copyPeerPhone">
          <text class="pc-k">电话</text><text class="pc-v">{{peerContact.phone}}</text><text class="pc-copy">复制</text>
        </view>
        <view class="pc-tip">仅本次会话可见，不会出现在对方主页</view>
      </view>

      <view wx:for="{{chatList}}" wx:key="id" class="chat-row {{item.role === 'me' ? 'me' : 'sys'}}">
        <view wx:if="{{item.role === 'me'}}" class="chat-avatar">我</view>
        <view wx:else class="chat-avatar {{chatPeerKey ? 'tappable' : ''}}" hover-class="{{chatPeerKey ? 'avatar-hover' : ''}}" bindtap="openPeerHome">{{chatAvatar}}</view>
        <view class="chat-wrap">
          <view wx:if="{{item.kind === 'image'}}" class="chat-bubble bubble-media">
            <view wx:if="{{item.mediaExpired}}" class="chat-media-dead">图片已过期</view>
            <image wx:else class="chat-img" src="{{item.src || item.image}}" mode="widthFix" show-menu-by-longpress="{{false}}" data-id="{{item.id}}" data-src="{{item.image}}" bindtap="previewImage" />
            <text wx:if="{{wmOn}}" class="chat-img-wm">{{wmText}}</text>
          </view>
          <view wx:elif="{{item.kind === 'video'}}" class="chat-bubble bubble-media" data-id="{{item.id}}" bindtap="playVideo">
            <view wx:if="{{item.mediaExpired}}" class="chat-media-dead">视频已过期</view>
            <view wx:else class="chat-video" style="{{item.poster ? 'background-image:url(' + item.poster + ')' : ''}}">
              <view class="cv-play"></view>
              <text class="cv-badge">视频</text>
            </view>
            <text wx:if="{{wmOn}}" class="chat-img-wm">{{wmText}}</text>
          </view>
          <view wx:elif="{{item.kind === 'card'}}" class="chat-bubble bubble-card">
            <!-- 方形名片：只展示摘要，点击打开名片详情，不在气泡里铺开隐私信息 -->
            <view class="chat-card" data-id="{{item.id}}" bindtap="openCard">
              <view class="cc-band"></view>
              <view class="cc-head">
                <view class="cc-av">{{item.card.avatar}}</view>
                <view class="cc-body">
                  <view class="cc-nm">{{item.card.name}}</view>
                  <view wx:if="{{item.card.subject}}" class="cc-sub">{{item.card.subject}}</view>
                  <view class="cc-meta">{{item.card.city}}{{item.card.city && item.card.realname ? ' · ' : ''}}{{item.card.realname}}</view>
                </view>
              </view>
              <view class="cc-foot">
                <text class="cc-tag">名片</text>
                <text class="cc-hint">点击查看名片 ›</text>
              </view>
            </view>
          </view>
          <view wx:else class="chat-bubble">{{item.text}}</view>
          <view class="chat-time">{{item.at}}<text wx:if="{{item.role === 'me' && item.read}}"> · 已读</text></view>
        </view>
      </view>
      <view id="chat-end" class="chat-end"></view>
    </scroll-view>

    <view class="chat-bottom">
      <view class="chat-input">
        <input class="chat-input-box" value="{{draft}}" bindinput="onDraft" bindfocus="onInputFocus"
               confirm-type="send" adjust-position="{{!kbAware}}" bindconfirm="sendChat"
               placeholder="输入消息…" maxlength="500" />
        <view wx:if="{{draft}}" class="chat-send" bindtap="sendChat">发送</view>
        <view wx:else class="chat-plus {{toolsOpen ? ' on' : ''}}" bindtap="toggleTools"><text class="cp-ico">+</text></view>
      </view>

      <!-- 加号面板：与微信一致，展开后可发送图片、视频与个人名片 -->
      <view wx:if="{{toolsOpen}}" class="chat-tools">
        <view class="tool-item" bindtap="pickImage">
          <view class="tool-ico ico-pic">
            <view class="ti-frame">
              <view class="ti-sun"></view>
              <view class="ti-hill"></view>
            </view>
          </view>
          <text class="tool-nm">图片</text>
        </view>
        <view class="tool-item" bindtap="pickVideo">
          <view class="tool-ico ico-video">
            <view class="ti-vframe"><view class="ti-play"></view></view>
          </view>
          <text class="tool-nm">视频</text>
        </view>
        <view class="tool-item" bindtap="sendCard">
          <view class="tool-ico ico-card">
            <view class="ti-card">
              <view class="ti-head"></view>
              <view class="ti-line"></view>
              <view class="ti-line s"></view>
            </view>
          </view>
          <text class="tool-nm">个人名片</text>
        </view>
      </view>
    </view>

    <!-- 整页水印：绑当前账号的 ID + 昵称；设置关闭后不渲染 -->
    <view wx:if="{{wmOn}}" class="chat-wm">
      <text wx:for="{{wmTiles}}" wx:key="k" class="chat-wm-t">{{item.t}}</text>
    </view>
  </view>

  <!-- 聊天图片查看器：页内放大并叠水印，不提供长按菜单 / 保存 -->
  <view wx:if="{{imgOpen}}" class="img-pop" bindtap="closeImage">
    <image class="img-pop-img" src="{{imgSrc}}" mode="aspectFit" show-menu-by-longpress="{{false}}" catchtouchmove="stopTap" />
    <text wx:if="{{wmOn}}" class="img-pop-wm">{{wmText}}</text>
    <text class="img-pop-tip">{{wmOn ? '仅平台内查看 · 画面已叠加你的账号水印' : '仅平台内查看'}}</text>
  </view>

  <!-- 名片详情：聊天里点方形名片打开，完整信息在这里看，避免气泡里铺满隐私字段 -->
  <view wx:if="{{cardOpen}}" class="card-pop" bindtap="closeCard">
    <view class="card-sheet" catchtap="stopTap">
      <view class="cs-band"></view>
      <view class="cs-av">{{cardDetail.avatar}}</view>
      <view class="cs-nm">{{cardDetail.name}}</view>

      <!-- 主体信息：主体名称 / 类型 / 类别（company 企业、person 个人） -->
      <view class="cs-block">
        <view class="cs-title">主体信息</view>
        <view wx:if="{{cardDetail.subject}}" class="cs-line"><text class="cs-k">主体名称</text><text class="cs-v">{{cardDetail.subject}}</text></view>
        <view wx:if="{{cardDetail.subjectType}}" class="cs-line"><text class="cs-k">主体类型</text><text class="cs-v">{{cardDetail.subjectType}}</text></view>
        <view wx:if="{{cardDetail.subjectKind}}" class="cs-line">
          <text class="cs-k">主体类别</text>
          <text class="cs-v">{{cardDetail.subjectKind === 'person' ? '个人' : '企业'}}</text>
        </view>
      </view>

      <!-- 联系方式：联系人 / 手机号 / 联系备注；手机号仅在对方留存且授权时下发 -->
      <view class="cs-block">
        <view class="cs-title">联系方式</view>
        <view wx:if="{{cardDetail.realname}}" class="cs-line"><text class="cs-k">联系人</text><text class="cs-v">{{cardDetail.realname}}</text></view>
        <view wx:if="{{cardDetail.phone}}" class="cs-line" data-phone="{{cardDetail.phone}}" bindtap="callCardPhone">
          <text class="cs-k">手机号</text><text class="cs-v strong">{{cardDetail.phone}}</text><text class="cs-act">拨打</text>
        </view>
        <view wx:elif="{{cardDetail.sharePhone}}" class="cs-line">
          <text class="cs-k">手机号</text><text class="cs-v">对方暂未留存手机号</text>
        </view>
        <view wx:if="{{cardDetail.contact}}" class="cs-line"><text class="cs-k">联系备注</text><text class="cs-v">{{cardDetail.contact}}</text></view>
      </view>

      <!-- 个人身份：真实姓名 / 职位 / 实名状态 -->
      <view class="cs-block">
        <view class="cs-title">个人身份</view>
        <view wx:if="{{cardDetail.realname}}" class="cs-line"><text class="cs-k">真实姓名</text><text class="cs-v">{{cardDetail.realname}}</text></view>
        <view wx:if="{{cardDetail.position}}" class="cs-line"><text class="cs-k">职位</text><text class="cs-v">{{cardDetail.position}}</text></view>
        <view class="cs-line">
          <text class="cs-k">实名状态</text>
          <text class="cs-v {{cardDetail.verified ? 'strong' : ''}}">{{cardDetail.verified ? '已实名' : '未实名'}}</text>
        </view>
        <view wx:if="{{cardDetail.city}}" class="cs-line"><text class="cs-k">城市</text><text class="cs-v">{{cardDetail.city}}</text></view>
      </view>

      <view class="cs-tip">名片信息由对方主动发送，请通过平台完成交易，谨防私下转账。</view>
      <view class="cs-wm">{{wmText}}</view>
      <view class="cs-btns">
        <button class="btn sm" bindtap="closeCard">关闭</button>
        <button wx:if="{{cardDetail.phone}}" class="btn sm primary" data-phone="{{cardDetail.phone}}" bindtap="callCardPhone">拨打电话</button>
      </view>
    </view>
  </view>
</view>
