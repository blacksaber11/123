page {
  background: var(--line-2);
}
.doc {
  padding: 32rpx 28rpx calc(48rpx + env(safe-area-inset-bottom));
}
.doc-hd {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  margin-bottom: 24rpx;
}
.doc-t {
  font-size: 40rpx;
  font-weight: 700;
  color: #18181B;
}
.doc-v {
  font-size: 22rpx;
  color: var(--muted);
}
.doc-hero {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  border-radius: 20rpx;
  background: #EAF6F0;
  border: 1rpx solid #BFE3D2;
}
.dh-t {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--brand);
}
.dh-d {
  font-size: 24rpx;
  line-height: 1.7;
  color: var(--ink-2);
}
.doc-sec {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  border-radius: 20rpx;
  background: #FFFFFF;
  border: 1rpx solid var(--line);
}
.ds-h {
  font-size: 28rpx;
  font-weight: 600;
  color: #18181B;
}
.ds-p {
  font-size: 24rpx;
  line-height: 1.75;
  color: #52525B;
  word-break: break-all;
}
.doc-ft {
  padding: 24rpx 8rpx 0;
  font-size: 22rpx;
  line-height: 1.7;
  color: var(--muted);
  text-align: center;
}
