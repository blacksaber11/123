.detail {
  background: var(--paper);
  min-height: 100vh;
}

/* 顶部发布人：头像 + 昵称 + 主体，右侧关注 / 联系平台 */
.publisher {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 20rpx 24rpx;
  background: #fff;
  border-bottom: 1rpx solid var(--line-2);
}
.publisher .pub-l {
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex: 1;
  min-width: 0;
}
.publisher .pub-av {
  flex: none;
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--brand), #1E1B4B);
  color: #fff;
  font-size: 28rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}
.publisher.platform .pub-av {
  background: linear-gradient(135deg, #4F46E5, #6D28D9);
}
.publisher .pub-info {
  flex: 1;
  min-width: 0;
}
.publisher .pub-nm {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--ink-1);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.publisher .owner-go {
  margin-left: 6rpx;
  color: var(--ink-3);
  font-weight: 400;
}
.publisher .pub-sb {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: var(--ink-3);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.publisher .pub-act {
  flex: none;
  padding: 10rpx 22rpx;
  border-radius: 999rpx;
  border: 1rpx solid var(--brand-line);
  background: var(--brand-soft);
  color: var(--brand);
  font-size: 24rpx;
  font-weight: 600;
}
.publisher .pub-act.on {
  background: var(--line-2);
  border-color: var(--line-2);
  color: var(--ink-3);
}
.publisher .pub-phone {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--brand);
}
.publisher .pub-phone-act {
  margin-left: 10rpx;
  padding: 0 10rpx;
  border-radius: 6rpx;
  background: var(--brand-soft);
}

/* 私密发布提示卡：沿用 callout 风格，与下方内容拉开间距 */
.private-tip {
  margin: 20rpx 24rpx 0;
}

/* 媒体区角标：叠在图片 / 视频上，不额外占用一块展示位 */
.hbadge {
  position: relative;
  display: flex;
  gap: 12rpx;
  flex-wrap: wrap;
  align-items: center;
  /* 给右上角收藏按钮让位 */
  padding-right: 88rpx;
}
.hbadge.stage-badge {
  position: absolute;
  left: 20rpx;
  top: 18rpx;
  z-index: 4;
}
.hbadge .pill-tag {
  background: var(--brand-2);
}
.hbadge .chip {
  background: rgba(15, 16, 32, .5);
  border-color: transparent;
  color: #fff;
  font-size: 22rpx;
}
.hero-fav {
  position: absolute;
  top: 18rpx;
  right: 20rpx;
  width: 60rpx;
  height: 60rpx;
  border-radius: 16rpx;
  border: 1rpx solid rgba(255,255,255,.28);
  background: rgba(15, 16, 32, .5);
  color: #fff;
  font-size: 32rpx;
  line-height: 60rpx;
  text-align: center;
  z-index: 4;
}

/* 区块通用 */
.block {
  background: #fff;
  margin: 20rpx 24rpx;
  border-radius: var(--radius);
  border: 1rpx solid var(--line);
  padding: 28rpx;
  box-shadow: var(--shadow);
}
.block.flush {
  padding: 0;
  overflow: hidden;
}
.block-hd {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 20rpx;
}
.block-hd .bt {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--ink);
}
.block-hd .r {
  margin-left: auto;
  font-size: 22rpx;
  color: var(--muted);
}

/* 媒体展示区：图片与视频混排轮播，左右滑动切换 */
.media-stage {
  position: relative;
  border-radius: 20rpx;
  overflow: hidden;
  background: #0F1020;
}
.media-swiper {
  width: 100%;
  height: 480rpx;
}
.ms-cell {
  position: relative;
  width: 100%;
  height: 100%;
}
.ms-media {
  width: 100%;
  height: 100%;
  display: block;
  background: #0F1020;
}
/* 水印铺满轮播：不点开图片 / 视频也能看到账号标识 */
.ms-wm-wall {
  position: absolute;
  inset: 0;
  z-index: 2;
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  grid-template-rows: repeat(6, 1fr);
  align-items: center;
  justify-items: center;
  pointer-events: none;
  overflow: hidden;
}
.ms-wm-t {
  max-width: 100%;
  overflow: hidden;
  white-space: nowrap;
  font-size: 16rpx;
  line-height: 1.3;
  color: rgba(255, 255, 255, .42);
  transform: rotate(-24deg);
}
/* 视频封面：不用内联 video，原生组件会拦截点击与横滑 */
.ms-video {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  background: linear-gradient(135deg, #312E81 0%, #0F1020 100%);
}
.ms-video-poster {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}
.ms-video-play {
  position: relative;
  z-index: 1;
  width: 96rpx;
  height: 96rpx;
  line-height: 96rpx;
  text-align: center;
  border-radius: 50%;
  color: #fff;
  font-size: 32rpx;
  background: rgba(15, 16, 32, .55);
  border: 1rpx solid rgba(255, 255, 255, .4);
}
.ms-video-tip {
  position: relative;
  z-index: 1;
  font-size: 22rpx;
  color: rgba(255, 255, 255, .86);
}
.ms-hint {
  position: absolute;
  left: 20rpx;
  bottom: 18rpx;
  z-index: 3;
  font-size: 20rpx;
  line-height: 34rpx;
  padding: 0 12rpx;
  border-radius: 8rpx;
  color: rgba(255, 255, 255, .9);
  background: rgba(15, 16, 32, .42);
  pointer-events: none;
}
.ms-count {
  position: absolute;
  right: 20rpx;
  bottom: 18rpx;
  z-index: 3;
  font-size: 22rpx;
  line-height: 36rpx;
  padding: 0 14rpx;
  border-radius: 999rpx;
  color: #fff;
  background: rgba(15, 16, 32, .55);
  pointer-events: none;
}
/* 没有实拍材料时的占位块：与首页商品卡同一套视觉（品牌色 + 网格 + 型号 / 数量） */
.ms-empty {
  position: relative;
  height: 400rpx;
  border-radius: 20rpx;
  background: linear-gradient(135deg, #4F46E5 0%, #312E81 100%);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  color: rgba(255, 255, 255, .92);
}
.ms-empty::before {
  content: '';
  position: absolute;
  inset: 0;
  background:
    linear-gradient(90deg, rgba(255,255,255,.16) 1rpx, transparent 1rpx) 0 0 / 28rpx 28rpx,
    linear-gradient(rgba(255,255,255,.10) 1rpx, transparent 1rpx) 0 0 / 28rpx 28rpx;
  opacity: .5;
}
.ms-empty-brand {
  position: relative;
  z-index: 1;
  font-size: 20rpx;
  letter-spacing: .12em;
  opacity: .72;
}
.ms-empty-t {
  position: relative;
  z-index: 1;
  font-size: 34rpx;
  font-weight: 700;
  letter-spacing: .02em;
}
.ms-empty-sub {
  position: relative;
  z-index: 1;
  font-size: 24rpx;
  color: rgba(255, 255, 255, .8);
}
.ms-empty-d {
  position: relative;
  z-index: 1;
  margin-top: 14rpx;
  font-size: 22rpx;
  opacity: .8;
}
.ms-empty-h {
  position: relative;
  z-index: 1;
  font-size: 20rpx;
  opacity: .58;
}

.media-guard {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  margin-top: 20rpx;
  padding: 20rpx;
  background: var(--line-2);
  border-radius: 16rpx;
}
.mg-i {
  width: 32rpx;
  height: 32rpx;
  flex: none;
  display: block;
}
.mg-b {
  flex: 1;
  min-width: 0;
}
.mg-bt {
  display: block;
  font-size: 24rpx;
  font-weight: 600;
  color: var(--ink);
  margin-bottom: 4rpx;
}
.mg-bd {
  display: block;
  font-size: 22rpx;
  color: var(--ink-2);
  line-height: 1.6;
}

/* 标题与价格 */
.d-title {
  font-size: 34rpx;
  font-weight: 700;
  line-height: 1.45;
  margin: 4rpx 0 12rpx;
  color: var(--ink);
}
.price-row {
  display: flex;
  align-items: flex-end;
  gap: 16rpx;
  margin-bottom: 12rpx;
}
.price-row .p {
  flex: none;
  white-space: nowrap;
  font-size: 52rpx;
  font-weight: 800;
  letter-spacing: -.02em;
  line-height: 1.1;
  color: var(--ink);
}
.price-row .p .p-unit {
  font-size: 24rpx;
  font-weight: 400;
  color: var(--muted);
  margin-left: 4rpx;
}
.price-row .pn {
  flex: 1;
  min-width: 0;
  margin-left: auto;
  font-size: 22rpx;
  color: var(--muted);
  text-align: right;
  line-height: 1.6;
  white-space: pre-line;
}
/* 换行文本（替代 HTML <br>） */
.price-row .pn .br-line {
  display: block;
}
.price-row .pn .br-line + .br-line {
  margin-top: 4rpx;
}

.chips {
  display: flex;
  gap: 10rpx;
  flex-wrap: wrap;
  margin-top: 16rpx;
}

/* 规格网格 */
.spec-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 1rpx;
  background: var(--line-2);
  border-radius: 16rpx;
  overflow: hidden;
  margin-top: 24rpx;
}
.spec-grid .cell {
  background: #fff;
  padding: 18rpx 20rpx;
}
.spec-grid .k {
  font-size: 20rpx;
  color: var(--muted);
  margin-bottom: 4rpx;
}
.spec-grid .v {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--ink);
  line-height: 1.4;
}
.spec-grid.rent-spec {
  margin-top: 20rpx;
}

/* 关键信息列表 */
.klist {
  margin: 24rpx 0 0;
  padding: 0;
  list-style: none;
  border-top: 1rpx dashed var(--line-2);
}
.ki {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  padding: 16rpx 0;
  border-bottom: 1rpx dashed var(--line-2);
  font-size: 24rpx;
}
.ki:last-child {
  border-bottom: none;
}
.ki .kn {
  color: var(--ink-2);
  width: 224rpx;
  flex: none;
  font-size: 24rpx;
}
.ki .kv {
  color: var(--ink);
  flex: 1;
  min-width: 0;
  line-height: 1.6;
}
.ki .kv.mut {
  color: var(--muted);
}

/* 货主信息 */
.owner {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 20rpx;
  border: 1rpx solid var(--line-2);
  border-radius: 18rpx;
  background: var(--line-2);
  margin-top: 24rpx;
}
.owner .av {
  width: 64rpx;
  height: 64rpx;
  border-radius: 18rpx;
  background: var(--brand);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 700;
  flex: none;
}
.owner-info {
  flex: 1;
  min-width: 0;
}
.owner-info .nm {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--ink);
  display: flex;
  align-items: center;
}
/* 可点进卖家主页的提示箭头 */
.owner-go {
  margin-left: 8rpx;
  color: #B4B4BB;
  font-size: 26rpx;
  font-weight: 400;
  line-height: 1;
}
.owner-info .sb {
  font-size: 22rpx;
  color: var(--muted);
  margin-top: 4rpx;
}
/* 货主自愿公开的联系电话：独立一行，点一下即可复制 */
.owner-phone {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-top: 12rpx;
  padding: 10rpx 16rpx;
  border-radius: 12rpx;
  background: var(--brand-soft);
}
.op-ico {
  flex: none;
  width: 30rpx;
  height: 30rpx;
  display: block;
}
.op-num {
  flex: 1;
  min-width: 0;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--brand);
  font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
}
.op-act {
  flex: none;
  font-size: 21rpx;
  color: var(--brand);
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
  background: #fff;
}
.owner-r {
  flex: none;
  text-align: right;
  font-size: 24rpx;
  color: var(--ink-2);
  font-weight: 500;
}
.owner-r .muted {
  display: block;
  font-size: 20rpx;
  color: var(--muted);
  font-weight: 400;
  margin-top: 4rpx;
}

/* 进度条 */
.progress-line {
  display: flex;
  align-items: center;
  gap: 16rpx;
  font-size: 22rpx;
  color: var(--muted);
  margin-bottom: 8rpx;
}
.progress-line .mono {
  flex: none;
  font-size: 24rpx;
  color: var(--ink-2);
  font-weight: 500;
}
.progress-line .bar {
  flex: 1;
  height: 8rpx;
  border-radius: 4rpx;
  background: var(--line-2);
  overflow: hidden;
  display: block;
}
.progress-line .bar text {
  display: block;
  height: 100%;
  background: var(--brand);
  border-radius: 4rpx;
}

/* 清单行 */
.ck-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 4rpx;
}
.ck-chip {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  max-width: 100%;
  padding: 0 14rpx;
  height: 44rpx;
  border-radius: 8rpx;
  border: 1rpx solid var(--line);
  background: #fff;
  box-sizing: border-box;
}
.ck-chip .ck-nm {
  font-size: 21rpx;
  color: var(--ink-2);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.ck-chip .ck-st {
  font-size: 19rpx;
  color: var(--muted);
  flex: none;
}
.ck-chip.ok {
  background: var(--brand-soft);
  border-color: var(--brand-line);
}
.ck-chip.ok .ck-nm {
  color: var(--brand);
  font-weight: 500;
}
.ck-chip.ok .ck-st {
  color: var(--brand);
  opacity: 0.85;
}
.ck-note {
  display: block;
  margin-top: 14rpx;
  font-size: 20rpx;
  color: var(--muted);
}

/* 流程列表 */
.flow-list {
  display: flex;
  flex-direction: column;
  gap: 0;
}
.flow-item {
  display: flex;
  gap: 20rpx;
  position: relative;
  padding-bottom: 28rpx;
}
.flow-item:last-child {
  padding-bottom: 0;
}
.flow-item::before {
  content: '';
  position: absolute;
  left: 22rpx;
  top: 48rpx;
  bottom: 0;
  width: 2rpx;
  background: var(--line);
}
.flow-item:last-child::before {
  display: none;
}
.fi-idx {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
  font-weight: 700;
  background: #fff;
  border: 1rpx solid var(--line);
  color: var(--muted);
  z-index: 1;
}
.flow-item.hi .fi-idx {
  background: var(--brand);
  border-color: var(--brand);
  color: #fff;
}
.fi-content {
  padding-top: 6rpx;
}
.fi-name {
  font-size: 24rpx;
  font-weight: 600;
  line-height: 1.5;
  color: var(--ink);
}
.fi-desc {
  font-size: 22rpx;
  color: var(--muted);
  line-height: 1.6;
  margin-top: 2rpx;
}

/* 条件分组：可沟通条件在前、必须条件在后 */
.cond-group + .cond-group {
  margin-top: 24rpx;
}
.cond-sub {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: var(--ink);
  margin-bottom: 12rpx;
}
.cond-sub .cs-note {
  font-size: 20rpx;
  font-weight: 400;
  color: var(--muted);
}
.cond-chips .chip {
  font-size: 22rpx;
}

/* 条件列表 */
.cond-list {
  border-top: 1rpx solid var(--line-2);
}
.ci {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--line-2);
}
.ci:last-child {
  border-bottom: none;
}
.ci-ico {
  flex: none;
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: var(--line-2);
  color: var(--muted);
  font-size: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 2rpx;
}
.ci-ico.ok {
  background: var(--brand-soft);
  color: var(--brand);
}
.ci-body {
  flex: 1;
  min-width: 0;
}
.ci-name {
  font-size: 26rpx;
  color: var(--ink);
  font-weight: 500;
  margin-bottom: 4rpx;
  line-height: 1.5;
}
.ci-desc {
  font-size: 22rpx;
  color: var(--muted);
  line-height: 1.6;
}

/* 咨询入口区块 */
.consult-entry {
  margin-bottom: 28rpx;
}
.callout .b {
  font-weight: 700;
  color: var(--ink);
}

/* 分享落地提示：只做保密提醒，不改变详情内容 */
.share-tip {
  padding: 14rpx 28rpx;
  font-size: 22rpx;
  line-height: 1.4;
  text-align: center;
  color: #8A5A00;
  background: #FFF7E6;
  border-bottom: 1rpx solid var(--line);
}

/* 朋友圈单页模式：底部已有固定咨询栏，提示放在页面顶部，避免遮挡 */
.sp-inline {
  padding: 14rpx 28rpx;
  font-size: 22rpx;
  line-height: 1.4;
  text-align: center;
  color: #fff;
  background: rgba(17, 24, 39, 0.92);
  border-bottom: 1rpx solid var(--line);
}

/* 底部咨询栏 */
.sticky-consult {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(255,255,255,.96);
  backdrop-filter: blur(16rpx);
  border-top: 1rpx solid var(--line);
  padding: 18rpx 28rpx 20rpx;
  z-index: 100;
}
.sticky-consult .row {
  display: flex;
  align-items: center;
  gap: 20rpx;
}
/* 左下角咨询人数：数字与文案同一行，避免竖排换行 */
.sticky-consult .cnt {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: baseline;
  gap: 8rpx;
  font-size: 22rpx;
  color: var(--ink-2);
  line-height: 1.35;
  white-space: nowrap;
  overflow: hidden;
}
.sticky-consult .cnt .b {
  display: inline;
  font-size: 30rpx;
  color: var(--warn);
  font-weight: 700;
  line-height: 1;
}
.sticky-consult .btn {
  flex: none;
}
/* 分享按钮：比主操作轻一档，避免抢走「咨询客服」的视觉重心 */
.sticky-consult .share-btn {
  height: 80rpx;
  padding: 0 28rpx;
  font-size: 26rpx;
  border-radius: 16rpx;
}
.sticky-consult .hint {
  text-align: center;
  font-size: 20rpx;
  color: var(--muted);
  margin-top: 10rpx;
}
.sticky-consult .hint-report {
  margin-left: 16rpx;
  color: var(--brand);
  text-decoration: underline;
}

/* ============================================================
   必须条件确认弹层：确认完成后直接进入与货主的会话
   ============================================================ */
.cond-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 250;
  background: rgba(0, 0, 0, .45);
}
.cond-sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 251;
  max-height: 82vh;
  display: flex;
  flex-direction: column;
  background: #fff;
  border-radius: 28rpx 28rpx 0 0;
  padding: 28rpx 28rpx calc(24rpx + env(safe-area-inset-bottom));
}
.cs-hd {
  flex: none;
  position: relative;
  padding-right: 60rpx;
}
.cs-tt {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--ink);
}
.cs-sub {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--muted);
}
.cs-x {
  position: absolute;
  right: 0;
  top: 0;
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  color: var(--muted);
}
.cs-tip {
  flex: none;
  margin: 18rpx 0 8rpx;
  padding: 16rpx 18rpx;
  border-radius: 14rpx;
  background: var(--brand-soft);
  font-size: 22rpx;
  line-height: 1.6;
  color: var(--ink-2);
}
.cs-list {
  flex: 1;
  min-height: 220rpx;
  max-height: 46vh;
}
.cs-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--line-2);
}
.cs-item:last-child {
  border-bottom: none;
}
.cs-name {
  flex: 1;
  min-width: 0;
  font-size: 26rpx;
  color: var(--ink);
  line-height: 1.5;
}
.cs-confirm {
  flex: none;
  display: flex;
  gap: 10rpx;
}
.cs-confirm .cc-btn {
  min-width: 96rpx;
  height: 56rpx;
  padding: 0 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 12rpx;
  border: 1rpx solid var(--line);
  background: #fff;
  font-size: 24rpx;
  color: var(--ink-2);
}
.cs-confirm .cc-btn.on {
  border-color: var(--brand);
  background: var(--brand-soft);
  color: var(--brand);
  font-weight: 600;
}
.cs-confirm .cc-btn.on.bad {
  border-color: var(--danger-line);
  background: var(--danger-soft);
  color: var(--danger);
}
.cs-ft {
  flex: none;
  display: flex;
  gap: 16rpx;
  padding-top: 20rpx;
}
.cs-ft .btn {
  flex: 1;
  margin: 0;
}
.cs-ft .btn.primary {
  flex: 2;
}
/* 提示块里的补充说明（如「货主已公开电话」） */
.callout-extra {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--ink-2);
}

.loading {
  text-align: center;
  padding: 200rpx 0;
  color: var(--muted);
  font-size: 26rpx;
}

/* ============================================================
   保密：全屏查看层水印
   ============================================================ */
.viewer {
  position: fixed;
  inset: 0;
  z-index: 300;
  background: rgba(9, 9, 11, .93);
  display: flex;
  flex-direction: column;
  padding: calc(24rpx + env(safe-area-inset-top)) 24rpx calc(24rpx + env(safe-area-inset-bottom));
}
.vw-hd {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.vw-t {
  flex: 1;
  min-width: 0;
  color: #fff;
  font-size: 26rpx;
  font-weight: 600;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.vw-x {
  flex: none;
  width: 64rpx;
  height: 64rpx;
  line-height: 64rpx;
  text-align: center;
  border-radius: 50%;
  background: rgba(255, 255, 255, .14);
  color: #fff;
  font-size: 26rpx;
}
.vw-stage {
  position: relative;
  flex: 1;
  margin-top: 24rpx;
  border-radius: 24rpx;
  overflow: hidden;
  background: linear-gradient(135deg, #4F46E5 0%, #312E81 100%);
  display: flex;
  align-items: center;
  justify-content: center;
}
.vw-media {
  width: 100%;
  height: 100%;
  display: block;
}
/* 查看层轮播：左右滑动切换全部图片 / 视频 */
.vw-swiper {
  position: absolute;
  inset: 0;
  z-index: 1;
  width: 100%;
  height: 100%;
}
.vw-count {
  position: absolute;
  right: 20rpx;
  top: 20rpx;
  z-index: 3;
  font-size: 22rpx;
  line-height: 40rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  color: #fff;
  background: rgba(0, 0, 0, .5);
}
.vw-badge {
  position: absolute;
  left: 20rpx;
  top: 20rpx;
  z-index: 2;
  font-size: 20rpx;
  color: #fff;
  background: rgba(0, 0, 0, .45);
  border-radius: 10rpx;
  padding: 8rpx 16rpx;
}
/* 水印网格：2 列 × 6 行铺满查看层（12 块），保证任意裁剪区域都带账号标识 */
.vw-wm {
  position: absolute;
  inset: 0;
  z-index: 2;
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  grid-template-rows: repeat(6, 1fr);
  align-items: center;
  justify-items: center;
  pointer-events: none;
}
.vw-wm-t {
  max-width: 100%;
  overflow: hidden;
  font-size: 16rpx;
  line-height: 1.3;
  color: rgba(255, 255, 255, .42);
  transform: rotate(-24deg);
  white-space: nowrap;
}
/* 查看层底部完整水印：用户 + 线索号 + 时间 + 禁止转发下载 */
.vw-id {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 24rpx;
  z-index: 2;
  padding: 0 32rpx;
  font-size: 18rpx;
  line-height: 1.4;
  text-align: center;
  color: rgba(255, 255, 255, .45);
  word-break: break-all;
  pointer-events: none;
}
.vw-tip {
  margin-top: 20rpx;
  font-size: 22rpx;
  line-height: 1.6;
  color: rgba(255, 255, 255, .62);
  text-align: center;
}
