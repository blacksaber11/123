.pf-page {
  min-height: 100vh;
  background: var(--paper);
  padding: 20rpx 24rpx 180rpx;
  box-sizing: border-box;
}

/* 页面已有 24rpx 左右内边距，区块不再叠加外边距 */
.block {
  margin: 0 0 20rpx;
}

/* ========== 头部 ========== */
.pf-hero {
  display: flex;
  align-items: center;
  gap: 20rpx;
  background: #fff;
  border: 1rpx solid var(--line);
  border-radius: var(--radius);
  padding: 28rpx;
  margin-bottom: 20rpx;
  box-shadow: var(--shadow);
}
.pf-av {
  width: 96rpx;
  height: 96rpx;
  border-radius: 28rpx;
  background: var(--brand-soft);
  color: var(--brand);
  font-size: 36rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
}
.pf-hd {
  flex: 1;
  min-width: 0;
}
.pf-hd .nm {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--ink);
  margin-bottom: 6rpx;
}
.pf-hd .sb {
  font-size: 22rpx;
  color: var(--muted);
  line-height: 1.5;
  margin-bottom: 12rpx;
}
.pf-tags {
  display: flex;
  gap: 10rpx;
  flex-wrap: wrap;
}

.pf-note {
  margin-bottom: 12rpx;
}

/* 隐私政策 / 用户协议入口 */
.pf-doc {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 0 4rpx 20rpx;
}
.pfd-l {
  font-size: 22rpx;
  color: var(--brand);
}
.pfd-s {
  font-size: 22rpx;
  color: var(--muted);
}

/* 发布前置提示条：列出未填写的必填项 */
.pf-alert {
  margin: 0 0 20rpx;
  padding: 20rpx 24rpx;
  border-radius: 16rpx;
  background: #FFF4E5;
  border: 1rpx solid #FFD8A8;
}
.pf-alert-t {
  font-size: 26rpx;
  font-weight: 600;
  color: #B54708;
  line-height: 1.5;
}
.pf-alert-d {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #B54708;
  opacity: 0.8;
  line-height: 1.5;
}

/* ========== 表单 ========== */
.pf-form {
  border-top: 1rpx solid var(--line-2);
}
.pf-f {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--line-2);
}
/* 从发布页「去完善」定位到的字段：整行高亮，便于用户一眼看到要填哪里 */
.pf-f.focus {
  background: #FFF9F0;
  box-shadow: inset 0 0 0 2rpx #FFB65C;
  border-radius: 12rpx;
  padding-left: 16rpx;
  padding-right: 16rpx;
}
.pf-l {
  flex: none;
  width: 160rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: var(--ink-2);
}
.pf-i {
  flex: 1;
  min-width: 0;
  height: 60rpx;
  font-size: 26rpx;
  color: var(--ink);
}
/* 手机号：只读脱敏值 + 微信授权按钮 */
.pf-phone {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}
.pf-pv {
  flex: 1;
  min-width: 0;
  font-size: 26rpx;
  color: var(--ink-2);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.pf-phone .btn {
  flex: none;
  margin: 0;
}
.pf-pick {
  display: flex;
  align-items: center;
  height: 60rpx;
  font-size: 26rpx;
}
.pf-pt {
  flex: 1;
  color: var(--ink);
}
.pf-pt.placeholder {
  color: #A1A1AA;
}
.pf-pa {
  color: var(--muted);
  font-size: 30rpx;
}

/* 主体类别：企业 / 个人二选一 */
.pf-f-col {
  flex-direction: column;
  align-items: stretch;
  gap: 12rpx;
}
.pf-f-col .pf-l {
  width: auto;
}
/* 信息公开：说明文案 + 两个互斥选项 */
.pf-sub-hd {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--ink-2);
}
.pf-sub-d {
  font-size: 21rpx;
  line-height: 1.5;
  color: var(--muted);
}
.pf-kinds {
  display: flex;
  gap: 16rpx;
}
.pf-kind {
  flex: 1;
  padding: 16rpx 18rpx;
  border: 1rpx solid var(--line);
  border-radius: 14rpx;
  background: #fff;
}
.pf-kind .k {
  display: block;
  font-size: 25rpx;
  font-weight: 600;
  color: var(--ink);
}
.pf-kind .d {
  display: block;
  margin-top: 6rpx;
  font-size: 21rpx;
  line-height: 1.45;
  color: var(--muted);
}
.pf-kind.on {
  border-color: var(--brand-line);
  background: var(--brand-soft);
}
.pf-kind.on .k {
  color: var(--brand);
}

.pf-acts {
  display: flex;
  gap: 16rpx;
  margin-top: 20rpx;
}
.pf-acts .btn {
  flex: 1;
}
.pf-acts .btn.block {
  width: 100%;
}

/* ========== 清单行 ========== */
.item-list {
  border-top: 1rpx solid var(--line-2);
}
.item-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--line-2);
  font-size: 24rpx;
}
.item-row:last-child {
  border-bottom: none;
}
.item-row .nm {
  flex: 1;
  min-width: 0;
  color: var(--ink-2);
}
.item-row .st {
  flex: none;
  font-size: 22rpx;
  padding: 0 14rpx;
  line-height: 38rpx;
  border-radius: 8rpx;
  border: 1rpx solid var(--line);
  color: var(--muted);
}
.item-row .st.ok {
  background: var(--brand-soft);
  border-color: var(--brand-line);
  color: var(--brand);
  font-weight: 600;
}
.item-row .st.no {
  background: #fff;
  border-style: dashed;
  color: var(--muted);
}
.qual-btn {
  flex: none;
  margin-left: 12rpx;
}
