/* 我的库存：概览 + 搜索 + 状态筛选 + 清单卡片，信息三层收口 */

/* ---------- 概览 ---------- */
.st-hero {
  margin: 20rpx 24rpx;
  padding: 28rpx;
  background: #fff;
  border: 1rpx solid var(--line);
  border-radius: var(--radius);
  box-shadow: var(--shadow);
}
.st-hd {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
}
.st-hd-l {
  flex: 1;
  min-width: 0;
}
.st-tt {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--ink);
  line-height: 1.3;
}
.st-ds {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--muted);
  line-height: 1.5;
}
.st-city {
  flex: none;
  font-size: 22rpx;
  line-height: 40rpx;
  padding: 0 16rpx;
  border-radius: 20rpx;
  border: 1rpx solid var(--brand-line);
  background: var(--brand-soft);
  color: var(--brand);
  font-weight: 600;
}

.st-kpis {
  display: flex;
  margin-top: 24rpx;
  padding-top: 22rpx;
  border-top: 1rpx solid var(--line-2);
}
.st-k {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
  position: relative;
}
.st-k + .st-k::before {
  content: '';
  position: absolute;
  left: 0;
  top: 8rpx;
  bottom: 8rpx;
  width: 1rpx;
  background: var(--line-2);
}
.st-k .n {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--ink);
  line-height: 1.2;
}
.st-k .l {
  font-size: 21rpx;
  color: var(--muted);
}
.st-k.link .n {
  color: var(--brand);
}
.st-k.link .l {
  color: var(--brand);
}

/* ---------- 搜索 / 导出 ---------- */
.st-tools {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin: 0 24rpx 16rpx;
}
.st-search {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 10rpx;
  height: 72rpx;
  padding: 0 20rpx;
  background: #fff;
  border: 1rpx solid var(--line);
  border-radius: 16rpx;
}
.st-search-ico {
  flex: none;
  width: 30rpx;
  height: 30rpx;
  display: block;
}
.st-search-in {
  flex: 1;
  min-width: 0;
  font-size: 26rpx;
  color: var(--ink);
}
.st-search-x {
  flex: none;
  width: 40rpx;
  height: 40rpx;
  line-height: 40rpx;
  text-align: center;
  font-size: 22rpx;
  color: var(--muted);
  background: var(--line-2);
  border-radius: 50%;
}
.st-export {
  flex: none;
  height: 72rpx;
  padding: 0 26rpx;
  line-height: 72rpx;
  font-size: 25rpx;
  color: var(--ink-2);
  background: #fff;
  border: 1rpx solid var(--line);
  border-radius: 16rpx;
}

/* ---------- 筛选 + 添加 ---------- */
.st-bar {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin: 0 24rpx 16rpx;
}
.st-tabs {
  flex: 1;
  min-width: 0;
  display: flex;
  gap: 6rpx;
}
.st-tab {
  display: flex;
  align-items: center;
  gap: 6rpx;
  height: 60rpx;
  padding: 0 20rpx;
  font-size: 24rpx;
  color: var(--ink-2);
  border-radius: 30rpx;
  border: 1rpx solid transparent;
}
.st-tab.on {
  background: #fff;
  border-color: var(--line);
  color: var(--ink);
  font-weight: 600;
}
.st-tab-n {
  font-size: 20rpx;
  color: var(--muted);
}
.st-tab.on .st-tab-n {
  color: var(--brand);
}
.st-add {
  flex: none;
  height: 60rpx;
  padding: 0 24rpx;
  line-height: 60rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: #fff;
  background: var(--brand);
  border-radius: 30rpx;
}

/* ---------- 库存卡片 ---------- */
.st-list {
  padding: 0 24rpx;
}
.st-card {
  background: #fff;
  border: 1rpx solid var(--line);
  border-radius: var(--radius);
  padding: 24rpx;
  margin-bottom: 16rpx;
  box-shadow: var(--shadow);
}
.st-card.off {
  background: #FCFCFC;
}
.st-card-hd {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
}
.st-name {
  flex: 1;
  min-width: 0;
}
.st-model {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
  color: var(--ink);
  line-height: 1.4;
  word-break: break-all;
}
.st-card.off .st-model {
  color: var(--ink-2);
}
.st-meta-line {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--muted);
  line-height: 1.4;
}
.st-tag {
  flex: none;
  font-size: 20rpx;
  line-height: 34rpx;
  padding: 0 12rpx;
  border-radius: 8rpx;
  font-weight: 600;
}
.st-tag.on {
  color: var(--brand);
  background: var(--brand-soft);
  border: 1rpx solid var(--brand-line);
}
.st-tag.off {
  color: var(--muted);
  background: var(--line-2);
  border: 1rpx solid var(--line);
}

.st-figures {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 18rpx;
}
.st-price {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--ink);
  line-height: 1.2;
}
.st-u {
  font-size: 22rpx;
  font-weight: 400;
  color: var(--muted);
}
.st-qty {
  font-size: 22rpx;
  color: var(--muted);
}
.st-qty-n {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--ink);
  margin: 0 2rpx;
}

.st-meta {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 14rpx;
  font-size: 21rpx;
  color: var(--muted);
}
.st-meta-i.right {
  margin-left: auto;
}
.st-meta-i.link {
  color: var(--brand);
}

.st-desc {
  margin-top: 14rpx;
  padding: 14rpx 16rpx;
  background: var(--paper);
  border-radius: 12rpx;
  font-size: 23rpx;
  line-height: 1.6;
  color: var(--ink-2);
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.st-acts {
  display: flex;
  margin-top: 18rpx;
  padding-top: 6rpx;
  border-top: 1rpx solid var(--line-2);
}
.st-act {
  flex: 1;
  height: 64rpx;
  line-height: 64rpx;
  text-align: center;
  font-size: 25rpx;
  color: var(--ink-2);
  position: relative;
}
.st-act + .st-act::before {
  content: '';
  position: absolute;
  left: 0;
  top: 20rpx;
  bottom: 20rpx;
  width: 1rpx;
  background: var(--line-2);
}
.st-act.danger {
  color: var(--danger);
}
.st-act:active {
  opacity: .6;
}

/* ---------- 空态 / 底部 ---------- */
.st-empty {
  margin: 32rpx 24rpx;
  padding: 56rpx 40rpx;
  background: #fff;
  border: 1rpx dashed var(--line);
  border-radius: var(--radius);
  text-align: center;
}
.se-ico {
  width: 88rpx;
  height: 88rpx;
  display: block;
  margin: 0 auto 16rpx;
}
.se-tt {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--ink);
}
.se-ds {
  margin-top: 8rpx;
  font-size: 23rpx;
  color: var(--muted);
  line-height: 1.6;
}
.se-btn {
  display: inline-block;
  margin-top: 26rpx;
  height: 68rpx;
  line-height: 68rpx;
  padding: 0 36rpx;
  font-size: 26rpx;
  border-radius: 34rpx;
  border: 1rpx solid var(--line);
  color: var(--ink);
  background: #fff;
}
.se-btn.primary {
  border-color: var(--brand);
  background: var(--brand);
  color: #fff;
}
.st-foot {
  margin: 8rpx 24rpx 24rpx;
}

/* ---------- 底部弹层：添加 / 编辑 ---------- */
.sheet-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 120;
  background: rgba(17, 17, 17, .45);
  display: flex;
  align-items: flex-end;
}
.sheet {
  width: 100%;
  max-height: 86vh;
  display: flex;
  flex-direction: column;
  background: #fff;
  border-radius: 28rpx 28rpx 0 0;
  padding: 0;
  animation: sheet-up .22s ease-out;
}
/* 表单弹层必须给定高度：scroll-view 的 flex:1 只有在父容器高度确定时才能算出可滚动区域 */
.sheet-form {
  height: 86vh;
  max-height: 86vh;
}
@keyframes sheet-up {
  from { transform: translateY(40rpx); opacity: 0; }
  to { transform: translateY(0); opacity: 1; }
}
.sheet-hd {
  flex: none;
  display: flex;
  align-items: center;
  padding: 28rpx 28rpx 20rpx;
  border-bottom: 1rpx solid var(--line-2);
}
.sheet-tt {
  flex: 1;
  font-size: 30rpx;
  font-weight: 700;
  color: var(--ink);
}
.sheet-x {
  flex: none;
  width: 56rpx;
  height: 56rpx;
  line-height: 56rpx;
  text-align: center;
  font-size: 26rpx;
  color: var(--muted);
  background: var(--line-2);
  border-radius: 50%;
}
.sheet-body {
  flex: 1;
  height: 0;
  min-height: 0;
  width: 100%;
  box-sizing: border-box;
  padding: 8rpx 28rpx 20rpx;
  overflow: hidden;
}
/* scroll-view 内部填充，确保内容高度正确触发滚动 */
.sheet-body > view {
  box-sizing: border-box;
}
.sheet-foot {
  flex: none;
  padding: 16rpx 28rpx calc(16rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid var(--line-2);
}

.sec-tt {
  margin: 18rpx 0 16rpx;
  font-size: 24rpx;
  font-weight: 700;
  color: var(--ink);
}
.sec-tt:first-child {
  margin-top: 12rpx;
}
.f-label {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--ink-2);
  margin: 18rpx 0 10rpx;
}
.f-req {
  color: var(--danger);
  margin-left: 4rpx;
}
.f-opt {
  font-weight: 400;
  font-size: 21rpx;
  color: var(--muted);
  margin-left: 8rpx;
}
.f-input {
  width: 100%;
  height: 76rpx;
  padding: 0 20rpx;
  font-size: 26rpx;
  color: var(--ink);
  background: #fff;
  border: 1rpx solid var(--line);
  border-radius: 12rpx;
  line-height: 76rpx;
}
.f-picker {
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: var(--ink);
}
.f-arrow {
  color: var(--muted);
  font-size: 26rpx;
}
.f-placeholder {
  color: var(--muted);
}
.f-row {
  display: flex;
  gap: 16rpx;
}
.f-col {
  flex: 1;
  min-width: 0;
}
.f-city {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.f-city-use {
  flex: none;
  font-size: 22rpx;
  color: var(--brand);
  padding: 0 16rpx;
  height: 56rpx;
  line-height: 56rpx;
  background: var(--brand-soft);
  border-radius: 12rpx;
}
.f-textarea {
  width: 100%;
  height: 170rpx;
  padding: 18rpx 20rpx;
  font-size: 26rpx;
  line-height: 1.6;
  color: var(--ink);
  background: #fff;
  border: 1rpx solid var(--line);
  border-radius: 12rpx;
}
/* 设备搜索：单框输入，选中后型号直接显示在同一个框里 */
.f-dev {
  display: flex;
  align-items: center;
  gap: 12rpx;
  height: 76rpx;
  padding: 0 20rpx;
  background: #fff;
  border: 1rpx solid var(--line);
  border-radius: 12rpx;
}
.f-dev-ico {
  flex: none;
  width: 28rpx;
  height: 28rpx;
  display: block;
  opacity: 0.5;
}
.f-dev-in {
  flex: 1;
  min-width: 0;
  height: 76rpx;
  font-size: 26rpx;
  color: var(--ink);
}
.f-dev-x {
  flex: none;
  width: 44rpx;
  height: 44rpx;
  line-height: 44rpx;
  text-align: center;
  font-size: 22rpx;
  color: var(--muted);
}
.f-dev-results {
  margin-top: 10rpx;
  background: #fff;
  border: 1rpx solid var(--line);
  border-radius: 12rpx;
}
.f-dev-item {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  padding: 16rpx 20rpx;
  border-bottom: 1rpx solid var(--line-2);
}
.f-dev-item:last-child {
  border-bottom: none;
}
.f-dev-item:active {
  background: var(--brand-soft);
}
.f-dev-name {
  font-size: 25rpx;
  font-weight: 500;
  color: var(--ink);
}
.f-dev-path {
  font-size: 21rpx;
  color: var(--muted);
}
.f-dev-path.now {
  margin-top: 10rpx;
}
.f-dev-empty {
  padding: 26rpx 20rpx;
  text-align: center;
  font-size: 22rpx;
  color: var(--muted);
}
.f-tip {
  margin-top: 12rpx;
  font-size: 21rpx;
  color: var(--muted);
  line-height: 1.6;
}

/* 库存图片：3 列缩略图 + 虚线添加格 */
.f-imgs {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 6rpx;
}
.f-img {
  position: relative;
  width: 196rpx;
  height: 196rpx;
  border-radius: 14rpx;
  overflow: hidden;
  background: var(--paper);
  border: 1rpx solid var(--line);
}
.f-img-pic {
  width: 100%;
  height: 100%;
  display: block;
}
.f-img-x {
  position: absolute;
  top: 0;
  right: 0;
  width: 42rpx;
  height: 42rpx;
  line-height: 42rpx;
  text-align: center;
  font-size: 22rpx;
  color: #fff;
  background: rgba(0, 0, 0, 0.45);
  border-bottom-left-radius: 14rpx;
}
.f-img.add {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border-style: dashed;
  color: var(--muted);
}
.f-img-plus {
  font-size: 44rpx;
  line-height: 1;
  color: var(--brand);
}
.f-img-tip {
  margin-top: 10rpx;
  font-size: 21rpx;
}

/* 列表卡片上的库存图片 */
.st-imgs {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 12rpx;
}
.st-img {
  width: 132rpx;
  height: 132rpx;
  border-radius: 12rpx;
  background: var(--paper);
}

/* 设备类型横向滚动 */
.cat-scroll {
  width: 100%;
  white-space: nowrap;
}
.cat-row {
  display: inline-flex;
  gap: 12rpx;
  padding-bottom: 4rpx;
}
.cat-item {
  flex: none;
  height: 60rpx;
  line-height: 58rpx;
  padding: 0 22rpx;
  font-size: 24rpx;
  color: var(--ink-2);
  background: #fff;
  border: 1rpx solid var(--line);
  border-radius: 30rpx;
}
.cat-item.on {
  color: var(--brand);
  background: var(--brand-soft);
  border-color: var(--brand);
  font-weight: 600;
}

/* ---------- 导出面板 ---------- */
.ex-tip {
  padding: 20rpx 28rpx 0;
  font-size: 22rpx;
  color: var(--muted);
  line-height: 1.6;
}
.ex-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin: 16rpx 28rpx;
  padding: 22rpx;
  border: 1rpx solid var(--line);
  border-radius: 16rpx;
}
.ex-row:last-child {
  margin-bottom: calc(28rpx + env(safe-area-inset-bottom));
}
.ex-main {
  flex: 1;
  min-width: 0;
}
.ex-k {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--ink);
}
.ex-v {
  margin-top: 4rpx;
  font-size: 21rpx;
  color: var(--muted);
  line-height: 1.5;
}
