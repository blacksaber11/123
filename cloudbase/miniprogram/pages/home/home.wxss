.home {
  /* 自定义 tabBar 不再由框架预留底部空间，页面自己留白 */
  padding-bottom: calc(150rpx + env(safe-area-inset-bottom));
  background: var(--paper);
  min-height: 100vh;
}

/* 固定头部：Tab + 搜索栏不随列表滑动 */
.home-hd {
  position: sticky;
  top: 0;
  z-index: 20;
  background: #fff;
  border-bottom: 1rpx solid var(--line);
  box-shadow: 0 6rpx 24rpx rgba(16, 24, 40, .04);
}

/* 分段 Tab：与管理端运营中台的 seg 控件同一口径 */
.seg-tabs {
  display: inline-flex;
  gap: 4rpx;
  margin: 20rpx 32rpx 0;
  padding: 6rpx;
  background: var(--line-2);
  border-radius: 20rpx;
  align-items: center;
}
.seg-tabs .seg {
  position: relative;
  font-size: 24rpx;
  color: var(--muted);
  padding: 14rpx 26rpx;
  border-radius: 16rpx;
  font-weight: 600;
  white-space: nowrap;
}
.seg-tabs .seg.on {
  background: #fff;
  color: var(--ink);
  box-shadow: 0 2rpx 8rpx rgba(16, 24, 40, .1);
}

/* 首页横幅：标题横向逐字滚动，速度由管理端配置（换算成 animation-duration） */
.home-banner {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin: 16rpx 32rpx 0;
  padding: 0 18rpx;
  height: 64rpx;
  border-radius: 16rpx;
  background: linear-gradient(90deg, #EEF2FF 0%, #F7F9FF 100%);
  border: 1rpx solid var(--brand-line);
  overflow: hidden;
}
.home-banner .hb-ico {
  flex: none;
  padding: 3rpx 10rpx;
  border-radius: 8rpx;
  background: var(--brand);
  color: #fff;
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}
.home-banner .hb-view {
  flex: 1;
  min-width: 0;
  overflow: hidden;
}
.home-banner .hb-track {
  display: inline-flex;
  align-items: center;
  white-space: nowrap;
  animation-name: hb-scroll;
  animation-timing-function: linear;
  animation-iteration-count: infinite;
  will-change: transform;
}
.home-banner .hb-text {
  padding-right: 48rpx;
  font-size: 24rpx;
  color: #4338CA;
  white-space: nowrap;
}
.home-banner .hb-more {
  flex: none;
  font-size: 22rpx;
  color: var(--brand);
  font-weight: 600;
}
/* 两份相同文案首尾相接，位移一半即完成一轮，视觉上无缝 */
@keyframes hb-scroll {
  from { transform: translateX(0); }
  to { transform: translateX(-50%); }
}

/* 横幅详情弹窗 */
.banner-modal {
  position: fixed;
  left: 60rpx;
  right: 60rpx;
  top: 50%;
  transform: translateY(-50%);
  z-index: 120;
  display: flex;
  flex-direction: column;
  max-height: 68vh;
  border-radius: 28rpx;
  background: #fff;
  overflow: hidden;
  box-shadow: 0 24rpx 80rpx rgba(16, 24, 40, .22);
}
.banner-modal .bm-hd {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 32rpx 12rpx;
}
.banner-modal .bm-tt {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--ink);
}
.banner-modal .bm-x {
  flex: none;
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: -14rpx -14rpx -14rpx 0;
  font-size: 30rpx;
  color: var(--muted);
}
.banner-modal .bm-bd {
  flex: 1;
  max-height: 46vh;
  padding: 0 32rpx;
}
.banner-modal .bm-item {
  padding: 18rpx 0;
  border-bottom: 1rpx dashed var(--line);
}
.banner-modal .bm-item:last-child {
  border-bottom: 0;
}
.banner-modal .bm-t {
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1.5;
  color: var(--ink);
}
.banner-modal .bm-c {
  margin-top: 8rpx;
  font-size: 26rpx;
  line-height: 1.7;
  color: var(--muted);
  white-space: pre-wrap;
  word-break: break-all;
}
.banner-modal .bm-ft {
  padding: 16rpx 32rpx calc(24rpx + env(safe-area-inset-bottom));
}
.banner-modal .bm-ft .btn {
  width: 100%;
}

/* 搜索栏 */
.searchbar {
  padding: 10rpx 32rpx 16rpx;
  background: #fff;
}
.search-field {
  display: flex;
  align-items: center;
  gap: 16rpx;
  height: 76rpx;
  padding: 0 24rpx;
  border: 1rpx solid var(--line);
  border-radius: 18rpx;
  background: #fff;
  color: var(--muted);
  font-size: 26rpx;
  box-shadow: 0 2rpx 8rpx rgba(16, 24, 40, .04);
  transition: border-color .15s ease;
}
.search-field .s-ico {
  flex: none;
  width: 28rpx;
  height: 28rpx;
  display: block;
}
.search-field .s-input {
  flex: 1;
  font-size: 26rpx;
  color: var(--ink);
}
.search-field .s-clear {
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 64rpx;
  height: 64rpx;
  margin-right: -12rpx;
  font-size: 22rpx;
  color: var(--muted);
}

/* 排序条 */
.sortbar {
  display: flex;
  align-items: center;
  gap: 4rpx;
  padding: 16rpx 24rpx 20rpx;
  background: #fff;
  border-bottom: 1rpx solid var(--line-2);
}
.sort-scroll {
  flex: 1;
  min-width: 0;
  height: 64rpx;
  white-space: nowrap;
}
.sort-items {
  display: inline-flex;
  align-items: center;
  height: 64rpx;
  gap: 12rpx;
  /* inline-flex 参与行内排版会带基线间隙，顶部对齐让滚动区与筛选按钮严格同高 */
  vertical-align: top;
}
.sortbar .s-item {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border: 0;
  background: none;
  font-size: 24rpx;
  color: var(--ink-2);
  height: 64rpx;
  padding: 0 16rpx;
  border-radius: 12rpx;
  white-space: nowrap;
}
.sortbar .s-item.on {
  color: var(--brand);
  font-weight: 600;
  background: var(--brand-soft);
}
.filter-btn {
  margin-left: auto;
  border: 1rpx solid var(--line);
  background: #fff;
  border-radius: 14rpx;
  font-size: 24rpx;
  height: 64rpx;
  padding: 0 20rpx;
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
  color: var(--ink-2);
  white-space: nowrap;
  flex: none;
}
.filter-btn.active {
  border-color: var(--brand-line);
  background: var(--brand-soft);
  color: var(--brand);
}
.filter-btn .badge {
  min-width: 28rpx;
  height: 28rpx;
  line-height: 28rpx;
  padding: 0 6rpx;
  border-radius: 14rpx;
  background: var(--brand);
  color: #fff;
  font-size: 18rpx;
  text-align: center;
}

/* 已选筛选条件 */
.active-filters {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 10rpx;
  padding: 0 24rpx 16rpx;
  background: #fff;
  border-bottom: 1rpx solid var(--line-2);
}
.active-filters .af {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  font-size: 20rpx;
  line-height: 34rpx;
  padding: 0 12rpx;
  border-radius: 10rpx;
  background: var(--brand-soft);
  border: 1rpx solid var(--brand-line);
  color: var(--brand);
}
.active-filters .af-x {
  font-size: 18rpx;
  opacity: .7;
}
.active-filters .af-clear {
  font-size: 20rpx;
  height: 56rpx;
  line-height: 56rpx;
  padding: 0 14rpx;
  color: var(--muted);
}

/* 信息流 */
.feed {
  padding: 20rpx 24rpx 16rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

/* 商品 / 需求卡片样式统一由 app.wxss 提供，页面内不再重复定义 */

/* 空状态统一走 app.wxss 的 .empty / .big / .ttl / .ds，页面内不再重复定义 */

.loading {
  text-align: center;
  color: var(--muted);
  font-size: 26rpx;
  padding: 80rpx 0;
}

/* 筛选面板 */
.filter-mask {
  position: fixed;
  inset: 0;
  background: rgba(24, 24, 27, .4);
  z-index: 90;
}
.filter-sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 91;
  background: #fff;
  border-radius: 28rpx 28rpx 0 0;
  display: flex;
  flex-direction: column;
  /* 底部安全区只由 .fs-ft.safe-bottom 负责，这里不再叠加，否则会多出一倍空白 */
  animation: sheet-up .22s ease-out;
}
@keyframes sheet-up {
  from {
    transform: translateY(60rpx);
    opacity: .4;
  }
  to {
    transform: translateY(0);
    opacity: 1;
  }
}
.fs-hd {
  position: relative;
  padding: 28rpx 32rpx 18rpx;
  border-bottom: 1rpx solid var(--line-2);
}
.fs-tt {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--ink);
}
.fs-sub {
  font-size: 22rpx;
  color: var(--muted);
  margin-top: 4rpx;
}
.fs-x {
  position: absolute;
  right: 20rpx;
  top: 18rpx;
  width: 72rpx;
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  border-radius: 14rpx;
  background: var(--line-2);
  color: var(--ink-2);
  font-size: 24rpx;
}
.fs-bd {
  height: 46vh;
  padding: 4rpx 32rpx 0;
  box-sizing: border-box;
}
.fgroup {
  padding: 18rpx 0;
  border-bottom: 1rpx dashed var(--line-2);
}
.fg-hd {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 14rpx;
}
.fg-hd .n {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--ink);
}
.fg-hd .hint {
  margin-left: auto;
  font-size: 20rpx;
  color: var(--muted);
}
.fopts {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}
.fopt {
  font-size: 22rpx;
  line-height: 52rpx;
  padding: 0 20rpx;
  border-radius: 12rpx;
  border: 1rpx solid var(--line);
  background: #fff;
  color: var(--ink-2);
}
.fopt.on {
  border-color: var(--brand);
  background: var(--brand-soft);
  color: var(--brand);
  font-weight: 600;
}
.fs-count {
  text-align: center;
  font-size: 22rpx;
  color: var(--muted);
  padding: 20rpx 0 24rpx;
}

/* 城市两级菜单：左侧大区、右侧城市 */
.fgroup-city {
  padding-bottom: 12rpx;
}
.city-picker {
  display: flex;
  gap: 16rpx;
}
.cp-left {
  width: 172rpx;
  height: 360rpx;
  flex: none;
  box-sizing: border-box;
  padding: 8rpx;
  border-radius: 16rpx;
  background: var(--line-2);
}
.cp-prov {
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 0 12rpx;
  line-height: 62rpx;
  border-radius: 12rpx;
  font-size: 24rpx;
  color: var(--ink-2);
}
.cp-prov.on {
  background: #fff;
  color: var(--brand);
  font-weight: 600;
}
.cp-prov .cp-name {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.cp-prov .cp-dot {
  flex: none;
  min-width: 26rpx;
  height: 26rpx;
  padding: 0 6rpx;
  border-radius: 13rpx;
  background: var(--brand);
  color: #fff;
  font-size: 18rpx;
  line-height: 26rpx;
  text-align: center;
  box-sizing: border-box;
}
.cp-right {
  flex: 1;
  min-width: 0;
  height: 360rpx;
}
.cp-cities {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  padding: 4rpx 0 8rpx;
}
.cp-city {
  font-size: 22rpx;
  line-height: 52rpx;
  padding: 0 20rpx;
  border-radius: 12rpx;
  border: 1rpx solid var(--line);
  background: #fff;
  color: var(--ink-2);
}
.cp-city.on {
  border-color: var(--brand);
  background: var(--brand-soft);
  color: var(--brand);
  font-weight: 600;
}
.fs-ft {
  display: flex;
  gap: 16rpx;
  padding: 16rpx 32rpx;
  border-top: 1rpx solid var(--line-2);
}
.fs-ft .btn {
  flex: 1;
}
/* 城市选择 / 代采表单内容更长，比分筛选面板给更高的可视区 */
.filter-sheet.tall .fs-bd {
  height: 62vh;
}

/* 资讯投稿弹层：固定高度 + 正文自适应滚动，底部「取消 / 发布」永远在弹层内可见，
   不会因为内容变长或小屏被挤出可视区；键盘弹起时高度由行内样式换算到键盘上方 */
.filter-sheet.news-sheet {
  height: 84vh;
}
.filter-sheet.news-sheet .fs-bd {
  height: auto;
  flex: 1;
  min-height: 0;
}
.filter-sheet.news-sheet .fs-ft {
  flex: none;
}

/* ============================================================
   现货盘（阶段一）：脱敏报价卡片
   报价卡不展示报价方身份，只留「报价方信息仅平台可见」提示
   ============================================================ */
.q-card {
  background: #fff;
  border: 1rpx solid var(--line);
  border-radius: var(--radius);
  padding: 28rpx;
  box-shadow: var(--shadow);
}
.q-card:active {
  background: var(--line-2);
}
.q-card .q-top {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.q-card .q-cat {
  font-size: 20rpx;
  line-height: 34rpx;
  padding: 0 12rpx;
  border-radius: 8rpx;
  background: var(--brand-soft);
  color: var(--brand);
  font-weight: 600;
}
.q-card .q-ttl {
  margin-left: auto;
  font-size: 20rpx;
  line-height: 34rpx;
  padding: 0 10rpx;
  border-radius: 8rpx;
  color: var(--muted);
  background: var(--line-2);
}
.q-card .q-ttl.low {
  color: var(--warn);
  background: var(--warn-soft);
  font-weight: 600;
}
.q-card .q-model {
  margin-top: 14rpx;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1.5;
  color: var(--ink);
}
.q-card .q-meta {
  display: flex;
  align-items: baseline;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 10rpx;
}
.q-card .q-price {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--ink);
  letter-spacing: -.01em;
  line-height: 1.2;
}
.q-card .q-price .q-unit {
  font-size: 22rpx;
  font-weight: 400;
  color: var(--muted);
}
.q-card .q-sub {
  font-size: 22rpx;
  color: var(--muted);
}
.q-card .q-foot {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 18rpx;
  padding-top: 16rpx;
  border-top: 1rpx dashed var(--line-2);
}
.q-card .q-note {
  flex: 1;
  min-width: 0;
  font-size: 20rpx;
  color: var(--muted);
}
.q-card .q-foot .btn {
  flex: none;
}

/* ============================================================
   测算工具 / 发布资讯：表单组
   ============================================================ */
.dc-group {
  margin-top: 20rpx;
}
.dc-label {
  font-size: 22rpx;
  color: var(--muted);
  margin-bottom: 10rpx;
}
.dc-input,
.dc-static {
  width: 100%;
  box-sizing: border-box;
  height: 84rpx;
  padding: 0 20rpx;
  border: 1rpx solid var(--line);
  border-radius: 14rpx;
  background: var(--line-2);
  font-size: 26rpx;
  color: var(--ink);
}
/* 发布城市等只读字段：样式与输入框一致，但不可编辑 */
.dc-static {
  line-height: 84rpx;
  border-style: dashed;
  color: var(--muted);
}
/* 资讯发布：私密发布开关行（沿用 dc-static 外框，内部横向排列） */
.news-priv-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}
.news-priv-t {
  flex: 1;
  min-width: 0;
  font-size: 24rpx;
  line-height: 1.4;
  color: var(--ink-2);
}

/* ============================================================
   弹层内表单：文本域 + 提示（发布资讯共用）
   ============================================================ */
.pa-ta {
  width: 100%;
  box-sizing: border-box;
  height: 240rpx;
  margin-top: 20rpx;
  padding: 20rpx;
  border: 1rpx solid var(--line);
  border-radius: 16rpx;
  background: var(--line-2);
  font-size: 24rpx;
  line-height: 1.7;
  color: var(--ink);
}
.pa-hint {
  margin-top: 4rpx;
  font-size: 20rpx;
  color: var(--muted);
  line-height: 1.6;
}

/* ============================================================
   首页工具入口：测算 / 实时货盘 / 资讯圈 / 发布委托
   ============================================================ */
.home-tools {
  display: flex;
  gap: 12rpx;
  margin: 20rpx 24rpx 0;
  padding: 20rpx 16rpx;
  background: #fff;
  border: 1rpx solid var(--line);
  border-radius: var(--radius);
  box-shadow: var(--shadow);
}
.ht-item {
  position: relative;
  flex: 1;
  min-width: 0;
  padding: 18rpx 6rpx 16rpx;
  border: 1rpx solid var(--line-2);
  border-radius: 20rpx;
  background: var(--line-2);
  text-align: center;
}
.ht-item:active {
  background: var(--brand-soft);
  border-color: var(--brand-line);
}
.ht-ico {
  width: 52rpx;
  height: 52rpx;
  margin: 0 auto 8rpx;
  border-radius: 14rpx;
  background: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
}
.ht-img {
  width: 38rpx;
  height: 38rpx;
  display: block;
}
.ht-tt {
  font-size: 23rpx;
  font-weight: 600;
  color: var(--ink);
}
.ht-ds {
  margin-top: 2rpx;
  font-size: 19rpx;
  color: var(--muted);
  /* 商机副标题带型号列表，限两行，避免把整排工具卡片撑高 */
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  word-break: break-all;
}
/* 商机角标：与库存匹配、尚未领取的商机数，吸引用户开通 */
.ht-badge {
  position: absolute;
  top: 6rpx;
  right: 6rpx;
  min-width: 30rpx;
  height: 30rpx;
  padding: 0 8rpx;
  border-radius: 15rpx;
  background: #e8342a;
  color: #fff;
  font-size: 19rpx;
  line-height: 30rpx;
  text-align: center;
  box-sizing: border-box;
}

/* ============================================================
   资讯圈：全国 / 同城 / 选择城市，按发布地址筛选
   ============================================================ */
.news-scope {
  display: flex;
  align-items: center;
  padding: 14rpx 24rpx;
  background: #fff;
  border-bottom: 1rpx solid var(--line-2);
}
/* 筛选 chip 横向滚动，发布入口常驻右侧，窄屏也不会被挤出 */
.ns-scroll {
  flex: 1;
  min-width: 0;
}
.ns-chips {
  display: inline-flex;
  align-items: center;
  white-space: nowrap;
}
.ns-chip {
  flex: none;
  margin-right: 10rpx;
  padding: 8rpx 16rpx;
  border: 1rpx solid transparent;
  border-radius: 14rpx;
  background: var(--line-2);
  color: var(--ink-2);
  font-size: 22rpx;
  white-space: nowrap;
}
.ns-chip:last-child {
  margin-right: 0;
}
.ns-chip.on {
  background: var(--brand-soft);
  border-color: var(--brand-line);
  color: var(--brand);
  font-weight: 600;
}
.ns-pub {
  flex: none;
  margin-left: 12rpx;
  padding: 8rpx 0 8rpx 12rpx;
  border-left: 1rpx solid var(--line-2);
  color: var(--brand);
  font-size: 22rpx;
  font-weight: 600;
  white-space: nowrap;
}
.news-stat {
  padding: 12rpx 28rpx 0;
  background: #fff;
  color: var(--muted);
  font-size: 20rpx;
}
.n-card {
  padding: 28rpx;
  border: 1rpx solid var(--line);
  border-radius: var(--radius);
  background: #fff;
  box-shadow: var(--shadow);
}
.n-top {
  display: flex;
  align-items: center;
  gap: 14rpx;
}
.n-avatar {
  flex: none;
  width: 56rpx;
  height: 56rpx;
  line-height: 56rpx;
  border-radius: 16rpx;
  background: var(--brand-soft);
  color: var(--brand);
  font-size: 24rpx;
  font-weight: 700;
  text-align: center;
}
.n-avatar.off {
  background: var(--warn-soft);
  color: var(--warn);
}
.n-src {
  flex: 1;
  min-width: 0;
}
.n-author {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--ink);
}
.n-sub {
  margin-top: 2rpx;
  font-size: 20rpx;
  color: var(--muted);
}
.n-cat {
  flex: none;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  background: var(--line-2);
  color: var(--ink-2);
  font-size: 20rpx;
}
.n-title {
  margin-top: 16rpx;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.45;
  color: var(--ink);
}
.n-sum {
  margin-top: 8rpx;
  font-size: 23rpx;
  line-height: 1.7;
  color: var(--ink-2);
}
.n-foot {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 16rpx;
  padding-top: 14rpx;
  border-top: 1rpx dashed var(--line-2);
  font-size: 20rpx;
  color: var(--muted);
}
.n-addr {
  margin-left: auto;
}
.nc-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  padding: 20rpx 0;
}
.nc-city {
  flex: 0 0 calc((100% - 36rpx) / 4);
  height: 68rpx;
  line-height: 66rpx;
  border: 1rpx solid var(--line);
  border-radius: 14rpx;
  background: var(--line-2);
  color: var(--ink-2);
  font-size: 24rpx;
  text-align: center;
  box-sizing: border-box;
}
.nc-city.on {
  background: var(--brand-soft);
  border-color: var(--brand-line);
  color: var(--brand);
  font-weight: 600;
}

/* 测算结果 */
.calc-res {
  margin-top: 18rpx;
  padding: 20rpx;
  border: 1rpx solid var(--brand-line);
  border-radius: 16rpx;
  background: var(--brand-soft);
}
.calc-fee {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--brand);
  letter-spacing: -.01em;
}
.calc-row {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--ink-2);
  line-height: 1.7;
}
.calc-note {
  margin-top: 10rpx;
  font-size: 20rpx;
  color: var(--muted);
  line-height: 1.7;
}

/* ===== 朋友圈式资讯卡片 ===== */
.mo-card {
  padding: 28rpx;
  border: 1rpx solid var(--line);
  border-radius: var(--radius);
  background: #fff;
  box-shadow: var(--shadow);
}
.mo-hd {
  display: flex;
  align-items: center;
  gap: 14rpx;
}
.mo-av {
  flex: none;
  width: 72rpx;
  height: 72rpx;
  line-height: 72rpx;
  border-radius: 14rpx;
  background: var(--brand-soft);
  color: var(--brand);
  font-size: 26rpx;
  font-weight: 700;
  text-align: center;
}
.mo-av.off {
  background: var(--warn-soft);
  color: var(--warn);
}
.mo-src {
  flex: 1;
  min-width: 0;
}
.mo-name {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--ink);
}
.mo-sub {
  margin-top: 4rpx;
  font-size: 20rpx;
  color: var(--muted);
}
.mo-cat {
  flex: none;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  background: var(--line-2);
  color: var(--ink-2);
  font-size: 20rpx;
}
.mo-title {
  margin-top: 16rpx;
  font-size: 29rpx;
  font-weight: 700;
  line-height: 1.45;
  color: var(--ink);
}
.mo-text {
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: var(--ink-2);
}
.mo-full {
  margin-left: 8rpx;
  color: var(--brand);
  font-weight: 600;
}
.mo-media {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 16rpx;
}
.mo-img {
  width: calc((100% - 16rpx) / 3);
  height: 216rpx;
  border-radius: 10rpx;
  background: var(--line-2);
}
.mo-media.two .mo-img {
  width: calc((100% - 8rpx) / 2);
  height: 250rpx;
}
.mo-media.single .mo-img {
  width: 62%;
  height: 380rpx;
}
.mo-video {
  width: 100%;
  height: 400rpx;
  border-radius: 12rpx;
  background: #000;
}
/* 互动区：左侧浏览数 + 评论框（到卡片 2/3 处），赞 / 分享靠右 */
.mo-acts {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8rpx;
  margin-top: 16rpx;
  padding-top: 10rpx;
  border-top: 1rpx solid var(--line-2);
}
/* 左侧区域固定占卡片 2/3，评论框在其中占满剩余宽度 */
.mo-left {
  flex: none;
  width: 66%;
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 8rpx;
}
/* 评论关闭时左侧仍保持 2/3，赞 / 分享固定在最右侧，不随评论隐藏而左移 */
/* 右侧：赞 / 分享 */
.mo-ops {
  flex: none;
  display: flex;
  align-items: center;
  gap: 4rpx;
}
/* 浏览次数：描边小框 */
.mo-views {
  flex: none;
  height: 58rpx;
  padding: 0 16rpx;
  line-height: 58rpx;
  border: 1rpx solid var(--line-2);
  border-radius: 10rpx;
  color: var(--muted);
  font-size: 20rpx;
  white-space: nowrap;
}
/* 评论框：占满左侧剩余宽度，输入后右侧出现「发送」 */
.mo-cmt-box {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 8rpx;
  height: 58rpx;
  padding: 0 18rpx;
  border-radius: 10rpx;
  background: var(--line-2);
}
/* 操作按钮：整体靠右 */
.mo-act {
  flex: none;
  display: flex;
  align-items: center;
  gap: 4rpx;
  height: 56rpx;
  padding: 0 8rpx;
  border: none;
  border-radius: 8rpx;
  background: transparent;
  color: var(--muted);
  font-size: 22rpx;
  line-height: 1;
}
.mo-act.on {
  color: var(--brand);
}
/* 转发按钮：重置小程序 button 默认样式，与点赞同一视觉 */
.mo-act-btn {
  width: auto;
  min-width: 0;
  margin: 0;
}
.mo-act-btn::after {
  border: none;
}
.mo-act-t {
  font-size: 22rpx;
}
.mo-act-n {
  font-size: 20rpx;
  color: var(--muted);
}
.mo-act.on .mo-act-n {
  color: var(--brand);
}
.mo-ic {
  font-size: 28rpx;
}
.mo-cmts {
  margin-top: 10rpx;
  padding: 14rpx 16rpx;
  border-radius: 12rpx;
  background: var(--line-2);
}
.mo-cmt-empty {
  padding: 8rpx 0;
  font-size: 22rpx;
  color: var(--muted);
}
.mo-cmt {
  font-size: 22rpx;
  line-height: 1.65;
  color: var(--ink-2);
  word-break: break-all;
}
.mo-cmt + .mo-cmt {
  margin-top: 8rpx;
}
.mo-cmt-a {
  color: var(--ink);
  font-weight: 600;
}
.mo-cmt-input {
  flex: 1;
  min-width: 0;
  height: 56rpx;
  padding: 0;
  background: transparent;
  font-size: 22rpx;
}
.mo-cmt-send {
  flex: none;
  font-size: 22rpx;
  font-weight: 600;
  color: var(--brand);
}

/* ===== 发布资讯：图片 / 视频选择 ===== */
.np-media {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}
.np-m {
  position: relative;
  width: 140rpx;
  height: 140rpx;
  border-radius: 12rpx;
  overflow: hidden;
  background: var(--line-2);
}
.np-m-img {
  width: 100%;
  height: 100%;
}
.np-m-vid {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 100%;
  background: #000;
  color: #fff;
  font-size: 22rpx;
}
.np-m-x {
  position: absolute;
  top: 0;
  right: 0;
  width: 36rpx;
  height: 36rpx;
  line-height: 36rpx;
  border-bottom-left-radius: 10rpx;
  background: rgba(0, 0, 0, .55);
  color: #fff;
  font-size: 20rpx;
  text-align: center;
}
.np-add {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 140rpx;
  height: 140rpx;
  border: 1rpx dashed var(--line);
  border-radius: 12rpx;
  background: #fff;
  color: var(--muted);
  font-size: 22rpx;
}

