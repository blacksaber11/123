@import "../../assets/tool.wxss";

.field-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 18rpx;
}
.field-cell {
  width: calc(50% - 8rpx);
  box-sizing: border-box;
}
.fc-label {
  display: block;
  font-size: 21rpx;
  color: var(--muted);
  margin-bottom: 8rpx;
}
.fc-tip {
  margin-top: 12rpx;
  font-size: 20rpx;
  line-height: 30rpx;
  color: var(--muted);
}
.res-tip {
  margin-top: 14rpx;
  padding: 14rpx 16rpx;
  border-radius: 10rpx;
  background: rgba(255, 255, 255, .05);
  border-left: 4rpx solid rgba(120, 170, 255, .85);
  color: rgba(255, 255, 255, .7);
  font-size: 21rpx;
  line-height: 32rpx;
}
.res-verdict {
  margin-top: 14rpx;
  padding: 14rpx 16rpx;
  border-radius: 10rpx;
  background: rgba(255, 255, 255, .08);
  border-left: 4rpx solid rgba(102, 205, 155, .9);
  color: rgba(255, 255, 255, .82);
  font-size: 21rpx;
  line-height: 32rpx;
}
