<view class="page bzd">
  <view wx:if="{{loading}}" class="bd-loading">正在加载商机…</view>

  <!-- 发布者删除商品 / 关闭需求：商机不再展示 -->
  <view wx:elif="{{notFound}}" class="empty">
    <view class="ttl">该商机已不可见</view>
    <view class="ds">发布者已删除商品或关闭需求，或者我的库存已不再匹配，这条商机已从商机池移除。</view>
    <view class="acts">
      <button class="btn primary" bindtap="backList">返回商机列表</button>
    </view>
  </view>

  <!-- 商机会员未开通 / 已到期 -->
  <view wx:elif="{{locked}}" class="empty">
    <view class="ttl">商机会员未开通或已到期</view>
    <view class="ds">开通后可查看商机条件并领取联系方式。</view>
    <view class="acts">
      <button class="btn primary" bindtap="backList">返回商机页开通</button>
    </view>
  </view>

  <block wx:else>
    <!-- 发布时上传的图片 / 视频：与普通发布详情一致，正常展示 -->
    <view wx:if="{{mediaSlides.length}}" class="bd-media">
      <swiper class="bm-swiper" circular bindchange="onMediaSwipe">
        <swiper-item wx:for="{{mediaSlides}}" wx:key="k">
          <image wx:if="{{item.kind === 'image'}}" class="bm-img" src="{{item.url}}" mode="aspectFill"
                 data-index="{{index}}" bindtap="previewMedia" />
          <view wx:else class="bm-video" data-index="{{index}}" bindtap="previewMedia">
            <image wx:if="{{item.poster}}" class="bm-cover" src="{{item.poster}}" mode="aspectFill" />
            <view class="bm-play">▶</view>
          </view>
        </swiper-item>
      </swiper>
      <view class="bm-count">{{mediaIndex + 1}} / {{mediaSlides.length}}{{mediaSummary ? ' · ' + mediaSummary : ''}}</view>
    </view>

    <!-- 商机概要 -->
    <view class="bd-card">
      <view class="bd-top">
        <text class="bd-kind {{opp.type === 'supply' ? 'sell' : (opp.kind === '代采' ? 'buy' : (opp.kind === '代售' ? 'sell' : 'demand'))}}">{{opp.kind}}</text>
        <text class="bd-tag">商机</text>
        <text wx:if="{{opp.closed}}" class="bd-mode">{{opp.statusText || '已结束'}}</text>
        <text wx:elif="{{claimed}}" class="bd-mode ok">已领取</text>
        <text wx:elif="{{unsatisfied}}" class="bd-mode warn">已标记不满足</text>
      </view>
      <view class="bd-model">{{opp.model}}</view>
      <view class="bd-price">
        <text class="bd-p">{{opp.priceText}}</text>
        <text class="bd-unit">× {{opp.qty}}{{opp.unit}}</text>
      </view>
      <view class="bd-chips">
        <text wx:if="{{opp.cat}}" class="chip">{{opp.cat}}</text>
        <text wx:if="{{opp.city}}" class="chip">{{opp.city}}</text>
      </view>
      <!-- 匹配依据：命中的型号 + 基于库存 / 我发布的哪条内容，只在一处展示，避免与库存行重复 -->
      <view wx:if="{{opp.matchModel || opp.matchText}}" class="bd-match">
        <text class="bm-t">匹配依据</text>
        <text wx:if="{{opp.matchModel}}" class="bm-model">{{opp.matchModel}}</text>
        <text wx:if="{{opp.matchText}}" class="bm-via">{{opp.matchText}}</text>
      </view>
      <view wx:if="{{opp.stockText && !opp.matchText}}" class="bd-line">{{opp.type === 'supply' ? '货源' : '我的库存'}}：{{opp.stockText}}</view>
      <view wx:if="{{opp.demandText}}" class="bd-line">{{opp.demandText}}</view>
      <view class="bd-meta">{{opp.org}} · {{opp.published}}{{opp.closed ? ' · 已结束，仅供回看' : (opp.expireText ? ' · ' + opp.expireText : '')}}</view>
    </view>

    <!-- 发布者设定的全部信息：领取前完整展示发布内容，而不是只看必须条件 -->
    <view wx:if="{{opp.info.length || opp.nego.length || opp.flow.length}}" class="bd-card">
      <view class="bd-hd">
        <text class="bd-tt">发布者设定的全部信息</text>
        <text class="bd-sd">发布时填写</text>
      </view>
      <view wx:if="{{opp.info.length}}" class="info-list">
        <view wx:for="{{opp.info}}" wx:key="k" class="il-row">
          <text class="il-k">{{item.k}}</text>
          <text class="il-v">{{item.v}}</text>
        </view>
      </view>
      <view wx:if="{{opp.nego.length}}" class="info-sec">
        <view class="is-t">{{opp.platformOnly ? '可协商条件' : '可协商项'}}（{{opp.nego.length}} 项）</view>
        <view class="is-chips">
          <text wx:for="{{opp.nego}}" wx:key="*this" class="chip">{{item}}</text>
        </view>
      </view>
      <view wx:if="{{opp.flow.length}}" class="info-sec">
        <view class="is-t">{{opp.platformOnly ? '交易流程' : '交付 / 交易流程'}}</view>
        <view wx:for="{{opp.flow}}" wx:key="*this" class="is-step">
          <text class="is-n">{{index + 1}}</text>
          <text class="is-v">{{item}}</text>
        </view>
      </view>
    </view>

    <!-- 必须条件：代采 / 代售同样先逐项确认交易流程条件，全部满足才能领取 -->
    <view class="bd-card">
      <view class="bd-hd">
        <text class="bd-tt">{{opp.platformOnly ? '交易流程条件' : '发布者的必须条件'}}</text>
        <text class="bd-sd">已确认满足 {{condMet}} / {{condTotal}} 项</text>
      </view>
      <view class="callout {{condPass ? 'brand' : 'warn'}}">
        <block wx:if="{{claimed}}">已领取，必须条件已逐项确认，可回看核对。</block>
        <block wx:elif="{{condTotal === 0}}">发布者未设置额外必须条件，确认商机信息后可直接领取，也可以「填写完整需求」再与发布者沟通。</block>
        <block wx:elif="{{condPass}}">全部必须条件已确认满足，可以领取商机{{opp.platformOnly ? '，领取后再由平台对接' : '并查看联系方式'}}，也可以直接「填写完整需求」再与发布者沟通。</block>
        <block wx:else>请逐项对照实际情况选择「满足 / 不满足」。还有 {{condUnmet}} 项未满足，全部满足后才能领取。</block>
      </view>
      <view wx:if="{{condTotal}}" class="cond-list">
        <view wx:for="{{mustList}}" wx:key="t" class="ci">
          <text class="ci-ico {{item.state === 'yes' ? 'ok' : ''}}{{item.state === 'no' ? 'bad' : ''}}">{{item.state === 'yes' ? '✓' : (item.state === 'no' ? '✕' : '○')}}</text>
          <view class="ci-body">
            <view class="ci-name">{{item.t}}</view>
            <view wx:if="{{item.state === 'no'}}" class="ci-desc bad">不满足该项，无法领取；可标记不满足，商机仍保留在「不满足」分类里</view>
            <view wx:elif="{{item.state === 'yes'}}" class="ci-desc ok">已确认满足</view>
            <view wx:else class="ci-desc">待确认</view>
          </view>
          <view class="ci-confirm">
            <view class="cc-btn {{item.state === 'yes' ? 'on' : ''}}" data-i="{{index}}" data-val="yes" bindtap="setCond">满足</view>
            <view class="cc-btn {{item.state === 'no' ? 'on bad' : ''}}" data-i="{{index}}" data-val="no" bindtap="setCond">不满足</view>
          </view>
        </view>
      </view>
    </view>

    <!-- 已领取（需求 / 货源）：主体与联系方式 -->
    <view wx:if="{{claimed && !opp.platformOnly}}" class="bd-card">
      <view class="bd-hd">
        <text class="bd-tt">联系方式</text>
        <text class="bd-sd">领取后可见</text>
      </view>
      <view class="bd-contact">
        <view class="bc-l">
          <text class="bc-name">{{opp.org || '商机发布者'}}</text>
          <text class="bc-person">{{opp.contact || '对方未留联系人'}}</text>
          <text wx:if="{{opp.phone}}" class="bc-phone">{{opp.phone}}</text>
          <text wx:else class="bc-phone empty">对方未留电话，请用站内对话</text>
        </view>
        <button wx:if="{{opp.phone}}" class="btn sm" data-phone="{{opp.phone}}" bindtap="copyPhone">复制电话</button>
      </view>
    </view>

    <!-- 代采 / 代售：领取后由平台居中对接，不展示委托方联系方式 -->
    <view wx:if="{{opp.platformOnly && claimed}}" class="bd-card">
      <view class="bd-hd">
        <text class="bd-tt">平台代为对接</text>
        <text class="bd-sd">不展示委托方联系方式</text>
      </view>
      <view class="bd-ds">已领取该委托。点击下方「联系平台」提交对接申请，客服会联系你确认交易细节，并推送采购方或货源。</view>
    </view>
  </block>

  <!-- 底部操作栏：上方一行状态，下方等宽按钮 -->
  <view wx:if="{{!loading && !notFound && !locked && opp}}" class="bd-bar">
    <block wx:if="{{opp.platformOnly && claimed}}">
      <view class="bb-head">
        <text class="bb-status ok">已领取 · 平台对接</text>
        <text class="bb-tip">提交对接申请后由客服居中联系</text>
      </view>
      <view class="bb-row">
        <button class="btn primary bb-btn" bindtap="consult"
                loading="{{consulting}}" disabled="{{consulted || consulting}}">{{consulted ? '已提交' : '联系平台'}}</button>
      </view>
    </block>

    <block wx:elif="{{claimed}}">
      <view class="bb-head">
        <text class="bb-status ok">已领取</text>
        <text class="bb-tip">联系方式已解锁，可直接沟通</text>
      </view>
      <view class="bb-row">
        <button wx:if="{{opp.phone}}" class="btn bb-btn" data-phone="{{opp.phone}}" bindtap="copyPhone">复制电话</button>
        <text wx:else class="bb-note">对方未留电话</text>
        <button class="btn primary bb-btn" bindtap="openChat">站内对话</button>
      </view>
    </block>

    <block wx:else>
      <view class="bb-head">
        <text class="bb-status {{condPass ? 'ok' : 'bad'}}">{{condPass ? '条件已满足' : '不满足 · ' + condUnmet + ' 项'}}</text>
        <text class="bb-tip">{{unsatisfied ? '已标记不满足，商机保留在「不满足」里' : (condPass ? (opp.platformOnly ? '条件已满足，领取后由平台对接' : '可领取查看联系人，也可填写完整需求') : (opp.platformOnly ? '全部满足交易流程条件后才能领取' : '全部满足后才能领取'))}}</text>
      </view>
      <view class="bb-row">
        <button wx:if="{{condPass && !opp.platformOnly && !unsatisfied}}" class="btn bb-btn" bindtap="moreInfo">填写完整需求</button>
        <button wx:elif="{{unsatisfied}}" class="btn bb-btn" bindtap="unmark">取消标记</button>
        <button wx:else class="btn bb-btn" bindtap="markUnsatisfied">标记不满足</button>
        <button class="btn primary bb-btn" bindtap="claim"
                loading="{{claiming}}" disabled="{{claiming || !condPass}}">领取商机</button>
      </view>
    </block>
  </view>
</view>
