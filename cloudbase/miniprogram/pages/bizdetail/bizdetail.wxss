/* 商机详情：概要 + 必须条件逐项确认 + 底部领取 / 对话 */
.bzd {
  padding: 24rpx 24rpx 250rpx;
}

.bd-loading {
  padding: 120rpx 0;
  text-align: center;
  font-size: 24rpx;
  color: var(--muted);
}

.bd-card {
  background: #fff;
  border: 1rpx solid var(--line);
  border-radius: var(--radius);
  padding: 28rpx 24rpx;
  margin-bottom: 18rpx;
  box-shadow: var(--shadow);
}

.bd-top {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 10rpx;
}

.bd-kind {
  flex: none;
  white-space: nowrap;
  font-size: 21rpx;
  line-height: 40rpx;
  padding: 0 14rpx;
  border-radius: 10rpx;
  background: var(--brand-soft);
  color: var(--brand);
  font-weight: 600;
}
.bd-kind.sell {
  background: var(--info-soft);
  color: var(--info);
}
.bd-kind.demand {
  background: var(--warn-soft);
  color: var(--warn);
}

.bd-mode {
  font-size: 21rpx;
  line-height: 36rpx;
  padding: 0 12rpx;
  border-radius: 8rpx;
  border: 1rpx solid var(--line);
  color: var(--muted);
}
.bd-mode.ok {
  color: var(--brand);
  border-color: var(--brand-line);
  background: var(--brand-soft);
}
.bd-mode.warn {
  color: var(--warn);
  border-color: var(--warn-line);
  background: var(--warn-soft);
}

.bd-model {
  margin-top: 16rpx;
  font-size: 34rpx;
  font-weight: 600;
  line-height: 1.4;
  color: var(--ink);
}

.bd-price {
  display: flex;
  flex-wrap: wrap;
  align-items: baseline;
  gap: 10rpx;
  margin-top: 12rpx;
}
.bd-p {
  font-size: 38rpx;
  font-weight: 700;
  color: var(--ink);
}
.bd-unit {
  font-size: 23rpx;
  color: var(--muted);
}

.bd-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 16rpx;
}

.bd-line {
  margin-top: 14rpx;
  font-size: 23rpx;
  line-height: 1.6;
  color: var(--ink-2);
}

/* 匹配依据：型号 + 基于库存 / 我发布的内容 */
.bd-match {
  margin-top: 16rpx;
  padding: 16rpx 18rpx;
  border-radius: 14rpx;
  background: var(--brand-soft);
  display: flex;
  flex-wrap: wrap;
  align-items: baseline;
  gap: 8rpx 12rpx;
}
.bm-t {
  font-size: 21rpx;
  color: var(--muted);
}
.bm-model {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--brand);
}
.bm-via {
  width: 100%;
  font-size: 22rpx;
  line-height: 1.6;
  color: var(--ink-2);
}

.bd-meta {
  margin-top: 16rpx;
  font-size: 21rpx;
  color: var(--muted);
}

.bd-hd {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 12rpx;
  margin-bottom: 18rpx;
}
.bd-tt {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--ink);
}
.bd-sd {
  flex: none;
  white-space: nowrap;
  font-size: 21rpx;
  color: var(--muted);
}
.bd-ds {
  font-size: 24rpx;
  line-height: 1.7;
  color: var(--ink-2);
}

/* 必须条件逐项确认 */
.cond-list {
  margin-top: 20rpx;
}
.ci {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
  padding: 20rpx 0;
  border-top: 1rpx solid var(--line-2);
}
.ci-ico {
  flex: none;
  width: 34rpx;
  font-size: 24rpx;
  line-height: 40rpx;
  text-align: center;
  color: var(--muted);
}
.ci-ico.ok {
  color: var(--brand);
}
.ci-ico.bad {
  color: var(--danger);
}
.ci-body {
  flex: 1;
  min-width: 0;
}
.ci-name {
  font-size: 26rpx;
  line-height: 1.5;
  color: var(--ink);
}
.ci-desc {
  margin-top: 6rpx;
  font-size: 21rpx;
  line-height: 1.55;
  color: var(--muted);
}
.ci-desc.ok {
  color: var(--brand);
}
.ci-desc.bad {
  color: var(--danger);
}
.ci-confirm {
  flex: none;
  display: flex;
  gap: 8rpx;
}
.cc-btn {
  flex: none;
  white-space: nowrap;
  min-width: 88rpx;
  padding: 0 14rpx;
  height: 52rpx;
  line-height: 50rpx;
  text-align: center;
  font-size: 22rpx;
  color: var(--muted);
  border: 1rpx solid var(--line);
  border-radius: 10rpx;
  background: #fff;
}
.cc-btn.on {
  color: var(--brand);
  border-color: var(--brand);
  background: var(--brand-soft);
  font-weight: 600;
}
.cc-btn.on.bad {
  color: var(--danger);
  border-color: var(--danger);
  background: var(--danger-soft);
}

/* 已领取联系方式 */
.bd-contact {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx;
  border-radius: var(--radius-sm);
  background: var(--paper);
}
.bc-l {
  flex: 1;
  min-width: 0;
}
.bc-name {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--ink);
}
.bc-person {
  display: block;
  margin-top: 6rpx;
  font-size: 24rpx;
  color: var(--ink-2);
}
.bc-phone {
  display: block;
  margin-top: 6rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--brand);
  letter-spacing: 1rpx;
}
/* 对方未留电话：一行小字提示，尺寸与「站内对话」按钮的文字一致 */
.bc-phone.empty {
  font-size: 20rpx;
  font-weight: 400;
  color: var(--muted);
}

/* 底部操作栏：状态一行 + 等宽按钮一行 */
.bd-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 20;
  padding: 16rpx 24rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  background: #fff;
  border-top: 1rpx solid var(--line);
  box-shadow: 0 -8rpx 24rpx rgba(16, 24, 40, .05);
}
.bb-head {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
  margin-bottom: 14rpx;
  min-width: 0;
}
.bb-status {
  flex: none;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--ink);
}
.bb-status.ok {
  color: var(--brand);
}
.bb-status.bad {
  color: var(--danger);
}
.bb-tip {
  flex: 1;
  min-width: 0;
  font-size: 20rpx;
  line-height: 1.5;
  color: var(--muted);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.bb-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
/* 对方没留电话：左侧仅提示文字，右侧按钮与有电话时等宽，不再一个按钮撑满整行 */
.bb-note {
  flex: 1;
  min-width: 0;
  font-size: 22rpx;
  color: var(--muted);
}
.bb-btn {
  flex: 1;
  min-width: 0;
  white-space: nowrap;
}

/* 发布者设定的全部信息：键值行 + 可协商项 + 交易流程 */
.info-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}
.il-row {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  font-size: 24rpx;
  line-height: 1.6;
}
.il-k {
  flex: none;
  width: 150rpx;
  color: var(--muted);
}
.il-v {
  flex: 1;
  min-width: 0;
  color: var(--ink);
  word-break: break-all;
}
.info-sec {
  margin-top: 20rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid var(--line-2);
}
.is-t {
  margin-bottom: 12rpx;
  font-size: 22rpx;
  color: var(--muted);
}
.is-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}
.is-step {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  padding: 8rpx 0;
}
.is-n {
  flex: none;
  width: 34rpx;
  height: 34rpx;
  line-height: 34rpx;
  border-radius: 50%;
  text-align: center;
  font-size: 20rpx;
  color: var(--brand);
  background: var(--brand-soft);
}
.is-v {
  flex: 1;
  min-width: 0;
  font-size: 24rpx;
  line-height: 1.6;
  color: var(--ink-2);
}

/* 商机标签：与普通发布内容同一份展示，只额外标识它来自商机池 */
.bd-tag {
  flex: none;
  white-space: nowrap;
  font-size: 20rpx;
  line-height: 34rpx;
  padding: 0 12rpx;
  border-radius: 8rpx;
  border: 1rpx solid var(--brand);
  color: var(--brand);
}

/* 发布时上传的图片 / 视频：与普通发布详情一致 */
.bd-media {
  position: relative;
  margin-bottom: 20rpx;
  border-radius: 20rpx;
  overflow: hidden;
  background: var(--fill-2, #f2f4f7);
}
.bm-swiper {
  width: 100%;
  height: 420rpx;
}
.bm-img,
.bm-cover {
  width: 100%;
  height: 100%;
  display: block;
}
.bm-video {
  position: relative;
  width: 100%;
  height: 100%;
  background: #000;
}
.bm-play {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 88rpx;
  height: 88rpx;
  margin: -44rpx 0 0 -44rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.45);
  color: #fff;
  font-size: 30rpx;
  line-height: 88rpx;
  text-align: center;
}
.bm-count {
  position: absolute;
  right: 16rpx;
  bottom: 16rpx;
  max-width: 80%;
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
  background: rgba(0, 0, 0, 0.45);
  color: #fff;
  font-size: 20rpx;
  line-height: 1.6;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
