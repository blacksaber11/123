<view class="msg-page">

  <!-- 自定义导航：占满状态栏高度，标题居左，右侧给胶囊预留安全距离 -->
  <view class="msg-nav" style="padding-top: {{statusBarH}}px">
    <view class="nav-bar" style="height: {{navH}}px">
      <view class="nav-title"><text class="nav-title-name">消息</text></view>
    </view>
  </view>

  <!-- Tab 切换 -->
    <view class="tabs">
      <view class="tab {{tab === 'chat' ? 'on' : ''}}" data-tab="chat" bindtap="switchTab">
        对话
        <view class="badge" wx:if="{{chatUnread > 0}}">{{chatUnread > 99 ? '99+' : chatUnread}}</view>
      </view>
      <view class="tab {{tab === 'notice' ? 'on' : ''}}" data-tab="notice" bindtap="switchTab">
        通知
        <view class="badge" wx:if="{{noticeUnread > 0}}">{{noticeUnread > 99 ? '99+' : noticeUnread}}</view>
      </view>
      <view class="tab-ink" style="left: {{tab === 'chat' ? '25%' : '75%'}}"></view>
    </view>

    <!-- 微信消息提醒：未授权或额度用完时显示，一次授权只能推一条 -->
    <view wx:if="{{!notifyOn || notifyRemain === 0}}" class="notify-tip" bindtap="enableNotify">
      <image class="nt-ico" src="/assets/icons/tip-bell.png" mode="aspectFit" />
      <view class="nt-body">
        <view class="nt-title">{{notifyRemain === 0 ? '微信提醒已用完' : '开启微信消息提醒'}}</view>
        <view class="nt-sub">{{notifyRemain === 0 ? '微信一次性订阅每条授权只能提醒一次，点这里续订' : '收到私信、系统通知或有新的匹配商机时，第一时间在微信收到通知'}}</view>
      </view>
      <text class="nt-go">{{notifyRemain === 0 ? '续订 ›' : '开启 ›'}}</text>
    </view>

    <!-- 通知列表 -->
    <view wx:if="{{tab === 'notice'}}" class="msg-list">
      <block wx:for="{{notices}}" wx:key="id">
        <view class="msg-item" bindtap="openMsg" data-id="{{item.id}}">
          <view class="msg-ico {{item.kind === 'inquiry' ? 'inq' : 'sys'}}"><image class="mi-img" src="/assets/icons/{{item.kind === 'inquiry' ? 'menu-inq' : 'ic-mega'}}.png" mode="aspectFit" /></view>
          <view class="msg-body">
            <view class="msg-head">
              <text class="msg-title">{{item.title}}</text>
              <text class="msg-time">{{item.time}}</text>
            </view>
            <view class="msg-content">{{item.content}}</view>
            <view wx:if="{{item.reason}}" class="msg-reason">系统提示 · {{item.reason}}</view>
          </view>
          <view wx:if="{{item.unread}}" class="msg-dot"></view>
          <text wx:if="{{item.kind === 'inquiry'}}" class="msg-arrow">{{expanded === item.id ? '⌃' : '⌄'}}</text>
        </view>

        <!-- 响应明细：只展示条件满足度与报价 -->
        <view wx:if="{{item.kind === 'inquiry' && expanded === item.id}}" class="inq-panel">
          <view class="inq-tip">
            仅展示咨询人满足的必须条件、报价与数量；联系方式不在询价中下发，不公开主体只能在站内会话沟通。
          </view>

          <view wx:for="{{item.responses}}" wx:key="id" wx:for-item="r" class="inq-card">
            <view class="ic-top">
              <text class="ic-name">{{r.masked}}</text>
              <text class="ic-met {{r.allMet ? 'ok' : 'warn'}}">满足 {{r.metCount}}/{{r.total}} 项</text>
            </view>
            <view class="ic-quote">
              匹配度 {{r.matchPct}}%<text class="ic-sub"> · {{r.status}}{{r.atText ? ' · ' + r.atText : ''}}</text>
            </view>
            <view class="ic-conds">
              <view wx:for="{{r.conds}}" wx:key="n" wx:for-item="c" class="ic-cond {{c.ok ? 'ok' : 'no'}}">
                <text class="ic-ico">{{c.ok ? '✓' : '✗'}}</text>
                <text class="ic-cn">{{c.n}}</text>
              </view>
            </view>
            <view class="ic-foot">
              <text class="ic-note">{{r.note}}</text>
            </view>
          </view>

          <view wx:if="{{item.responses.length === 0}}" class="inq-empty">还没有供给方响应</view>

          <!-- 需求卡：跳转对应需求详情 -->
          <view class="demand-card" bindtap="openDemand" data-id="{{item.demandId}}">
            <view class="dc-ico"><image class="dc-img" src="/assets/icons/menu-agency.png" mode="aspectFit" /></view>
            <view class="dc-body">
              <view class="dc-title">{{item.demandTitle}}</view>
              <view class="dc-meta">{{item.demandMeta}}</view>
            </view>
            <text class="dc-go">›</text>
          </view>
        </view>
      </block>

      <view wx:if="{{notices.length === 0}}" class="empty">
        <image class="big-img" src="/assets/icons/empty-bell.png" mode="aspectFit" />
        <view class="ttl">暂无通知</view>
        <view class="ds">审核结果、下架原因会在这里通知你</view>
      </view>
    </view>

    <!-- 客服消息列表 -->
    <view wx:if="{{tab === 'chat'}}" class="msg-list">
      <view wx:for="{{chats}}" wx:key="id" class="msg-item" bindtap="openChatEntry" data-id="{{item.id}}">
        <view class="msg-avatar {{item.official ? 'official' : ''}}">{{item.avatar}}</view>
        <view class="msg-body">
          <view class="msg-head">
            <view class="msg-name">
              <text class="msg-title">{{item.name}}</text>
              <text wx:if="{{item.memberLabel}}" class="msg-member">{{item.memberLabel}}</text>
            </view>
            <text class="msg-time">{{item.time}}</text>
          </view>
          <view class="msg-content">{{item.content}}</view>
        </view>
        <view wx:if="{{item.unread > 0}}" class="msg-badge">{{item.unread}}</view>
        <text wx:if="{{item.official || item.direct}}" class="msg-arrow">›</text>
      </view>

      <view wx:if="{{chats.length === 0}}" class="empty">
        <image class="big-img" src="/assets/icons/empty-mail.png" mode="aspectFit" />
        <view class="ttl">暂无消息</view>
        <view class="ds">与货主 / 需求方的对话、客服回复会出现在这里</view>
      </view>
    </view>
</view>
