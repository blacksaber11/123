<view class="mine-page {{view === 'menu' && mode !== 'sub' ? '' : 'is-view'}}">
  <!-- 分类列表：个人卡 + 四宫格 + 菜单；进入二级页后整体让位给全屏内容 -->
  <block wx:if="{{view === 'menu' && mode !== 'sub'}}">
  <!-- 用户信息卡：头像 / 昵称 / 手机号与位置均由微信授权自动带入 -->
  <view class="me-card" bindtap="goProfile">
    <image wx:if="{{user.avatar}}" class="me-av-img" src="{{user.avatar}}" mode="aspectFill" />
    <view wx:else class="av">{{user.avatarText || '算'}}</view>
    <view class="mi">
      <view class="nm">{{user.nick || '微信用户'}}<text class="mi-go">›</text></view>
      <view class="sb">{{user.city}} · {{user.joined}} 加入</view>
      <view class="ma-line">
        <text wx:if="{{user.userNo}}" class="ma-pill on" catchtap="copyUserNo"><text>🆔</text>ID {{user.userNo}}</text>
        <text class="ma-pill {{user.login ? 'on' : ''}}"><text>☁</text>微信已授权</text>
        <text class="ma-pill {{user.phoneOn ? 'on' : ''}}"><text>📱</text>{{user.phoneText}}</text>
        <text class="ma-pill {{user.geo ? 'on' : ''}}"><text>📍</text>{{user.geo ? user.city : '位置未授权'}}</text>
      </view>
    </view>
  </view>

  <!-- 商机会员引导：只占一行，未开通时展示，开通后自动收起 -->
  <view wx:if="{{bizLocked}}" class="biz-guide" bindtap="goBiz">
    <text class="bg-ico">⚡</text>
    <view class="bg-body">
      <view class="bg-t">开通商机会员</view>
      <view class="bg-d">按库存自动匹配商机，解锁领取与对接</view>
    </view>
    <text class="bg-go">去开通 ›</text>
  </view>

  <!-- 顶部四宫格：浏览 / 收藏 / 关注 / 我发布的，最常用的四个入口 -->
  <view class="me-quick">
    <view wx:for="{{quick}}" wx:key="k" class="mq-item" data-k="{{item.k}}" bindtap="openView">
      <view class="mq-ico">
        <image class="mq-img" src="/assets/icons/{{item.icon}}.png" mode="aspectFit" />
        <text wx:if="{{item.cnt}}" class="mq-c {{item.k === 'pub' ? 'unread' : ''}}">{{item.cnt > 99 ? '99+' : item.cnt}}</text>
      </view>
      <text class="mq-n">{{item.n}}</text>
    </view>
  </view>

  <!-- 分类菜单：竖排，点进去再看该分类的详情 -->
  <view class="me-menu">
    <view wx:for="{{menu}}" wx:key="k" class="mm-row" data-k="{{item.k}}" bindtap="openView">
      <image class="mm-ico" src="/assets/icons/{{item.icon}}.png" mode="aspectFit" />
      <view class="mm-txt">
        <view class="mm-n">{{item.n}}</view>
        <view class="mm-d">{{item.d}}</view>
      </view>
      <text wx:if="{{item.cnt !== ''}}" class="mm-cnt">{{item.cnt}}</text>
      <text class="mm-go">›</text>
    </view>
  </view>
  </block>

  <view wx:else class="me-view">
    <!-- 二级页全屏：吸顶返回 + 标题；独立二级页由系统导航栏提供返回，不再重复 -->
    <view wx:if="{{mode !== 'sub'}}" class="mine-view-hd">
      <view class="mv-back" bindtap="goMenu">‹</view>
      <view class="mv-tt">{{viewTitle}}</view>
    </view>

    <!-- 我发布的：先选商品 / 求购需求 / 资讯，再看列表 -->
    <block wx:if="{{view === 'pub'}}">
      <view class="segs mine-sub">
        <view class="seg {{subTab === 'product' ? 'on' : ''}}" data-sub="product" bindtap="switchSub">
          商品<text class="seg-em">{{myProducts.length}}</text>
        </view>
        <view class="seg {{subTab === 'demand' ? 'on' : ''}}" data-sub="demand" bindtap="switchSub">
          求购需求<text class="seg-em">{{myDemands.length}}</text>
        </view>
        <view class="seg {{subTab === 'news' ? 'on' : ''}}" data-sub="news" bindtap="switchSub">
          资讯<text class="seg-em">{{myNews.length}}</text>
        </view>
        <view class="seg {{subTab === 'comment' ? 'on' : ''}}" data-sub="comment" bindtap="switchSub">
          我的评论<text wx:if="{{commentUnread}}" class="seg-badge">{{commentUnread > 99 ? '99+' : commentUnread}}</text>
        </view>
      </view>
      <!-- 我的评论：我发出的评论 + 收到的回复；收到的回复未读时显示红色数字 -->
      <block wx:if="{{subTab === 'comment'}}">
        <view class="callout tip-callout">
          这里汇总你发出的评论和收到的回复。资讯被删除或下架后，原资讯标题会显示「资讯已失效」，不影响你查看历史评论。
        </view>
        <view wx:if="{{commentList.length}}" class="mine-list">
          <view wx:for="{{commentList}}" wx:key="id" class="mine-row cmt-row">
            <view class="mr-top">
              <text class="pill-tag {{item.newsValid ? '' : 'off'}}">{{item.newsValid ? '我的评论' : '资讯已失效'}}</text>
              <text class="mr-time">{{item.createdText}}</text>
              <text wx:if="{{item.unread}}" class="seg-badge cmt-badge">{{item.unread}}</text>
            </view>
            <view class="mr-title cmt-content">{{item.content}}</view>
            <view class="mr-meta cmt-news" data-id="{{item.newsId}}" bindtap="openFavNews">
              原资讯：{{item.newsTitle}}
            </view>
            <view wx:if="{{item.replyCount}}" class="cmt-replies">
              <view wx:for="{{item.replies}}" wx:for-item="rep" wx:key="id" class="cmt-reply">
                <view class="cmt-reply-top">
                  <text class="cmt-reply-nm">{{rep.author}}</text>
                  <text class="mr-time">{{rep.createdText}}</text>
                  <text wx:if="{{rep.unread}}" class="cmt-dot"></text>
                </view>
                <view class="cmt-reply-tx">{{rep.content}}</view>
              </view>
            </view>
          </view>
        </view>
        <view wx:else class="empty">
          <image class="big-img" src="/assets/icons/empty-doc.png" mode="aspectFit" />
          <view class="ttl">还没有评论</view>
          <view class="ds">在资讯详情页发表评论后，会在这里集中展示；有人回复你时，这里会显示红色数字提醒。</view>
        </view>
      </block>
      <block wx:else>
      <view class="callout tip-callout">
        商品、求购需求与资讯统一在这里管理：编辑、上下架、关闭、重新开启与删除。自己的发布不会出现在首页信息流，也无法咨询自己。草稿与被退回的内容可在这里重新发布上架。
      </view>
      <view wx:if="{{pubList.length}}" class="mine-list">
        <view wx:for="{{pubList}}" wx:key="id" class="mine-row">
          <view class="mr-top">
            <text class="st {{item.statusCls || 'ok'}}">{{item.status}}</text>
            <text wx:if="{{item.isPrivate}}" class="mr-vis">匿名</text>
            <text class="mr-time">{{item.published}} · 浏览 {{item.views}}</text>
          </view>
          <view class="mr-title">{{item.title}}</view>
          <view wx:if="{{item.kind !== 'news'}}" class="mr-meta">{{item.cat}} · {{item.brand}} · {{item.city}}</view>
          <view wx:if="{{item.kind === 'news'}}" class="mr-meta">{{item.summary}}{{item.city ? ' · ' + item.city : ''}}</view>
          <view wx:if="{{subTab === 'product'}}" class="mr-meta"><text class="mr-price">{{item.priceText}}</text>{{item.priceMode === 'nego' ? '' : ' / 台'}} · {{item.qty}} 台 · {{item.cond}}</view>
          <view wx:elif="{{subTab === 'demand'}}" class="mr-meta"><text class="mr-price">{{item.budgetText}}</text>{{item.budgetMode === 'nego' ? '' : ' 以内'}} · {{item.qty}} 台 · {{item.cond}}</view>
          <view wx:if="{{item.reasonText}}" class="mr-reason">{{item.reasonText}}</view>
          <view wx:if="{{item.platformOffline || item.platformClosed}}" class="mr-reason">该内容由平台处置，如需恢复请联系客服。</view>
          <view class="mr-acts">
            <button wx:if="{{item.kind !== 'news'}}" class="btn sm" data-id="{{item.id}}" data-type="{{subTab}}" bindtap="viewProduct">查看详情</button>
            <button wx:if="{{item.kind !== 'news'}}" class="btn sm" open-type="share" data-id="{{item.id}}" data-kind="{{item.kind}}">分享</button>
            <button wx:if="{{item.canEdit}}" class="btn sm" data-id="{{item.id}}" data-kind="{{item.kind}}" bindtap="editProduct">编辑</button>
            <button wx:if="{{item.canSubmit}}" class="btn sm primary" data-id="{{item.id}}" data-kind="{{item.kind}}" bindtap="submitPub">发布上架</button>
            <button wx:if="{{item.canOffline}}" class="btn sm" data-id="{{item.id}}" data-act="offline" bindtap="endPublish">下架</button>
            <button wx:if="{{item.canOnline}}" class="btn sm" data-id="{{item.id}}" data-act="online" bindtap="endPublish">重新上架</button>
            <button wx:if="{{item.canClose}}" class="btn sm" data-id="{{item.id}}" data-act="close" bindtap="endPublish">关闭需求</button>
            <button wx:if="{{item.canReopen}}" class="btn sm" data-id="{{item.id}}" data-act="reopen" bindtap="endPublish">重新开启</button>
            <button wx:if="{{item.canDelete}}" class="btn sm danger" data-id="{{item.id}}" data-kind="{{item.kind}}" bindtap="deletePub">删除</button>
          </view>
        </view>
      </view>
      <view wx:else class="empty">
        <image class="big-img" src="/assets/icons/empty-package.png" mode="aspectFit" />
        <view class="ttl">你还没有发布过{{subTab === 'news' ? '资讯' : (subTab === 'product' ? '商品' : '求购需求')}}</view>
        <view class="ds">发布后系统自动完成基础审核并正常展示；命中风险规则的内容会进入风险池等待人工复核，不影响展示。</view>
        <view class="acts">
          <button class="btn sm primary" bindtap="goPublish">
            发布{{subTab === 'news' ? '资讯' : (subTab === 'product' ? '商品' : '需求')}}
          </button>
        </view>
      </view>
      </block>
    </block>

    <!-- 我的委托：列表只展示商品信息与截止时间，点击后看详情与流程 -->
    <block wx:elif="{{view === 'agency'}}">
      <view class="callout tip-callout">
        代采 / 代售委托发布、审核、上架都不收费，成交后支付服务费。列表只展示委托商品与截止时间，点击任意一条可查看流程节点、各节点时间与处理人，并完成确认成交、确认收货等操作。
      </view>
      <view wx:if="{{agencyList.length}}" class="mine-list">
        <view wx:for="{{agencyList}}" wx:key="id" class="mine-row" data-id="{{item.id}}" bindtap="openAgencyDetail">
          <view class="mr-top">
            <text class="st {{item.statusCls}}">{{item.statusText}}</text>
            <text wx:if="{{item.deadlineLabel}}" class="mr-time">{{item.deadlineLabel}}</text>
          </view>
          <view class="mr-title">{{item.title}}</view>
          <view class="mr-meta">{{item.meta}}</view>
          <view class="mr-meta"><text class="mr-price">{{item.priceText}}</text></view>
        </view>
      </view>
      <view wx:else class="empty">
        <image class="big-img" src="/assets/icons/empty-doc.png" mode="aspectFit" />
        <view class="ttl">还没有提交过代采 / 代售委托</view>
        <view class="ds">在发布页选择代采或代售，填写截止时间并提交；发布、审核、上架都不收费，成交后支付服务费。</view>
        <view class="acts">
          <button class="btn sm primary" bindtap="goPublish">去发布委托</button>
        </view>
      </view>

      <!-- 委托详情：商品信息、截止时间、服务费状态与流程记录 -->
      <view wx:if="{{agencyDetailOpen}}" class="ag-edit-mask" bindtap="closeAgencyDetail"></view>
      <view wx:if="{{agencyDetailOpen}}" class="ag-edit-sheet" catchtap="noop">
        <view class="ag-edit-hd">
          <text class="ag-edit-tt">{{agencyDetail.title}}</text>
          <text class="ag-edit-x" bindtap="closeAgencyDetail">✕</text>
        </view>
        <view class="ag-edit-row">
          <text class="ag-edit-lb">状态</text>
          <text class="ag-detail-v">{{agencyDetail.statusText}}</text>
        </view>
        <view class="ag-edit-row">
          <text class="ag-edit-lb">委托方式</text>
          <text class="ag-detail-v">{{agencyDetail.meta}}</text>
        </view>
        <view class="ag-edit-row">
          <text class="ag-edit-lb">单价</text>
          <text class="ag-detail-v">{{agencyDetail.priceText}}</text>
        </view>
        <view class="ag-edit-row">
          <text class="ag-edit-lb">截止时间</text>
          <text class="ag-detail-v">{{agencyDetail.deadlineLabel || '未设置'}}</text>
        </view>
        <view class="ag-edit-row">
          <text class="ag-edit-lb">服务费</text>
          <text class="ag-detail-v">{{agencyDetail.serviceFeeText}}</text>
        </view>
        <view wx:if="{{agencyDetail.feeStatusText}}" class="ag-edit-row">
          <text class="ag-edit-lb">服务费状态</text>
          <text class="ag-detail-v">{{agencyDetail.feeStatusText}}</text>
        </view>
        <view wx:if="{{agencyDetail.feeDueAtText}}" class="ag-edit-row">
          <text class="ag-edit-lb">支付截止日</text>
          <text class="ag-detail-v">{{agencyDetail.feeDueAtText}}</text>
        </view>
        <view wx:if="{{agencyDetail.dealAmountText}}" class="ag-edit-row">
          <text class="ag-edit-lb">成交金额</text>
          <text class="ag-detail-v">{{agencyDetail.dealAmountText}}</text>
        </view>
        <view wx:if="{{agencyDetail.completedText}}" class="ag-edit-row">
          <text class="ag-edit-lb">成交时间</text>
          <text class="ag-detail-v">{{agencyDetail.completedText}}</text>
        </view>
        <view wx:if="{{agencyDetail.receiptText}}" class="ag-edit-row">
          <text class="ag-edit-lb">收货确认</text>
          <text class="ag-detail-v">{{agencyDetail.receiptText}}</text>
        </view>
        <view wx:if="{{agencyDetail.paidClaimText}}" class="ag-edit-tip">已于 {{agencyDetail.paidClaimText}} 上报支付，等待财务核对到账。</view>
        <view wx:if="{{agencyDetail.reasonText}}" class="ag-edit-tip">{{agencyDetail.reasonText}}</view>
        <view wx:if="{{agencyDetail.editPending}}" class="ag-edit-tip">修改已提交：委托已临时下架，审核通过后自动更新并重新上架。</view>

        <view class="ag-detail-sec">处理记录</view>
        <view wx:if="{{agencyDetail.flowNodes.length}}" class="ag-prog">
          <view wx:for="{{agencyDetail.flowNodes}}" wx:key="key" class="agp">
            <view class="agp-dot"></view>
            <view class="agp-body">
              <view class="agp-label">{{item.label}}</view>
              <view wx:if="{{item.line}}" class="agp-at">{{item.line}}</view>
            </view>
          </view>
        </view>
        <view wx:else class="ag-edit-tip">暂无处理记录</view>

        <view class="mr-acts">
          <button wx:if="{{agencyDetail.canConfirmDeal}}" class="btn sm primary" data-id="{{agencyDetail.id}}" bindtap="confirmDeal">确认成交</button>
          <button wx:if="{{agencyDetail.canPayFee}}" class="btn sm primary" data-id="{{agencyDetail.id}}" bindtap="reportPaid">我已支付</button>
          <button wx:if="{{agencyDetail.canConfirmReceipt}}" class="btn sm primary" data-id="{{agencyDetail.id}}" bindtap="confirmReceipt">确认收货</button>
          <button wx:if="{{agencyDetail.canResubmit}}" class="btn sm primary" data-id="{{agencyDetail.id}}" data-side="{{agencyDetail.side}}" bindtap="resubmitAgency">重新编辑上传</button>
          <button wx:if="{{agencyDetail.canEdit}}" class="btn sm" data-id="{{agencyDetail.id}}" bindtap="openAgencyEdit">修改委托</button>
          <button wx:if="{{agencyDetail.canCancel}}" class="btn sm" data-id="{{agencyDetail.id}}" bindtap="cancelAgency">撤销委托</button>
          <button wx:if="{{agencyDetail.canDelete}}" class="btn sm danger" data-id="{{agencyDetail.id}}" bindtap="deleteAgency">删除</button>
        </view>
      </view>
    </block>

    <!-- 我的订单：会员开通记录 + 代采 / 代售订单记录，只做历史查询 -->
    <block wx:elif="{{view === 'pay'}}">
      <view class="segs mine-sub">
        <view class="seg {{orderTab === 'member' ? 'on' : ''}}" data-tab="member" bindtap="switchOrderTab">
          会员开通<text class="seg-em">{{payList.length}}</text>
        </view>
        <view class="seg {{orderTab === 'agency' ? 'on' : ''}}" data-tab="agency" bindtap="switchOrderTab">
          代采代售<text class="seg-em">{{agencyList.length}}</text>
        </view>
      </view>

      <block wx:if="{{orderTab === 'member'}}">
        <view class="callout tip-callout">
          这里只展示历史会员开通与收款记录；如需开票或核对金额，请直接联系在线客服。
        </view>
        <view wx:if="{{payList.length}}" class="mine-list">
          <view wx:for="{{payList}}" wx:key="id" class="mine-row">
            <view class="mr-top">
              <text class="st {{item.statusCls}}">{{item.status}}</text>
              <text class="mr-time">{{item.atText}}</text>
            </view>
            <view class="mr-title">{{item.title}}</view>
            <view class="mr-meta"><text class="mr-price">{{item.amountText}}</text><text wx:if="{{item.meta}}"> · {{item.meta}}</text></view>
            <view class="mr-reason">{{item.noteText}}</view>
            <view wx:if="{{item.refundStatus}}" class="mr-reason">
              退款记录：{{item.refundStatus}}{{item.refundNote ? ' · ' + item.refundNote : ''}}
            </view>
          </view>
        </view>
        <view wx:else class="empty">
          <image class="big-img" src="/assets/icons/empty-doc.png" mode="aspectFit" />
          <view class="ttl">还没有会员开通记录</view>
          <view class="ds">会员续费由平台登记收款后显示在这里，可在「设置」中查看当前会员有效期。</view>
        </view>
      </block>

      <block wx:else>
        <view class="callout tip-callout">
          代采 / 代售订单仅作历史记录；审核通过后如需修改，请提交修改申请，审核通过后自动更新。
        </view>
        <view wx:if="{{agencyList.length}}" class="mine-list">
          <view wx:for="{{agencyList}}" wx:key="id" class="mine-row">
            <view class="mr-top">
              <text class="st {{item.statusCls}}">{{item.status}}</text>
              <text wx:if="{{item.editPending}}" class="mr-vis">修改待审核</text>
              <text class="mr-time">{{item.atText}}</text>
            </view>
            <view class="mr-title">{{item.title}}</view>
            <view class="mr-meta">{{item.meta}}</view>
            <view class="mr-meta"><text class="mr-price">{{item.priceText}}</text><text wx:if="{{item.feeText}}"> · {{item.feeText}}</text></view>
            <view wx:if="{{item.reasonText}}" class="mr-reason">{{item.reasonText}}</view>
          </view>
        </view>
        <view wx:else class="empty">
          <image class="big-img" src="/assets/icons/empty-doc.png" mode="aspectFit" />
          <view class="ttl">还没有代采 / 代售订单</view>
          <view class="ds">在发布页选择代采或代售提交委托，审核通过后会在这里留下订单记录。</view>
        </view>
      </block>
    </block>

    <!-- 我的关注：只保留关注的账号；商品统一走收藏 -->
    <block wx:elif="{{view === 'follow'}}">
      <view class="callout tip-callout">
        关注的账号可查看其公开发布的货源；账号注销后条目仍会保留，并标记为「账号已注销」。商品请使用收藏，在「我的收藏」中查看。
      </view>
      <view wx:if="{{followList.length}}" class="mine-list">
        <view wx:for="{{followList}}" wx:key="id" class="mine-row">
          <view class="fl-row">
            <view class="fl-av" data-id="{{item.id}}" bindtap="openSeller">{{item.short}}</view>
            <view class="fl-info" data-id="{{item.id}}" bindtap="openSeller">
              <view class="fl-nm">{{item.nick}}<text wx:if="{{item.valid === false}}" class="fl-off">已注销</text></view>
              <view class="fl-sb">{{item.valid === false ? (item.invalidText || '账号已注销') : (item.city || '城市未填写') + ' · 在售 ' + item.count + ' 条'}}</view>
            </view>
            <button class="btn sm" data-id="{{item.id}}" data-type="account" bindtap="unfollow">取消关注</button>
          </view>
        </view>
      </view>
      <view wx:else class="empty">
        <image class="big-img" src="/assets/icons/empty-users.png" mode="aspectFit" />
        <view class="ttl">还没有关注的货主</view>
        <view class="ds">在商品详情页点货主头像即可关注，关注后能集中查看对方发布的货源。</view>
        <view class="acts">
          <button class="btn sm primary" bindtap="goHome">去首页看看</button>
        </view>
      </view>
    </block>

    <!-- 卖家主页：只看公开发布，联系方式不可见 -->
    <block wx:elif="{{view === 'seller'}}">
      <view class="block seller-card">
        <view class="fl-row">
          <view class="fl-av">{{seller.short}}</view>
          <view class="fl-info">
            <view class="fl-nm">{{seller.nick}}</view>
            <view class="fl-sb">{{seller.city || '城市未填写'}} · 在售 {{seller.count}} 条</view>
          </view>
          <button class="btn sm {{seller.following ? '' : 'primary'}}" bindtap="toggleSellerFollow">
            {{seller.following ? '已关注' : '关注'}}
          </button>
        </view>
        <view class="callout tip-callout seller-note">
          主页仅展示对方公开发布的货源与需求，不展示手机号、联系人与资质材料。
        </view>
      </view>
      <view wx:if="{{sellerList.length}}" class="mine-list">
        <view wx:for="{{sellerList}}" wx:key="id" class="mine-row" data-id="{{item.id}}" data-type="product" bindtap="viewProduct">
          <view class="mr-top">
            <text class="pill-tag {{item.isRent ? 'rent' : ''}}">{{item.tradeMode}}</text>
          </view>
          <view class="mr-title">{{item.title}}</view>
          <view class="mr-meta">{{item.cat}} · {{item.city}} · <text class="mr-price">{{item.priceText}}</text></view>
        </view>
      </view>
      <view wx:else class="empty">
        <image class="big-img" src="/assets/icons/empty-package.png" mode="aspectFit" />
        <view class="ttl">对方暂无在售货源</view>
        <view class="ds">新发布的货源会自动出现在这里。</view>
      </view>
    </block>

    <!-- 浏览记录 -->
    <block wx:elif="{{view === 'history'}}">
      <view class="block-hd">
        <text class="bt">最近浏览</text>
        <text class="r">共 {{views.length}} 条</text>
        <button wx:if="{{views.length}}" class="btn sm qual-btn" bindtap="clearViews">清空</button>
      </view>
      <view class="callout tip-callout">浏览记录只保存在本机，最多保留 50 条，仅你可见。</view>
      <view wx:if="{{views.length}}" class="mine-list">
        <view wx:for="{{views}}" wx:key="key" class="mine-row" data-id="{{item.id}}" data-type="{{item.kind}}" bindtap="viewProduct">
          <view class="mr-top">
            <text class="pill-tag {{item.kind === 'demand' ? 'buy' : ''}}">{{item.kindText}}</text>
            <text class="mr-time">{{item.atText}}</text>
          </view>
          <view class="mr-title">{{item.title}}</view>
          <view class="mr-meta">
            {{item.cat || '未分类'}} · {{item.city || '城市未填写'}}<text wx:if="{{item.priceText}}"> · {{item.priceText}}</text>
          </view>
        </view>
      </view>
      <view wx:else class="empty">
        <image class="big-img" src="/assets/icons/empty-clock.png" mode="aspectFit" />
        <view class="ttl">还没有浏览记录</view>
        <view class="ds">看过的商品与求购需求会自动记在这里，方便回看。</view>
        <view class="acts">
          <button class="btn sm primary" bindtap="goHome">去首页看看</button>
        </view>
      </view>
    </block>

    <!-- 我的收藏 -->
    <block wx:elif="{{view === 'fav'}}">
      <view class="segs mine-sub">
        <view class="seg {{favTab === 'product' ? 'on' : ''}}" data-sub="product" bindtap="switchFav">
          货源<text class="seg-em">{{favProducts.length}}</text>
        </view>
        <view class="seg {{favTab === 'demand' ? 'on' : ''}}" data-sub="demand" bindtap="switchFav">
          求购需求<text class="seg-em">{{favDemands.length}}</text>
        </view>
        <view class="seg {{favTab === 'news' ? 'on' : ''}}" data-sub="news" bindtap="switchFav">
          资讯<text class="seg-em">{{favNews.length}}</text>
        </view>
      </view>
      <view class="callout tip-callout">
        收藏的货源、需求与资讯会保存在本地并同步到账号，仅你可见。收藏不产生咨询，货主不会知道你收藏了。
      </view>
      <view wx:if="{{favList.length}}" class="mine-list">
        <block wx:if="{{favTab === 'news'}}">
          <view wx:for="{{favList}}" wx:key="id" class="mine-row fav-row" data-id="{{item.id}}" bindtap="openFavNews">
            <view class="mr-top">
              <text class="pill-tag {{item.valid === false ? 'off' : 'buy'}}">{{item.valid === false ? '已失效' : '资讯'}}</text>
              <text class="mr-time">{{item.published}}</text>
            </view>
            <view class="mr-title">{{item.title}}</view>
            <view class="mr-meta">{{item.valid === false ? '资讯已失效' : ((item.cat || '资讯') + (item.city ? ' · ' + item.city : '') + (item.author ? ' · ' + item.author : ''))}}</view>
            <view class="mr-acts">
              <button class="btn sm" data-id="{{item.id}}" catchtap="openFavNews">查看详情</button>
              <button class="btn sm" data-id="{{item.id}}" catchtap="unfav">取消收藏</button>
            </view>
          </view>
        </block>
        <block wx:else>
          <view wx:for="{{favList}}" wx:key="id" class="mine-row fav-row">
          <view class="mr-top">
            <text class="pill-tag {{item.isRent ? 'rent' : (favTab === 'product' ? '' : 'buy')}}">{{item.tradeMode}}</text>
            <text class="mr-time">{{item.published}}</text>
          </view>
          <view class="mr-title">{{item.title}}</view>
          <view class="mr-meta">{{item.cat}} · {{item.brand}} · {{item.city}}</view>
          <view wx:if="{{favTab === 'product'}}" class="mr-meta">
            <text class="mr-price">{{item.priceText}}</text>
             / 台 · {{item.qty}} 台 · {{item.cond}}
          </view>
          <view wx:else class="mr-meta">
            <text class="mr-price">{{item.budgetText}}</text>
             以内 · {{item.qty}} 台 · {{item.tax}}
          </view>
          <view class="mr-acts">
            <button class="btn sm" data-id="{{item.id}}" data-type="{{favTab}}" bindtap="viewProduct">查看详情</button>
            <button class="btn sm" data-id="{{item.id}}" bindtap="unfav">取消收藏</button>
          </view>
        </view>
        </block>
      </view>
      <view wx:else class="empty">
        <image class="big-img" src="/assets/icons/empty-star.png" mode="aspectFit" />
        <view class="ttl">{{favTab === 'news' ? '还没有收藏资讯' : '还没有收藏'}}</view>
        <view class="ds">{{favTab === 'news' ? '在资讯详情页点「收藏」，之后能在这里集中回看；资讯被删除或下架后会标记为已失效。' : '在货源或需求列表、详情页点星标即可收藏，方便后续对比与跟进。'}}</view>
        <view class="acts">
          <button class="btn sm primary" bindtap="goHome">去首页看看</button>
        </view>
      </view>
    </block>

    <!-- 帮助与反馈：举报 / 投诉 / 意见反馈 -->
    <block wx:elif="{{view === 'report'}}">
      <view class="callout warn tip-callout">
        举报与投诉由平台客服人工核实，处置结果会在这里和站内信同步；请尽量写清对象与经过，便于快速定位。
      </view>
      <view class="block">
        <view class="block-hd"><text class="bt">提交反馈</text></view>
        <view class="field">
          <text class="f-label">类型</text>
          <view class="chip-group">
            <view wx:for="{{reportTypes}}" wx:key="*this" data-type="{{item}}" bindtap="onReportType"
                  class="chip {{reportType === item ? 'on' : ''}}">{{item}}</view>
          </view>
        </view>
        <view class="field">
          <text class="f-label">涉及对象（选填）</text>
          <input value="{{reportTarget}}" maxlength="60" placeholder="商品 / 需求标题或对方称呼"
                 data-field="reportTarget" bindinput="onReportInput"/>
        </view>
        <view class="field">
          <text class="f-label">问题描述<text class="req">*</text></text>
          <textarea value="{{reportContent}}" maxlength="800" auto-height
                    placeholder="请描述发生了什么、你希望平台怎么处理（至少 5 个字）"
                    data-field="reportContent" bindinput="onReportInput"></textarea>
        </view>
        <view class="field">
          <text class="f-label">联系方式（选填）</text>
          <input value="{{reportContact}}" maxlength="60" placeholder="{{user.phoneOn ? '已使用微信授权手机号，可留空' : '手机号 / 微信号，便于客服回访'}}"
                 data-field="reportContact" bindinput="onReportInput"/>
        </view>
        <button class="btn primary" bindtap="submitReport" disabled="{{reportSending}}">{{reportSending ? '提交中…' : '提交反馈'}}</button>
      </view>
      <view class="block">
        <view class="block-hd"><text class="bt">我的反馈</text><text class="r">{{reportList.length}} 条</text></view>
        <view wx:if="{{reportList.length}}" class="mine-list">
          <view wx:for="{{reportList}}" wx:key="id" class="mine-row">
            <view class="mr-top">
              <text class="st">{{item.type}}</text>
              <text class="st {{item.statusCls}}">{{item.status}}</text>
              <text class="mr-time">{{item.atText}}{{item.handledText ? ' · 处理于 ' + item.handledText : ''}}</text>
            </view>
            <view wx:if="{{item.targetTitle}}" class="mr-meta">对象：{{item.targetTitle}}</view>
            <view class="mr-title">{{item.content}}</view>
            <view wx:if="{{item.reply}}" class="mr-reason">平台回复：{{item.reply}}</view>
          </view>
        </view>
        <view wx:else class="empty">
          <image class="big-img" src="/assets/icons/empty-doc.png" mode="aspectFit" />
          <view class="empty-t">还没有提交过反馈</view>
          <view class="empty-s">遇到虚假信息、骚扰或功能问题，都可以在上方提交</view>
        </view>
      </view>
    </block>

    <!-- 设置 -->
    <block wx:elif="{{view === 'set'}}">
      <view class="block">
        <view class="block-hd">
          <text class="bt">账号与主体</text>
        </view>
        <view class="set-list">
          <view class="set-row">
            <text class="sr-nm">微信昵称</text>
            <text class="sr-val">{{user.nick || '未设置'}}</text>
          </view>
          <view class="set-row">
            <text class="sr-nm">主体类别</text>
            <text class="sr-val">{{user.subjectKindText}}</text>
          </view>
          <view class="set-row">
            <text class="sr-nm">主体名称</text>
            <text class="sr-val">{{user.subject || '未填写'}}</text>
          </view>
          <view class="set-row">
            <text class="sr-nm">手机号</text>
            <text class="sr-val">{{user.phoneText}}</text>
          </view>
          <view class="set-row">
            <text class="sr-nm">所在城市</text>
            <text class="sr-val">{{user.city}}</text>
          </view>
          <view class="set-row">
            <text class="sr-nm">加入时间</text>
            <text class="sr-val">{{user.joined}}</text>
          </view>
        </view>
      </view>

      <view class="block">
        <view class="block-hd">
          <text class="bt">信息提示</text>
          <text class="r">只影响微信服务通知</text>
        </view>
        <view class="set-list">
          <view class="set-row">
            <view class="sr-main">
              <view class="sr-nm">微信消息提醒</view>
              <view class="sr-d">{{notifyOn ? '已授权，收到消息时微信会提醒你' : '未授权，开启后收到消息时微信会提醒你'}}</view>
            </view>
            <button class="btn sm" bindtap="enableNotify">{{notifyOn ? '管理' : '开启'}}</button>
          </view>
          <view class="set-row">
            <view class="sr-main">
              <view class="sr-nm">推送内容</view>
              <view class="sr-d">私信、系统通知与新匹配商机；站内消息始终完整保留</view>
            </view>
          </view>
          <view class="set-row">
            <view class="sr-main">
              <view class="sr-nm">商机提醒</view>
              <view class="sr-d">{{notifyBiz ? '有新的匹配商机时，推送一条微信提醒' : '已关闭，不再推送商机类微信提醒'}}</view>
            </view>
            <switch class="sr-sw" checked="{{notifyBiz}}" bindchange="toggleNotifyBiz" color="#2f6bff" />
          </view>
        </view>
      </view>

      <view class="block">
        <view class="block-hd">
          <text class="bt">隐私与安全</text>
        </view>
        <view class="set-desc">公开范围与手机号是否展示，统一在「我的信息」里设置。</view>
        <view class="set-list set-list-gap">
          <view class="set-row" bindtap="toggleWatermark">
            <view class="sr-main">
              <view class="sr-nm">水印保护</view>
              <view class="sr-d">默认开启；关闭后聊天与作品图片、视频不再叠加水印</view>
            </view>
            <view class="tg {{wmOn ? 'on' : ''}}"></view>
          </view>
          <view class="set-row" bindtap="goPrivacy">
            <view class="sr-main">
              <view class="sr-nm">隐私政策</view>
              <view class="sr-d">查看隐私条款与授权记录</view>
            </view>
            <text class="sr-go">›</text>
          </view>
          <view class="set-row">
            <view class="sr-main">
              <view class="sr-nm">本地缓存</view>
              <view class="sr-d">收藏 / 关注 / 浏览记录只存在本机</view>
            </view>
            <button class="btn sm" bindtap="clearCache">清空</button>
          </view>
        </view>
      </view>

      <view class="block">
        <view class="block-hd">
          <text class="bt">账号注销</text>
        </view>
        <view class="set-list">
          <block wx:if="{{delReq}}">
            <view class="set-row">
              <view class="sr-main">
                <view class="sr-nm">申请状态</view>
                <view class="sr-d">提交时间 {{delReq.createdAt}}</view>
              </view>
              <text class="sr-tag">{{delReq.status}}</text>
              <button wx:if="{{delReq.pending}}" class="btn sm" bindtap="cancelDelete">撤回</button>
            </view>
            <view wx:if="{{delReq.handlerNote}}" class="set-row">
              <view class="sr-main">
                <view class="sr-nm">平台回复</view>
                <view class="sr-d">{{delReq.handlerNote}}</view>
              </view>
            </view>
          </block>
          <view wx:else class="set-row">
            <view class="sr-main">
              <view class="sr-nm">注销账号</view>
              <view class="sr-d">停用后无法登录，历史记录按法规留存</view>
            </view>
            <button class="btn sm" bindtap="applyDelete">申请</button>
          </view>
        </view>
      </view>

      <view class="block">
        <view class="block-hd">
          <text class="bt">其他</text>
        </view>
        <view class="set-list">
          <view class="set-row" bindtap="goService">
            <view class="sr-main">
              <view class="sr-nm">在线客服</view>
              <view class="sr-d">在平台内给坐席留言，由管理端回复</view>
            </view>
            <text class="sr-go">›</text>
          </view>
          <view class="set-row">
            <text class="sr-nm">关于平台</text>
            <text class="sr-val">算力聚合 v1.0</text>
          </view>
        </view>
      </view>

      <button class="btn block danger logout-btn" bindtap="doLogout">退出登录</button>
    </block>
  </view>

  <!-- 修改委托：提交后先下架，平台审核通过后自动更新并重新上架 -->
  <view wx:if="{{editOpen}}" class="ag-edit-mask" bindtap="closeAgencyEdit"></view>
  <view wx:if="{{editOpen}}" class="ag-edit-sheet" catchtap="noop">
    <view class="ag-edit-hd">
      <text class="ag-edit-tt">修改委托</text>
      <text class="ag-edit-x" bindtap="closeAgencyEdit">×</text>
    </view>
    <view class="ag-edit-tip">提交后委托会临时下架，审核通过后自动更新展示内容并重新上架；驳回则恢复原内容。</view>
    <view class="ag-edit-row">
      <text class="ag-edit-lb">设备名称</text>
      <input class="ag-edit-ipt" value="{{editForm.item}}" data-field="item" bindinput="onAgencyEditInput" maxlength="60" placeholder="如：A100 80G 整机" />
    </view>
    <view class="ag-edit-row">
      <text class="ag-edit-lb">数量（台）</text>
      <input class="ag-edit-ipt" type="number" value="{{editForm.qty}}" data-field="qty" bindinput="onAgencyEditInput" maxlength="4" placeholder="1" />
    </view>
    <view class="ag-edit-row">
      <text class="ag-edit-lb">单价（元）</text>
      <input class="ag-edit-ipt" type="digit" value="{{editForm.price}}" data-field="price" bindinput="onAgencyEditInput" placeholder="0" />
    </view>
    <view class="ag-edit-row">
      <text class="ag-edit-lb">所在地</text>
      <input class="ag-edit-ipt" value="{{editForm.city}}" data-field="city" bindinput="onAgencyEditInput" maxlength="20" placeholder="如：杭州" />
    </view>
    <view class="ag-edit-row col">
      <text class="ag-edit-lb">详细说明</text>
      <textarea class="ag-edit-area" value="{{editForm.detail}}" data-field="detail" bindinput="onAgencyEditInput" maxlength="2000" placeholder="配置、成色、交付方式等" />
    </view>
    <view class="ag-edit-tip">交易流程与条件项保持不变，如需调整请联系在线客服。</view>
    <view class="ag-edit-acts">
      <button class="btn sm" bindtap="closeAgencyEdit">取消</button>
      <button class="btn sm primary" loading="{{editSaving}}" bindtap="submitAgencyEdit">提交修改</button>
    </view>
  </view>
</view>
