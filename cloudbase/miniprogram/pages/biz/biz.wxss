/* 商机：概览 + 开通门禁 + 商机卡片 + 开通弹层 */
.biz {
  background: var(--paper);
}

/* 概览 */
.bz-hero {
  margin: 24rpx 24rpx 0;
  padding: 28rpx;
  border-radius: var(--radius);
  background: linear-gradient(135deg, #4F46E5, #6366F1 55%, #818CF8);
  color: #fff;
}
.bz-hd {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.bz-tt {
  font-size: 36rpx;
  font-weight: 700;
}
.bz-badge {
  font-size: 21rpx;
  line-height: 44rpx;
  padding: 0 16rpx;
  border-radius: 22rpx;
  background: rgba(255, 255, 255, .18);
  color: #fff;
}
.bz-ds {
  margin-top: 10rpx;
  font-size: 22rpx;
  line-height: 1.6;
  color: rgba(255, 255, 255, .8);
}
.bz-stats {
  display: flex;
  margin-top: 26rpx;
  padding-top: 22rpx;
  border-top: 1rpx solid rgba(255, 255, 255, .18);
}
.bz-s {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}
.bz-s .n {
  font-size: 38rpx;
  font-weight: 700;
  line-height: 1.1;
}
.bz-s .l {
  font-size: 22rpx;
  color: rgba(255, 255, 255, .78);
}
.bz-s.link .l {
  color: #D9F7E7;
  font-weight: 600;
}

/* 囤货榜单 */
.bz-board {
  margin: 20rpx 24rpx 0;
  background: #fff;
  border: 1rpx solid var(--line);
  border-radius: var(--radius);
  overflow: hidden;
  box-shadow: var(--shadow);
}
.bb-hd {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 22rpx 24rpx;
}
.bb-l {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  min-width: 0;
}
.bb-tt {
  font-size: 27rpx;
  font-weight: 700;
  color: var(--ink);
}
.bb-ds {
  font-size: 20rpx;
  color: var(--muted);
}
.bb-x {
  flex-shrink: 0;
  font-size: 22rpx;
  color: var(--brand);
}

/* 未开通：原理卡 */
.bz-gate {
  margin: 22rpx 24rpx 0;
  padding: 28rpx;
  background: #fff;
  border: 1rpx solid var(--line);
  border-radius: var(--radius);
  box-shadow: var(--shadow);
}
.gate-tt {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--ink);
}
.gate-hd {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 12rpx;
}
.gate-ribbon {
  font-size: 20rpx;
  line-height: 1.5;
  color: var(--brand);
  background: var(--brand-soft);
  border: 1rpx solid var(--brand-line);
  border-radius: 999rpx;
  padding: 4rpx 14rpx;
}
.gate-ds {
  margin-top: 10rpx;
  font-size: 23rpx;
  line-height: 1.7;
  color: var(--muted);
}
/* 未开通：会员权益清单 */
.gate-benefits {
  margin-top: 18rpx;
}
.gb {
  display: flex;
  gap: 14rpx;
  padding: 18rpx 0;
  border-top: 1rpx solid var(--line-2);
}
.gb:first-child {
  border-top: 0;
  padding-top: 6rpx;
}
.gb-no {
  flex-shrink: 0;
  width: 38rpx;
  height: 38rpx;
  border-radius: 12rpx;
  background: var(--brand);
  color: #fff;
  font-size: 21rpx;
  font-weight: 700;
  text-align: center;
  line-height: 38rpx;
}
.gb-c {
  flex: 1;
}
.gb-t {
  font-size: 25rpx;
  font-weight: 600;
  color: var(--ink);
}
.gb-d {
  margin-top: 4rpx;
  font-size: 22rpx;
  line-height: 1.65;
  color: var(--muted);
}
.gate-sub {
  margin-top: 26rpx;
  font-size: 23rpx;
  font-weight: 600;
  color: var(--ink);
}
.gate-list {
  margin-top: 4rpx;
}
.gl {
  display: flex;
  gap: 16rpx;
  padding: 16rpx 0;
  border-top: 1rpx solid var(--line-2);
}
.gi {
  flex-shrink: 0;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: var(--brand-soft);
  color: var(--brand);
  font-size: 22rpx;
  font-weight: 700;
  text-align: center;
  line-height: 40rpx;
}
.gc {
  flex: 1;
}
.gt {
  font-size: 25rpx;
  font-weight: 600;
  color: var(--ink);
}
.gd {
  margin-top: 4rpx;
  font-size: 22rpx;
  line-height: 1.6;
  color: var(--muted);
}
/* 引导页直接展示四档套餐：与弹层同一套卡片样式，选中后可立即开通 */
.gate-plans {
  margin-top: 12rpx;
}
/* 匹配概览：三格数字，替代原来的黄色提示条 */
.gate-kpi {
  display: flex;
  margin-top: 20rpx;
  padding: 18rpx 0;
  border-top: 1rpx solid var(--line-2);
  border-bottom: 1rpx solid var(--line-2);
}
.gk {
  flex: 1;
  text-align: center;
}
.gk + .gk {
  border-left: 1rpx solid var(--line-2);
}
.gk-n {
  display: block;
  font-size: 34rpx;
  font-weight: 700;
  line-height: 1.1;
  color: var(--brand);
}
.gk-l {
  display: block;
  margin-top: 4rpx;
  font-size: 20rpx;
  color: var(--muted);
}
/* 区块小标题：权益 / 套餐 */
.gate-sec {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-top: 26rpx;
}
.gs-t {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--ink);
}
.gs-d {
  font-size: 20rpx;
  color: var(--muted);
}
.gate-btn {
  margin-top: 24rpx;
}
.gate-foot {
  margin-top: 16rpx;
  text-align: center;
  font-size: 21rpx;
  color: var(--muted);
}
/* 商机质量说明：独立卡片，与权益卡分开 */
.bz-quality {
  margin: 20rpx 24rpx 0;
  padding: 24rpx 28rpx;
  background: #fff;
  border: 1rpx solid var(--line);
  border-radius: var(--radius);
}
.bz-quality .gate-sub {
  margin-top: 0;
}

/* 未开通：商机预览 */
.bz-teaser {
  margin: 20rpx 24rpx 0;
  padding: 24rpx 0 0;
  background: #fff;
  border: 1rpx solid var(--line);
  border-radius: var(--radius);
  box-shadow: var(--shadow);
  overflow: hidden;
}
.teaser-hd {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 12rpx;
  padding: 0 24rpx 10rpx;
}
.teaser-tt {
  flex: none;
  font-size: 26rpx;
  font-weight: 700;
  color: var(--ink);
  white-space: nowrap;
}
.teaser-sub {
  flex: 1;
  min-width: 0;
  text-align: right;
  font-size: 20rpx;
  color: var(--muted);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
/* 固定十条高度：内部上下滑动看其余商机，不展示联系方式 */
.teaser-scroll {
  height: 1360rpx;
}
.tes-row {
  height: 136rpx;
  box-sizing: border-box;
  padding: 16rpx 24rpx;
  border-top: 1rpx solid var(--line-2);
  overflow: hidden;
}
.tes-top {
  display: flex;
  align-items: center;
  gap: 10rpx;
}
.tes-model {
  flex: 1;
  min-width: 0;
  font-size: 25rpx;
  color: var(--ink);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.tes-price {
  flex: none;
  font-size: 23rpx;
  font-weight: 600;
  color: var(--ink-2);
  white-space: nowrap;
}
/* 第二行：匹配上的型号 + 匹配依据（库存 / 我发布的需求）+ 脱敏主体 */
.tes-mid {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-top: 6rpx;
}
.tes-mm {
  flex: none;
  font-size: 20rpx;
  line-height: 32rpx;
  padding: 0 10rpx;
  border-radius: 6rpx;
  background: var(--brand-soft);
  color: var(--brand);
  white-space: nowrap;
}
.tes-via {
  flex: 1;
  min-width: 0;
  font-size: 20rpx;
  line-height: 26rpx;
  color: var(--ink-2);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
/* 发布时间：与匹配依据同一行，靠右显示 */
.tes-time {
  flex: none;
  font-size: 20rpx;
  line-height: 26rpx;
  color: var(--muted);
  white-space: nowrap;
}
/* 第三行：脱敏主体 */
.tes-bot {
  margin-top: 4rpx;
  font-size: 20rpx;
  line-height: 26rpx;
  color: var(--muted);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.teaser-foot {
  padding: 14rpx 24rpx 18rpx;
  text-align: center;
  font-size: 20rpx;
  color: var(--muted);
}
.tr-kind {
  flex-shrink: 0;
  font-size: 20rpx;
  line-height: 36rpx;
  padding: 0 12rpx;
  border-radius: 8rpx;
  background: var(--line-2);
  color: var(--muted);
}
.tr-kind.buy {
  background: var(--brand-soft);
  color: var(--brand);
}
.tr-kind.sell {
  background: var(--info-soft);
  color: var(--info);
}
.tr-kind.demand {
  background: var(--warn-soft);
  color: var(--warn);
}
.teaser-none {
  padding: 20rpx 24rpx 24rpx;
  font-size: 22rpx;
  line-height: 1.6;
  color: var(--muted);
}

/* 概览里的领取状态：点数字筛选，当前筛选高亮 */
.bz-s.on .l {
  color: #fff;
  font-weight: 600;
}
.bz-s.on {
  position: relative;
}
.bz-s.on::after {
  content: '';
  position: absolute;
  left: 0;
  bottom: -12rpx;
  width: 34rpx;
  height: 4rpx;
  border-radius: 2rpx;
  background: #fff;
}
/* 会员倒计时与续费：并入蓝色概览，不再单独占一行 */
.bz-me {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 22rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid rgba(255, 255, 255, .18);
}
.bm-t {
  flex: 1;
  min-width: 0;
  font-size: 22rpx;
  color: rgba(255, 255, 255, .82);
}
.bm-x {
  flex: none;
  font-size: 22rpx;
  font-weight: 600;
  color: #fff;
  border-bottom: 1rpx solid rgba(255, 255, 255, .5);
  padding-bottom: 2rpx;
}

/* 筛选 */
.bz-statebar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 20rpx 24rpx 0;
  padding: 16rpx 22rpx;
  border-radius: 16rpx;
  background: var(--brand-soft);
  border: 1rpx solid var(--brand-line);
}
.sb-t {
  font-size: 23rpx;
  color: var(--brand);
  font-weight: 600;
  white-space: nowrap;
}
.sb-b {
  flex: none;
  font-size: 22rpx;
  color: var(--brand);
}
/* 筛选栏：分类 / 排序 / 型号，点开贴边展开下拉面板（参考闲鱼筛选）
   滚动到顶部后吸附在屏幕顶部；用页面色描边补底，避免列表从圆角缝隙里透出 */
.bz-filter {
  position: sticky;
  top: 0;
  z-index: 21;
  margin: 18rpx 24rpx 0;
  background: #fff;
  border: 1rpx solid var(--line);
  border-radius: var(--radius);
  box-shadow: 0 0 0 24rpx var(--paper), var(--shadow);
}
.bz-trig-inner {
  display: flex;
  align-items: center;
  height: 88rpx;
  padding: 0 8rpx;
}
.bz-trigger {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  height: 88rpx;
  font-size: 25rpx;
  color: var(--ink);
  overflow: hidden;
}
.bz-trigger.on {
  color: var(--brand);
  font-weight: 600;
}
.bt-v {
  min-width: 0;
  max-width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.bt-arw {
  flex: none;
  font-size: 18rpx;
  line-height: 1;
  color: var(--muted);
  transition: transform .15s ease;
}
.bz-trigger.on .bt-arw {
  color: var(--brand);
}
.bt-arw.up {
  transform: rotate(180deg);
}
/* 遮罩：盖住列表，点空白处收起面板；筛选栏本身层级更高，仍可点击 */
.bz-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 20;
  background: rgba(0, 0, 0, .18);
}
/* 下拉面板：紧贴筛选栏下沿，整行选项，选中项打勾 */
.bz-menu {
  position: absolute;
  left: 0;
  right: 0;
  top: 100%;
  z-index: 22;
  margin-top: -1rpx;
  background: #fff;
  border: 1rpx solid var(--line);
  border-top: 0;
  border-radius: 0 0 var(--radius) var(--radius);
  box-shadow: 0 18rpx 40rpx rgba(15, 23, 42, .14);
  max-height: 60vh;
  overflow-y: auto;
}
.bf-opts {
  padding: 8rpx 0 14rpx;
}
.bf-opt {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  height: 92rpx;
  padding: 0 32rpx;
  font-size: 27rpx;
  color: var(--ink);
}
.bf-opt.on {
  color: var(--brand);
  font-weight: 600;
}
.bf-check {
  flex: none;
  font-size: 26rpx;
  color: var(--brand);
}
.bf-empty {
  padding: 28rpx 32rpx;
  font-size: 24rpx;
  color: var(--muted);
}

/* 商机卡片 */
.opp-list {
  padding: 8rpx 24rpx 0;
}
.opp-card {
  background: #fff;
  border: 1rpx solid var(--line);
  border-radius: var(--radius);
  padding: 24rpx;
  margin-bottom: 18rpx;
  box-shadow: var(--shadow);
  /* 兜底：任何子元素都不能溢出卡片边界，避免文字叠在相邻卡片上 */
  overflow: hidden;
}
.op-top {
  display: flex;
  flex-wrap: nowrap;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}
.op-top-l {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 10rpx;
  min-width: 0;
  overflow: hidden;
}
/* 平台单标识：品牌色浅底，与普通需求区分 */
.op-mode {
  flex: none;
  white-space: nowrap;
  font-size: 20rpx;
  line-height: 34rpx;
  padding: 0 12rpx;
  border-radius: 8rpx;
  border: 1rpx solid var(--brand-line);
  background: var(--brand-soft);
  color: var(--brand);
  font-weight: 600;
}
.op-kind {
  flex: none;
  white-space: nowrap;
  font-size: 21rpx;
  line-height: 40rpx;
  padding: 0 14rpx;
  border-radius: 10rpx;
  background: var(--brand-soft);
  color: var(--brand);
  font-weight: 600;
}
.op-kind.sell {
  background: var(--info-soft);
  color: var(--info);
}
.op-kind.demand {
  background: var(--warn-soft);
  color: var(--warn);
}
/* 服务费说明：作为独立小标签跟随品类 / 城市，不挤占顶部一行 */
.op-chips .chip.fee {
  background: var(--warn-soft);
  color: var(--warn);
}
.op-top-r {
  display: flex;
  align-items: center;
  gap: 10rpx;
  flex: none;
}
/* 每条商机独立的分享入口：右上角小方形图标按钮，分享该条的型号 / 数量 / 城市 / 主体 */
.op-share {
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0;
  padding: 0;
  width: 40rpx;
  height: 40rpx;
  min-height: 0;
  line-height: 1;
  background: var(--brand-soft);
  border: 1rpx solid var(--brand-line);
  border-radius: 8rpx;
}
.op-share::after {
  border: none;
}
/* 分享图标：22rpx 品牌色三节点，与 40rpx 方框比例协调 */
.op-share-ic {
  display: block;
  width: 22rpx;
  height: 22rpx;
}
/* 海报：生成带小程序码的图并保存到相册，用于朋友圈 / 其他平台 */
.op-save {
  flex: none;
  padding: 0 16rpx;
  height: 40rpx;
  line-height: 40rpx;
  font-size: 20rpx;
  color: #4F46E5;
  background: rgba(79, 70, 229, 0.1);
  border-radius: 999rpx;
}
/* 卡片主体：左侧型号 / 价格 / 标签，右侧实拍封面，与普通商品列表同一套展示 */
.op-body {
  display: flex;
  gap: 18rpx;
  margin-top: 14rpx;
}
.op-main {
  flex: 1;
  min-width: 0;
}
.op-thumb {
  position: relative;
  flex-shrink: 0;
  width: 172rpx;
  height: 172rpx;
  border-radius: 14rpx;
  overflow: hidden;
  background: var(--line-2);
}
.op-thumb-img {
  display: block;
  width: 100%;
  height: 100%;
}
.op-thumb-in {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  width: 100%;
  height: 100%;
  padding: 12rpx;
  box-sizing: border-box;
  background: linear-gradient(135deg, #EEF2FF, #E0E7FF);
  text-align: center;
}
.op-thumb-model {
  font-size: 20rpx;
  font-weight: 600;
  color: #4338CA;
  line-height: 1.35;
  overflow: hidden;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}
.op-thumb-qty {
  font-size: 19rpx;
  color: #6366F1;
}
.op-thumb-n {
  position: absolute;
  right: 8rpx;
  bottom: 8rpx;
  padding: 0 10rpx;
  border-radius: 999rpx;
  background: rgba(15, 23, 42, .55);
  color: #fff;
  font-size: 18rpx;
  line-height: 32rpx;
}
.op-model {
  margin-top: 0;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--ink);
  line-height: 1.4;
}
.op-price {
  display: flex;
  flex-wrap: wrap;
  align-items: baseline;
  gap: 8rpx;
  margin-top: 10rpx;
}
.op-p {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--ink);
}
.op-unit {
  white-space: nowrap;
  font-size: 22rpx;
  color: var(--muted);
}
.op-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 14rpx;
}
.op-stock {
  margin-top: 14rpx;
  padding: 14rpx 16rpx;
  border-radius: 12rpx;
  background: var(--brand-soft);
  font-size: 22rpx;
  color: var(--brand);
  line-height: 1.6;
}
/* 匹配说明：命中的型号 + 匹配依据（基于我的库存 / 我发布的需求） */
.op-match {
  margin-top: 14rpx;
  padding: 14rpx 16rpx;
  border-radius: 12rpx;
  border: 1rpx solid var(--brand-line);
  background: var(--brand-soft);
  font-size: 22rpx;
  line-height: 1.6;
  color: var(--brand);
  display: flex;
  flex-wrap: wrap;
  align-items: baseline;
  gap: 10rpx;
}
.om-t {
  white-space: nowrap;
  font-size: 19rpx;
  font-weight: 700;
  padding: 2rpx 10rpx;
  border-radius: 8rpx;
  background: var(--brand);
  color: #fff;
}
.om-model {
  font-weight: 700;
}
.om-via {
  color: var(--ink-2);
}
/* 开通弹层 */
.m-mask {
  position: fixed;
  inset: 0;
  z-index: 90;
  background: rgba(24, 24, 27, .45);
}
.m-sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 91;
  max-height: 88vh;
  overflow-y: auto;
  padding: 28rpx 28rpx calc(28rpx + env(safe-area-inset-bottom));
  border-radius: 28rpx 28rpx 0 0;
  background: #fff;
}
.ms-hd {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 30rpx;
  font-weight: 700;
}
.ms-x {
  flex: none;
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  color: var(--muted);
}
.ms-price {
  display: flex;
  align-items: baseline;
  gap: 14rpx;
  margin-top: 16rpx;
}
.ms-p {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--brand);
}
.ms-d {
  font-size: 21rpx;
  color: var(--muted);
}
/* 套餐固定两列两行：用 space-between 收口，不用 gap + calc(50% - x)，
   否则 iOS 亚像素取整会把第二张卡挤到下一行变成一列 */
.ms-plans {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  margin-top: 20rpx;
}
.ms-plan {
  width: 48.5%;
  margin-bottom: 16rpx;
  box-sizing: border-box;
  padding: 18rpx 20rpx;
  border: 2rpx solid var(--line-2);
  border-radius: 16rpx;
  background: #fff;
}
.ms-plan.on {
  border-color: var(--brand);
  background: var(--brand-soft);
}
.pl-hd {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.pl-label {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--ink);
}
.pl-save {
  padding: 2rpx 10rpx;
  border-radius: 8rpx;
  background: #fff1e8;
  color: #d46b08;
  font-size: 19rpx;
}
.pl-price {
  margin-top: 8rpx;
  font-size: 34rpx;
  font-weight: 700;
  color: var(--brand);
}
.pl-y {
  font-size: 22rpx;
  margin-right: 2rpx;
}
.pl-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 4rpx;
}
.pl-days {
  font-size: 21rpx;
  color: var(--muted);
}
.pl-origin {
  font-size: 19rpx;
  color: var(--muted);
  text-decoration: line-through;
}
.ms-plans-tip {
  margin-top: 10rpx;
  font-size: 20rpx;
  color: var(--muted);
}
.ms-note {
  margin-top: 16rpx;
  padding: 16rpx 18rpx;
  border-radius: 12rpx;
  background: var(--warn-soft);
  border: 1rpx solid var(--warn-line);
  font-size: 21rpx;
  line-height: 1.6;
  color: var(--warn);
}
.ms-demo {
  margin-top: 20rpx;
  text-align: center;
  font-size: 21rpx;
  color: var(--muted);
  text-decoration: underline;
}

/* 开通申请回执：申请已提交 / 已开通续费提示 */
.ms-applied {
  margin-top: 16rpx;
  padding: 16rpx 18rpx;
  border-radius: 12rpx;
  background: var(--brand-soft, #eef4ff);
  border: 1rpx solid var(--brand-line, #d6e2ff);
  font-size: 21rpx;
  line-height: 1.6;
  color: var(--brand, #2f6bff);
}

/* 分享落地提示条：来自分享的商机 → 一键回到完整列表 */
.bz-focus {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 16rpx 24rpx 0;
  padding: 14rpx 18rpx;
  border-radius: 12rpx;
  background: var(--brand-soft, #eef4ff);
  border: 1rpx solid var(--brand-line, #d6e2ff);
}
.bz-focus .bf-t {
  font-size: 22rpx;
  color: var(--brand, #2f6bff);
}
.bz-focus .bf-b {
  font-size: 22rpx;
  font-weight: 600;
  color: var(--brand, #2f6bff);
}
/* 接口失败提示：与分享定位条同样式，点击整条重试 */
.bz-fail {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 16rpx 24rpx 0;
  padding: 14rpx 18rpx;
  border-radius: 12rpx;
  background: #fff5f5;
  border: 1rpx solid #ffd9d9;
}
.bz-renew {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  margin: 16rpx 24rpx 0;
  padding: 18rpx;
  border-radius: 12rpx;
  background: #fffbe6;
  border: 1rpx solid #ffe58f;
}
.bz-renew .br-t {
  font-size: 24rpx;
  font-weight: 600;
  color: #874d00;
}
.bz-renew .br-b {
  font-size: 22rpx;
  color: #ad6800;
}
.bz-fail .bf-t {
  font-size: 22rpx;
  color: #d4380d;
}
.bz-fail .bf-b {
  font-size: 22rpx;
  font-weight: 600;
  color: #d4380d;
}

/* 提示力度：概览内独立的设置按钮 + 可手动设置提示 */
.bz-hd-r {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.bz-pref-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-top: 18rpx;
}
.bz-pref-btn {
  flex: none;
  max-width: 100%;
  display: flex;
  align-items: center;
  gap: 10rpx;
  height: 64rpx;
  padding: 0 20rpx;
  border-radius: 26rpx;
  border: 2rpx solid rgba(255, 255, 255, .38);
  background: rgba(255, 255, 255, .16);
}
.bz-pref-btn-hover {
  background: rgba(255, 255, 255, .32);
}
.pfr-ico {
  position: relative;
  width: 26rpx;
  height: 24rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}
.pfr-line {
  position: relative;
  height: 3rpx;
  border-radius: 2rpx;
  background: rgba(255, 255, 255, .9);
}
.pfr-knob {
  position: absolute;
  top: -4rpx;
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #fff;
}
.pfr-t {
  flex: none;
  white-space: nowrap;
  font-size: 22rpx;
  color: rgba(255, 255, 255, .88);
}
.pfr-v {
  flex: 0 1 auto;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  font-size: 24rpx;
  font-weight: 700;
  color: #fff;
}
/* 下滑加载更多提示 */
.bz-more {
  margin-top: 20rpx;
  text-align: center;
  font-size: 21rpx;
  color: var(--muted);
  padding: 16rpx 0;
}
/* 设置面板分区：显示时间 / 排序 / 型号筛选 / 匹配力度 */
.pf-sec {
  margin-top: 20rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid var(--line-2);
}
.pf-sec-hd {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 12rpx;
}
.pf-sec-t {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--ink);
}
.pf-sec-s {
  font-size: 20rpx;
  color: var(--muted);
}
.pf-days-input {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-top: 12rpx;
}
.pf-input {
  width: 180rpx;
  height: 68rpx;
  padding: 0 16rpx;
  border: 1rpx solid var(--line-2);
  border-radius: 12rpx;
  font-size: 24rpx;
  color: var(--ink);
}
/* 手动天数：输入后点「确定」才生效 */
.pf-days-ok {
  flex: none;
  height: 68rpx;
  line-height: 68rpx;
  padding: 0 26rpx;
  border-radius: 12rpx;
  background: var(--brand);
  color: #fff;
  font-size: 24rpx;
  font-weight: 600;
  white-space: nowrap;
}
.pf-days-unit {
  font-size: 22rpx;
  color: var(--muted);
}
.pf-empty {
  margin-top: 12rpx;
  font-size: 21rpx;
  color: var(--muted);
}
.pf-ds {
  margin-top: 12rpx;
  font-size: 22rpx;
  line-height: 1.6;
  color: var(--muted);
}
.pf-levels {
  display: flex;
  gap: 14rpx;
  margin-top: 16rpx;
}
.pf-level {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  padding: 16rpx 14rpx;
  border: 2rpx solid var(--line-2);
  border-radius: 16rpx;
  background: #fff;
}
.pf-level.on {
  border-color: var(--brand);
  background: var(--brand-soft);
}
.pf-name {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--ink);
}
.pf-desc {
  font-size: 19rpx;
  line-height: 1.5;
  color: var(--muted);
}
.pf-dims {
  margin-top: 18rpx;
}
.pf-dim {
  margin-top: 14rpx;
}
.pf-dim-hd {
  display: flex;
  align-items: center;
  gap: 10rpx;
}
.pf-dim-t {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--ink);
}
.pf-dim-tag {
  font-size: 18rpx;
  color: var(--muted);
}
.pf-opts {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 10rpx;
}
.pf-opt {
  flex: none;
  white-space: nowrap;
  display: inline-flex;
  align-items: center;
  min-height: 60rpx;
  font-size: 22rpx;
  padding: 0 20rpx;
  border-radius: 999rpx;
  background: #f4f4f5;
  color: var(--muted);
}
.pf-opt.on {
  background: var(--brand-soft);
  color: var(--brand);
  font-weight: 600;
}
.pf-note {
  margin-top: 16rpx;
  padding: 14rpx 16rpx;
  border-radius: 12rpx;
  background: var(--warn-soft);
  border: 1rpx solid var(--warn-line);
  font-size: 20rpx;
  line-height: 1.6;
  color: var(--warn);
}
.pf-save {
  margin-top: 18rpx;
}
/* 商机提示设置：设置项区域单独滚动，保存按钮常驻底部 */
.pf-sheet {
  display: flex;
  flex-direction: column;
  overflow: hidden;
  padding-bottom: 0;
}
.pf-sheet .ms-hd {
  flex: none;
}
.pf-body {
  flex: 1;
  min-height: 0;
  overflow-y: auto;
  -webkit-overflow-scrolling: touch;
}
.pf-sheet .pf-save {
  flex: none;
  margin: 18rpx 0 calc(28rpx + env(safe-area-inset-bottom));
}

/* 商品卡：整块复用普通发布（首页在售货源 / 求购需求）的商品卡样式，
   卡片本体样式统一在 app.wxss，商机列表只在卡片下方多一行「匹配依据」 */
.opp-list .gcard {
  margin-bottom: 18rpx;
}
