<view class="page biz">
  <!-- 概览：匹配商机 / 在售库存 / 已领取 / 不满足，会员倒计时与续费并入本卡（列表页不展示） -->
  <view wx:if="{{!listMode}}" class="bz-hero">
    <view class="bz-hd">
      <view class="bz-tt">{{mineMode ? '我的商机' : '商机'}}</view>
      <view class="bz-hd-r">
        <view wx:if="{{!mineMode}}" class="bz-badge">{{plan}}</view>
      </view>
    </view>
    <view class="bz-ds">{{mineMode ? '只显示你已领取的商机，可随时回看联系方式并直接发起站内对话' : '已发布需求 + 平台核验后的代采 / 代售委托，按你的库存自动匹配；委托类由平台代为对接'}}</view>
    <!-- 商机提示设置：显示时间、排序、型号筛选与匹配力度都在同一个面板里 -->
    <view wx:if="{{!mineMode}}" class="bz-pref-row">
      <view class="bz-pref-btn" bindtap="openPref" hover-class="bz-pref-btn-hover">
        <view class="pfr-ico">
          <view class="pfr-line"><text class="pfr-knob" style="left:3rpx"></text></view>
          <view class="pfr-line"><text class="pfr-knob" style="left:11rpx"></text></view>
          <view class="pfr-line"><text class="pfr-knob" style="left:6rpx"></text></view>
        </view>
        <text class="pfr-t">商机提示设置</text>
        <text class="pfr-v">{{prefLevelName}} · {{dayLabel}}{{prefCityText ? ' · ' + prefCityText : ''}}{{prefSubject === 'open' ? ' · 仅公开主体' : ''}}</text>
      </view>
    </view>
    <!-- 主体信息筛选生效时，提示还有多少条因不公开主体被隐藏 -->
    <view wx:if="{{!mineMode && prefSubject === 'open' && hiddenCount > 0}}" class="bz-hidden">另有 {{hiddenCount}} 条被筛选隐藏</view>
    <view wx:if="{{!mineMode}}" class="bz-stats">
      <view class="bz-s">
        <text class="n">{{stats.matched}}</text>
        <text class="l">匹配商机</text>
      </view>
      <view class="bz-s link" bindtap="goStock">
        <text class="n">{{stats.stock.sku}}</text>
        <text class="l">在售库存 ›</text>
      </view>
      <view class="bz-s link" data-key="claimed" bindtap="goView">
        <text class="n">{{stats.claimed}}</text>
        <text class="l">已领取 ›</text>
      </view>
      <view class="bz-s link" data-key="unsatisfied" bindtap="goView">
        <text class="n">{{stats.unsatisfied}}</text>
        <text class="l">不满足 ›</text>
      </view>
    </view>
    <view wx:if="{{!mineMode && unlocked}}" class="bz-me">
      <text class="bm-t">已开通 · 剩余 {{daysLeft}} 天 · {{expireText}}</text>
      <text class="bm-x" bindtap="openSheet">续费 ›</text>
    </view>
  </view>

  <!-- 微信商机提醒额度用完：随时点开通 / 续订，授权成功立即消失 -->
  <view wx:if="{{!singlePage && wxNotifyTip}}" class="notify-tip" bindtap="renewNotify">
    <image class="nt-ico" src="/assets/icons/tip-bell.png" mode="aspectFit" />
    <view class="nt-body">
      <view class="nt-title">{{wxRemain === 0 ? '微信提醒已用完' : '开启商机微信提醒'}}</view>
      <view class="nt-sub">{{wxRemain === 0 ? '一次性订阅每条授权只能提醒一次，点这里续订，新商机第一时间提醒你' : '有新的匹配商机时，第一时间在微信收到服务通知'}}</view>
    </view>
    <text class="nt-go">{{wxRemain === 0 ? '续订 ›' : '开通 ›'}}</text>
  </view>

  <!-- 从分享卡片进入：只展示被分享的那一条，可一键回到完整列表 -->
  <view wx:if="{{focusId}}" class="bz-focus">
    <text class="bf-t">来自分享的商机</text>
    <text class="bf-b" bindtap="clearFocus">查看全部商机 ›</text>
  </view>

  <!-- 已登录但商机接口失败：明确提示并重试，不展示演示数据 -->
  <view wx:if="{{loadFailed}}" class="bz-fail" bindtap="refresh">
    <text class="bf-t">商机加载失败</text>
    <text class="bf-b">点此重试 ›</text>
  </view>

  <!-- 未开通商机会员：只能看到角标数字，热度榜单与供求关系需开通后查看 -->
  <view wx:if="{{!unlocked && !loadFailed && !mineMode && !listMode}}" class="bz-board" bindtap="openSheet">
    <view class="bb-hd">
      <view class="bb-l">
        <text class="bb-tt">商机榜单 · 供求关系</text>
        <text class="bb-ds">商机会员可查看需求榜、火热榜、供给榜</text>
      </view>
      <text class="bb-x">开通查看 ›</text>
    </view>
  </view>

  <!-- 商机榜单入口：点击进入独立页面查看需求榜 / 火热榜 / 供给榜 / 品类榜 -->
  <view wx:if="{{unlocked && !mineMode && !listMode}}" class="bz-board">
    <view class="bb-hd" bindtap="goBoard">
      <view class="bb-l">
        <text class="bb-tt">商机榜单</text>
        <text class="bb-ds">需求榜 · 火热榜 · 供给榜 · 品类榜</text>
      </view>
      <text class="bb-x">查看 ›</text>
    </view>
  </view>

  <!-- 「我的商机」/ 已领取、不满足列表页：权限到期时给出续费入口 -->
  <view wx:if="{{(mineMode || listMode) && !unlocked && !loadFailed}}" class="bz-renew" bindtap="openSheet">
    <text class="br-t">商机联系方式需开通会员后查看</text>
    <text class="br-b">{{listMode ? '开通 / 续费后可查看并联系对方 ›' : '开通 / 续费后可查看已领取商机的联系方式 ›'}}</text>
  </view>

  <!-- 未开通：展示商机原理 + 开通入口 -->
  <block wx:if="{{!unlocked && !loadFailed && !mineMode && !listMode}}">
    <view class="bz-gate">
      <view class="gate-hd">
        <view class="gate-tt">商机会员</view>
        <text class="gate-ribbon">{{plan}}</text>
      </view>
      <view class="gate-ds">真实买家与卖家发布的供需，按你的库存自动匹配；商品与需求默认公开并自动进入商机匹配池，也可选择「仅发商机池」只进匹配、不在首页与搜索展示。未开通可看脱敏信息，开通后可查看完整主体、联系方式并领取。</view>

      <!-- 匹配概览：开通前就能看到有多少条在等 -->
      <view class="gate-kpi">
        <view class="gk">
          <text class="gk-n">{{stats.matched}}</text>
          <text class="gk-l">条匹配商机</text>
        </view>
        <view class="gk">
          <text class="gk-n">{{stats.agency}}</text>
          <text class="gk-l">条平台委托</text>
        </view>
        <view class="gk">
          <text class="gk-n">{{stats.demands}}</text>
          <text class="gk-l">条求购需求</text>
        </view>
      </view>

      <view class="gate-sec">
        <text class="gs-t">会员权益</text>
      </view>
      <view class="gate-benefits">
        <view class="gb">
          <text class="gb-no">1</text>
          <view class="gb-c">
            <view class="gb-t">商机全量匹配，都能领取</view>
            <view class="gb-d">按你的库存型号、成色、起订量自动匹配供需；开通后可查看完整主体、全部条件与匹配依据。匹配到的商机不限名额，所有会员都能领取，不用抢。</view>
          </view>
        </view>
        <view class="gb">
          <text class="gb-no">2</text>
          <view class="gb-c">
            <view class="gb-t">联系方式直接解锁</view>
            <view class="gb-d">货主主动公开电话时，领取后可直接复制拨打；没留电话就走站内对话，全程不暴露你的手机号。未开通只能看到脱敏信息。</view>
          </view>
        </view>
        <view class="gb">
          <text class="gb-no">3</text>
          <view class="gb-c">
            <view class="gb-t">承接平台代采 / 代售</view>
            <view class="gb-d">平台核验资质与金额后的委托只进商机池，不公开。会员可查看并领取，点「咨询平台」提交承接需求，由客服居中推进。</view>
          </view>
        </view>
        <view class="gb">
          <text class="gb-no">4</text>
          <view class="gb-c">
            <view class="gb-t">四类榜单看行情</view>
            <view class="gb-d">需求榜、火热榜、供给榜、品类榜，热门机型、成交价区间与供给分布一眼看清。</view>
          </view>
        </view>
      </view>

      <!-- 四档套餐：引导页直接展示并可选择，选中后按该档下单 -->
      <view wx:if="{{plans.length}}" class="gate-sec">
        <text class="gs-t">选择套餐</text>
        <text class="gs-d">到期续费按档位累加</text>
      </view>
      <view wx:if="{{plans.length}}" class="ms-plans gate-plans">
        <view
          wx:for="{{plans}}"
          wx:key="key"
          class="ms-plan {{planKey === item.key ? 'on' : ''}}"
          data-key="{{item.key}}"
          bindtap="selectPlan"
        >
          <view class="pl-hd">
            <text class="pl-label">{{item.label}}</text>
            <text wx:if="{{item.saving}}" class="pl-save">省 {{item.saving}}</text>
          </view>
          <view class="pl-price"><text class="pl-y">¥</text>{{item.price}}</view>
          <view class="pl-meta">
            <text class="pl-days">{{item.termText}}</text>
            <text wx:if="{{item.original > item.price}}" class="pl-origin">原价 ¥{{item.original}}</text>
          </view>
        </view>
      </view>

      <button class="btn primary block gate-btn" bindtap="openSheet" loading="{{paying}}" disabled="{{paying}}">{{unlocked ? '立即续费' : '立即开通'}}{{selectedPlan ? ' · ¥' + selectedPlan.price + ' / ' + selectedPlan.days + ' 天' : ' · ' + plan}}</button>
      <!-- 7 天体验：每个账号一次，需二次确认后开通 -->
      <block wx:if="{{!unlocked && trialAvailable}}">
        <button class="btn block gate-trial" bindtap="startTrial" loading="{{trialing}}" disabled="{{trialing || paying}}">先体验 7 天</button>
        <view class="gate-trial-tip">先开通 7 天体验，权益与付费会员一致；每个账号仅一次，到期后需开通会员才能继续使用。</view>
      </block>
      <view class="gate-foot">微信支付 · 付款后自动延长会员时长</view>
    </view>

    <!-- 信任说明独立成卡，避免和权益、套餐堆在一起 -->
    <view class="bz-quality">
      <view class="gate-sub">平台如何把控商机质量</view>
      <view class="gate-list">
        <view class="gl">
          <text class="gi">1</text>
          <view class="gc">
            <view class="gt">发布门槛</view>
            <view class="gd">商品与需求默认公开并自动进入商机匹配池，也可以选择「仅发商机池」只进匹配、不在首页与搜索展示；未公开主体也可被匹配，展示时脱敏；代采 / 代售核验后上架。</view>
          </view>
        </view>
        <view class="gl">
          <text class="gi">2</text>
          <view class="gc">
            <view class="gt">匹配规则</view>
            <view class="gd">按型号、成色、起订量匹配，库存不足或起订量接不下的不推送。</view>
          </view>
        </view>
        <view class="gl">
          <text class="gi">3</text>
          <view class="gc">
            <view class="gt">联系人与隐私</view>
            <view class="gd">商机内主体脱敏，领取后才给联系人，未公开电话走站内对话。</view>
          </view>
        </view>
      </view>
    </view>

    <!-- 未开通：脱敏商机预览，固定十条高度，内部可滑动看其余，不展示联系方式 -->
    <view class="bz-teaser">
      <view class="teaser-hd">
        <text class="teaser-tt">匹配到的商机</text>
        <text class="teaser-sub">{{teaserItems.length}} 条 · 开通后可看完整主体，领取后可见联系方式</text>
      </view>
      <scroll-view wx:if="{{teaserItems.length}}" class="teaser-scroll" scroll-y="true" show-scrollbar="{{false}}">
        <view wx:for="{{teaserItems}}" wx:key="id" class="tes-row">
          <view class="tes-top">
            <text class="tr-kind {{item.type === 'supply' ? 'sell' : (item.kind === '代采' ? 'buy' : (item.kind === '代售' ? 'sell' : 'demand'))}}">{{item.kind}}</text>
            <text class="tes-model">{{item.model}}</text>
            <text class="tes-price">{{item.priceText}}</text>
          </view>
          <view class="tes-mid">
            <text wx:if="{{item.matchModel}}" class="tes-mm">{{item.matchModel}}</text>
            <text class="tes-via">{{item.matchText || (item.matchVia ? '基于' + item.matchVia : '')}}</text>
            <text class="tes-time">{{item.published}}</text>
          </view>
          <view class="tes-bot">
            <text class="tes-bot-t">主体 {{item.org || '已脱敏'}}</text>
            <text wx:if="{{item.ownerKey}}" class="tes-home"
                  data-key="{{item.ownerKey}}" data-nick="{{item.nick || item.org}}"
                  catchtap="openOwner">查看主页 ›</text>
          </view>
        </view>
      </scroll-view>
      <view wx:else class="teaser-none">暂时没有和你条件匹配的商机：完善库存型号 / 成色 / 起订量，或发布求购需求后再看</view>
      <view wx:if="{{teaserItems.length}}" class="teaser-foot">上下滑动查看全部匹配商机 · 未公开主体也可查看发布者主页</view>
    </view>
  </block>

  <!-- 已开通：商机列表 -->
  <block wx:elif="{{!loadFailed}}">
    <!-- 已领取 / 不满足列表页：展示当前分组条数，可返回商机页 -->
    <view wx:if="{{listMode}}" class="bz-statebar">
      <text class="sb-t">{{state === 'claimed' ? '已领取 · ' + stats.claimed + ' 条' : '不满足 · ' + stats.unsatisfied + ' 条'}}</text>
      <text class="sb-b" bindtap="goBack">返回商机 ›</text>
    </view>

    <!-- 筛选栏：分类 / 排序 / 型号，点开后贴边展开下拉面板，可叠加筛选 -->
    <view wx:if="{{filterMenu}}" class="bz-mask" bindtap="closeMenu"></view>
    <view class="bz-filter">
      <view class="bz-trig-inner">
        <view class="bz-trigger {{filter !== 'all' || filterMenu === 'cat' ? 'on' : ''}}" data-menu="cat" bindtap="toggleMenu">
          <text class="bt-v">{{filterLabel}}</text>
          <text class="bt-arw {{filterMenu === 'cat' ? 'up' : ''}}">▾</text>
        </view>
        <view class="bz-trigger {{prefs.sort !== 'latest' || filterMenu === 'sort' ? 'on' : ''}}" data-menu="sort" bindtap="toggleMenu">
          <text class="bt-v">{{sortLabel}}</text>
          <text class="bt-arw {{filterMenu === 'sort' ? 'up' : ''}}">▾</text>
        </view>
        <view class="bz-trigger {{modelFilter || filterMenu === 'model' ? 'on' : ''}}" data-menu="model" bindtap="toggleMenu">
          <text class="bt-v">{{modelFilter || '全部型号'}}</text>
          <text class="bt-arw {{filterMenu === 'model' ? 'up' : ''}}">▾</text>
        </view>
      </view>

      <!-- 下拉面板：贴齐筛选栏下拉，整行选项，当前项打勾 -->
      <view wx:if="{{filterMenu}}" class="bz-menu">
        <view wx:if="{{filterMenu === 'cat'}}" class="bf-opts">
          <view wx:for="{{filters}}" wx:key="key"
                class="bf-opt {{filter === item.key ? 'on' : ''}}"
                data-key="{{item.key}}" bindtap="switchFilter">
            <text>{{item.label}}</text>
            <text wx:if="{{filter === item.key}}" class="bf-check">✓</text>
          </view>
        </view>
        <view wx:elif="{{filterMenu === 'sort'}}" class="bf-opts">
          <view wx:for="{{sortOptions}}" wx:key="key"
                class="bf-opt {{prefs.sort === item.key ? 'on' : ''}}"
                data-key="{{item.key}}" bindtap="pickSort">
            <text>{{item.label}}</text>
            <text wx:if="{{prefs.sort === item.key}}" class="bf-check">✓</text>
          </view>
        </view>
        <view wx:else class="bf-opts">
          <view class="bf-opt {{!modelFilter ? 'on' : ''}}" data-key="" bindtap="pickModel">
            <text>全部型号</text>
            <text wx:if="{{!modelFilter}}" class="bf-check">✓</text>
          </view>
          <view wx:for="{{matchModels}}" wx:key="*this"
                class="bf-opt {{modelFilter === item ? 'on' : ''}}"
                data-key="{{item}}" bindtap="pickModel">
            <text>{{item}}</text>
            <text wx:if="{{modelFilter === item}}" class="bf-check">✓</text>
          </view>
          <view wx:if="{{!matchModels.length}}" class="bf-empty">当前分类下暂时没有商机型号可筛</view>
        </view>
      </view>
    </view>

    <view class="opp-list">
      <!-- 商品卡与普通发布完全一致：点击整张卡片直接查看商机，不再单独放「查看商机」按钮 -->
      <view wx:for="{{items}}" wx:key="id" class="gcard"
            data-id="{{item.id}}" data-type="{{item.type}}" bindtap="openDetail">
        <view class="top">
          <text class="top-info">{{item.org || '平台商机'}} · {{item.city || '城市未填写'}} · {{item.published}}</text>
          <!-- 未公开主体的商机也能进入发布者主页，主体字段仍按脱敏展示 -->
          <text wx:if="{{item.ownerKey}}" class="top-home"
                data-key="{{item.ownerKey}}" data-nick="{{item.nick || item.org}}"
                catchtap="openOwner">查看主页</text>
          <view class="top-right">
            <!-- 本次进入时新增的商机：置顶并标「新」，下次进入即回到正常排序 -->
            <text wx:if="{{item.isNew}}" class="pill-tag new">新</text>
            <text class="pill-tag {{item.isRent ? 'rent' : ((item.type === 'supply' || item.kind === '代售') ? '' : 'buy')}}">{{item.kind}}</text>
            <!-- 与首页商品卡一致：右上角收藏 -->
            <view class="fav-btn {{item.fav ? 'on' : ''}}" data-id="{{item.id}}" data-type="{{item.type}}" catchtap="toggleFav">{{item.fav ? '★' : '☆'}}</view>
          </view>
        </view>
        <view class="title">{{item.title || item.model}}</view>
        <!-- 条件标签与普通商品卡同一套口径：品类 / 成色 / 税费 / 供给类型 -->
        <view wx:if="{{!item.closed}}" class="chips">
          <text wx:if="{{item.cat}}" class="chip">{{item.cat}}</text>
          <text wx:if="{{!item.isRent && item.cond}}" class="chip">{{item.cond}}</text>
          <text wx:if="{{item.taxShort}}" class="chip">{{item.taxShort}}</text>
          <text wx:if="{{item.supply}}" class="chip">{{item.supply}}</text>
        </view>
        <view class="mid">
          <view class="thumb {{item.isRent ? 'rent' : (item.type === 'demand' ? 'demand' : '')}}">
            <image wx:if="{{item.cover}}" class="thumb-img" src="{{item.cover}}" mode="aspectFill" lazy-load />
            <view wx:else class="thumb-in">
              <text class="ti-model">{{item.model || item.kind}}</text>
              <text wx:if="{{item.qty}}" class="ti-qty">{{item.qty}} {{item.unit}}</text>
            </view>
            <text wx:if="{{item.mediaCount > 1}}" class="thumb-n">{{item.mediaCount}} 图</text>
          </view>
          <view class="meta">
            <!-- 价格文案已含单位（如「¥31.4 万 / 台」），这里只补数量，避免重复显示单位 -->
            <view class="price">{{item.priceText}}<text wx:if="{{item.qty}}" class="p-unit">× {{item.qty}}{{item.unit}}</text></view>
            <!-- 与普通商品卡同一行：品牌 · 城市 -->
            <view wx:if="{{item.cardSub}}" class="sub">{{item.cardSub}}</view>
            <!-- 已领取列表里不再提示「已有 N 家领取 / 匹配了哪条需求」，这些信息在领取前才有意义 -->
            <view wx:if="{{item.demandText && !item.closed && state !== 'claimed'}}" class="sub">{{item.demandText}}</view>
            <view wx:if="{{item.claimText && state !== 'claimed'}}" class="sub">{{item.claimText}}</view>
          </view>
        </view>
        <!-- 匹配依据：复用普通商品卡，只在卡片下方多这一行说明命中原因 -->
        <view wx:if="{{item.matchText || item.matchModel}}" class="op-match">
          <text class="om-t">匹配依据</text>
          <text wx:if="{{item.matchModel}}" class="om-model">{{item.matchModel}}</text>
          <text wx:if="{{item.matchText}}" class="om-via">{{item.matchText}}</text>
        </view>
        <!-- 底部与普通商品卡一致：左侧浏览量，右侧状态；「我的商机」里全是已领取，
             不再重复标「已领取」 -->
        <view class="foot">
          <text>浏览 {{item.views}}</text>
          <text wx:if="{{item.closed}}" class="hot">{{item.statusText || '已结束'}}</text>
          <text wx:elif="{{item.claimed && state !== 'claimed'}}" class="hot brand">已领取</text>
          <text wx:elif="{{item.unsatisfied}}" class="hot">已标记不满足</text>
          <view wx:if="{{item.closed || item.expireText}}" class="r">{{item.closed ? '已结束，仅供回看' : item.expireText}}</view>
          <!-- 我的商机：删除与浏览量同一行、保持同高，只靠右对齐，不另起一行 -->
          <text
            wx:if="{{item.claimed && (mineMode || listMode)}}"
            class="foot-del"
            data-id="{{item.id}}"
            data-type="{{item.type}}"
            catchtap="deleteOpp"
          >删除</text>
        </view>
      </view>
    </view>

    <!-- 下滑加载更多：默认 10 条，继续下滑追加 -->
    <view wx:if="{{filteredCount > items.length}}" class="bz-more">下滑查看其余 {{filteredCount - items.length}} 条商机</view>

    <view wx:if="{{!items.length}}" class="empty">
      <image class="big-img" src="/assets/icons/empty-target.png" mode="aspectFit" />
      <view class="ttl">{{state === 'claimed' ? '还没有领取过商机' : (state === 'unsatisfied' ? '没有标记不满足的商机' : '暂无匹配商机')}}</view>
      <view class="ds">{{state === 'claimed' ? '领取后的商机会保存在这里，点开可查看联系方式并发起对话' : (state === 'unsatisfied' ? '在商机页逐项确认后标记「不满足」的商机会保留在这里，不再角标提醒，可随时重新查看' : '只展示和你库存的型号、成色、起订量匹配的需求，以及和你求购需求匹配的货源；普通发布自动匹配，私密发布不参与。未公开主体的商机以脱敏主体展示，可点「查看主页」了解发布者。')}}</view>
      <view wx:if="{{mineMode}}" class="acts">
        <button class="btn primary" bindtap="goAllBiz">去看可领取商机</button>
      </view>
      <view wx:elif="{{listMode}}" class="acts">
        <button class="btn primary" bindtap="goBack">返回商机</button>
      </view>
      <view wx:else class="acts">
        <button class="btn primary" bindtap="goStock">完善我的库存</button>
      </view>
    </view>
  </block>

  <!-- 开通弹层：套餐 + 开通按钮，付款后自动加时长 -->
  <view wx:if="{{sheetOpen}}" class="m-mask" bindtap="closeSheet"></view>
  <view wx:if="{{sheetOpen}}" class="m-sheet">
    <view class="ms-hd">
      <text>{{unlocked ? '续费商机会员' : '开通商机会员'}}</text>
      <text class="ms-x" bindtap="closeSheet">✕</text>
    </view>
    <view class="ms-price">
      <text class="ms-p">{{selectedPlan ? '¥ ' + selectedPlan.price : plan}}</text>
      <text class="ms-d">{{selectedPlan ? selectedPlan.label + ' · ' + selectedPlan.termText : plan}} · {{stats.matched}} 条商机待解锁</text>
    </view>

    <!-- 四档套餐：价格 / 天数由管理端设置页维护，选中后按该档下单 -->
    <view wx:if="{{plans.length}}" class="ms-plans">
      <view
        wx:for="{{plans}}"
        wx:key="key"
        class="ms-plan {{planKey === item.key ? 'on' : ''}}"
        data-key="{{item.key}}"
        bindtap="selectPlan"
      >
        <view class="pl-hd">
          <text class="pl-label">{{item.label}}</text>
          <text wx:if="{{item.saving}}" class="pl-save">省 {{item.saving}}</text>
        </view>
        <view class="pl-price"><text class="pl-y">¥</text>{{item.price}}</view>
        <view class="pl-meta">
          <text class="pl-days">{{item.termText}}</text>
          <text wx:if="{{item.original > item.price}}" class="pl-origin">原价 ¥{{item.original}}</text>
        </view>
      </view>
    </view>
    <view wx:if="{{plans.length}}" class="ms-plans-tip">到期前续费按所选档位累加时长，不打断当前权限</view>

    <view class="ms-note">微信支付，付款后自动延长会员时长；开通后本页立即显示商机价格与匹配详情，需求类可领取联系方式。</view>
    <button wx:if="{{remote}}" class="btn primary block" bindtap="applyUnlock" loading="{{paying}}" disabled="{{paying}}">{{unlocked ? '确认续费' : '确认开通'}}{{selectedPlan ? ' · ¥' + selectedPlan.price : ''}}</button>
    <view wx:if="{{!remote}}" class="ms-demo" bindtap="demoActivate">原型演示：模拟客服已开通</view>
  </view>

  <!-- 商机提示设置：显示时间 + 匹配力度（分类 / 排序 / 型号已移到列表上方的筛选栏） -->
  <view wx:if="{{prefOpen}}" class="m-mask" bindtap="closePref"></view>
  <view wx:if="{{prefOpen}}" class="m-sheet pf-sheet">
    <view class="ms-hd">
      <text>商机提示设置</text>
      <text class="ms-x" bindtap="closePref">✕</text>
    </view>

    <!-- 设置项区域单独滚动，底部「保存」常驻，不随内容移动 -->
    <view class="pf-body">
    <view class="pf-sec">
      <view class="pf-sec-hd">
        <text class="pf-sec-t">显示时间</text>
        <text class="pf-sec-s">只看这段时间内发布的商机</text>
      </view>
      <view class="pf-opts">
        <text wx:for="{{dayOptions}}" wx:key="key"
              class="pf-opt {{prefs.days === item.key ? 'on' : ''}}"
              data-key="{{item.key}}" bindtap="pickDays">{{item.label}}</text>
        <text class="pf-opt {{daysCustom ? 'on' : ''}}" data-key="custom" bindtap="pickDays">手动设置</text>
      </view>
      <view wx:if="{{daysCustom}}" class="pf-days-input">
        <input class="pf-input" type="number" value="{{daysInput}}" placeholder="输入 1-90 天"
               bindinput="bindDaysInput" bindconfirm="confirmDays" />
        <text class="pf-days-unit">天内</text>
        <view class="pf-days-ok" bindtap="confirmDays">确定</view>
      </view>
    </view>

    <view class="pf-sec">
      <view class="pf-sec-hd">
        <text class="pf-sec-t">匹配力度</text>
        <text class="pf-sec-s">力度越宽松，匹配到的商机越多</text>
      </view>
      <view class="pf-levels">
        <view wx:for="{{prefLevels}}" wx:key="key"
              class="pf-level {{prefs.level === item.key ? 'on' : ''}}"
              data-key="{{item.key}}" bindtap="pickPrefLevel">
          <text class="pf-name">{{item.name}}</text>
          <text class="pf-desc">{{item.desc}}</text>
        </view>
      </view>
    </view>

    <!-- 主体信息：独立于匹配力度，切换后立即保存并刷新列表 -->
    <view class="pf-sec">
      <view class="pf-sec-hd">
        <text class="pf-sec-t">主体信息</text>
        <text class="pf-sec-s">开启后只显示公开主体的商机</text>
      </view>
      <view class="pf-opts">
        <text wx:for="{{prefSubjectOptions}}" wx:key="key"
              class="pf-opt {{prefSubject === item.key ? 'on' : ''}}"
              data-key="{{item.key}}" bindtap="pickSubject">{{item.label}}</text>
      </view>
    </view>

    <view class="pf-dims">
      <view wx:for="{{prefDims}}" wx:key="key" class="pf-dim">
        <view class="pf-dim-hd">
          <text class="pf-dim-t">{{item.name}}</text>
          <text class="pf-dim-tag">{{item.extra || '可单独微调'}}</text>
        </view>
        <view class="pf-opts">
          <text wx:for="{{item.options}}" wx:for-item="opt" wx:key="key"
                class="pf-opt {{item.value === opt.key ? 'on' : ''}}"
                data-dim="{{item.key}}" data-key="{{opt.key}}" bindtap="pickPrefDim">{{opt.label}}</text>
        </view>
        <!-- 指定城市多选：按大区分组，点一下加入 / 取消，不选则视为不限地区 -->
        <view wx:if="{{item.key === 'city' && prefs.city === 'pick'}}" class="pf-cities">
          <view class="pf-city-hd">
            <text class="pf-city-s">{{prefCityText || '不选城市时按不限地区匹配'}}</text>
            <text wx:if="{{prefCityText}}" class="pf-city-clear" bindtap="clearPrefCities">清空</text>
          </view>
          <view wx:for="{{prefCityGroups}}" wx:for-item="grp" wx:key="p" class="pf-city-grp">
            <text class="pf-city-grp-t">{{grp.p}}</text>
            <view class="pf-city-list">
              <text wx:for="{{grp.cities}}" wx:for-item="c" wx:key="name"
                    class="pf-city {{c.on ? 'on' : ''}}"
                    data-city="{{c.name}}" bindtap="togglePrefCity">{{c.name}}</text>
            </view>
          </view>
        </view>
      </view>
    </view>
    <view class="pf-note">例：只要 B300、数量少一点也能接 → 选「宽松」；不只做本地、只接深圳 / 北京 / 上海的商机 → 城市选「指定城市」并多选；报价必须在预算内 → 把「价格」调紧；4T 也能接受 3T → 把「容量」调成「容量不限」。价格按对方预算 / 采购价比对，任一方没填价格时不作限制。</view>
    </view>
    <button class="btn primary block pf-save" bindtap="savePref" loading="{{prefSaving}}" disabled="{{prefSaving}}">保存并重新匹配</button>
  </view>

  <!-- 朋友圈单页模式：只展示被分享的这一页，领取 / 联系等入口需进入完整小程序 -->
  <view wx:if="{{singlePage}}" class="sp-bar">朋友圈预览 · 点右上角 ··· 选择「前往小程序」查看完整功能</view>
</view>
