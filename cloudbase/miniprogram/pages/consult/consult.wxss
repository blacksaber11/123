.consult-page {
  min-height: 100vh;
  background: var(--paper);
  padding-bottom: 200rpx;
  box-sizing: border-box;
}

/* 顶部说明 */
.top-callout {
  margin: 20rpx 24rpx;
}

/* 区块 */
.block {
  background: #fff;
  margin: 20rpx 24rpx;
  border-radius: var(--radius);
  border: 1rpx solid var(--line);
  padding: 28rpx;
  box-shadow: var(--shadow);
}
.block-hd {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 20rpx;
}
.block-hd .bt {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--ink);
}
.block-hd .r {
  margin-left: auto;
  font-size: 22rpx;
  color: var(--muted);
}

/* 价格行 */
.price-row {
  display: flex;
  align-items: flex-end;
  gap: 16rpx;
  margin-bottom: 12rpx;
}
.price-row .p {
  flex: none;
  white-space: nowrap;
  font-size: 40rpx;
  font-weight: 800;
  letter-spacing: -.02em;
  line-height: 1.1;
  color: var(--ink);
}
.price-row .p.price-sm {
  font-size: 40rpx;
}
.price-row .p .p-unit {
  font-size: 22rpx;
  font-weight: 400;
  color: var(--muted);
  margin-left: 4rpx;
}
.price-row .pn {
  margin-left: auto;
  font-size: 22rpx;
  color: var(--muted);
  text-align: right;
  line-height: 1.6;
  white-space: pre-line;
}

/* 只读规格（设备类型 / 品牌 / 型号） */
.spec-lines {
  margin-top: 16rpx;
  border-top: 1rpx solid var(--line-2);
}
.spec-line {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  padding: 10rpx 0;
  border-bottom: 1rpx dashed var(--line-2);
}
.spec-line:last-child {
  border-bottom: none;
}
.spec-line .sl-k {
  flex: none;
  width: 180rpx;
  font-size: 22rpx;
  color: var(--muted);
  line-height: 1.6;
}
.spec-line .sl-v {
  flex: 1;
  min-width: 0;
  font-size: 24rpx;
  font-weight: 500;
  color: var(--ink);
  line-height: 1.6;
}

/* 表单区 */
.form-sec {
  background: #fff;
  margin: 20rpx 24rpx;
  border-radius: var(--radius);
  border: 1rpx solid var(--line);
  padding: 28rpx;
  box-shadow: var(--shadow);
}
.form-sec .sh {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 20rpx;
}
.form-sec .sh .st {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--ink);
}
.form-sec .sh .sd {
  font-size: 22rpx;
  color: var(--muted);
  margin-left: auto;
}

.field {
  margin-bottom: 26rpx;
}
.field:last-child {
  margin-bottom: 0;
}
.field .f-label {
  display: block;
  font-size: 24rpx;
  font-weight: 600;
  color: var(--ink-2);
  margin-bottom: 12rpx;
}
.field .req {
  color: var(--danger);
  margin-left: 4rpx;
}
.field .opt {
  font-weight: 400;
  color: var(--muted);
  font-size: 22rpx;
  margin-left: 8rpx;
}
.field input,
.field textarea {
  width: 100%;
  border: 1rpx solid var(--line);
  border-radius: 12rpx;
  background: #fff;
  padding: 18rpx 20rpx;
  font-size: 26rpx;
  color: var(--ink);
  line-height: 1.6;
  box-sizing: border-box;
}
.field input {
  height: 72rpx;
}
/* 微信授权手机号：只读展示，视觉与输入框一致但不可编辑 */
.field .f-info {
  width: 100%;
  height: 72rpx;
  line-height: 72rpx;
  border: 1rpx solid var(--line);
  border-radius: 12rpx;
  background: var(--paper);
  padding: 0 20rpx;
  font-size: 26rpx;
  color: var(--ink-2);
  box-sizing: border-box;
}
.field .tip {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--muted);
  line-height: 1.5;
}

.chip-group {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

/* 换行文本（替代 HTML <br>） */
.br-line {
  display: block;
  line-height: 1.65;
}
.br-line + .br-line {
  margin-top: 4rpx;
}

/* 条件列表 */
.cond-list {
  border-top: 1rpx solid var(--line-2);
}
.ci {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--line-2);
}
.ci:last-child {
  border-bottom: none;
}
.ci-ico {
  flex: none;
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: var(--line-2);
  color: var(--muted);
  font-size: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 2rpx;
}
.ci-ico.ok {
  background: var(--brand-soft);
  color: var(--brand);
}
.ci-ico.bad {
  background: var(--warn-soft);
  color: var(--warn);
}
.ci-body {
  flex: 1;
  min-width: 0;
}
.ci-name {
  font-size: 26rpx;
  color: var(--ink);
  font-weight: 500;
  margin-bottom: 4rpx;
  line-height: 1.5;
}
.ci-desc {
  font-size: 22rpx;
  color: var(--muted);
  line-height: 1.6;
}
/* 满足 / 不满足按钮左右并排展示 */
.ci-confirm {
  flex: none;
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 12rpx;
}
.cc-btn {
  font-size: 20rpx;
  line-height: 44rpx;
  padding: 0 16rpx;
  border-radius: 8rpx;
  border: 1rpx solid var(--line);
  color: var(--muted);
  background: #fff;
  text-align: center;
}
.cc-btn.on {
  background: var(--brand-soft);
  border-color: var(--brand-line);
  color: var(--brand);
  font-weight: 600;
}
.cc-btn.on.bad {
  background: var(--warn-soft);
  border-color: #FFD4B3;
  color: var(--warn);
}

/* 流程列表 */
.flow-list {
  display: flex;
  flex-direction: column;
}
.flow-item {
  display: flex;
  gap: 20rpx;
  position: relative;
  padding-bottom: 28rpx;
}
.flow-item:last-child {
  padding-bottom: 0;
}
.flow-item::before {
  content: '';
  position: absolute;
  left: 22rpx;
  top: 48rpx;
  bottom: 0;
  width: 2rpx;
  background: var(--line);
}
.flow-item:last-child::before {
  display: none;
}
.fi-idx {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
  font-weight: 700;
  background: #fff;
  border: 1rpx solid var(--line);
  color: var(--muted);
  z-index: 1;
}
.fi-content {
  padding-top: 6rpx;
}
.fi-name {
  font-size: 24rpx;
  font-weight: 600;
  line-height: 1.5;
  color: var(--ink);
}
.fi-desc {
  font-size: 22rpx;
  color: var(--muted);
  line-height: 1.6;
  margin-top: 2rpx;
}

/* 上传网格 */
.upload-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
  margin-top: 20rpx;
}
.upload-item {
  position: relative;
  aspect-ratio: 1;
  border-radius: 16rpx;
  overflow: hidden;
  background: var(--line-2);
  border: 1rpx solid var(--line);
}
.upload-item image {
  width: 100%;
  height: 100%;
}
/* 材料缩略图水印：绑定查看人账号，浏览时始终可见，提示不可截图 / 下载 */
.upload-item .up-wm {
  position: absolute;
  inset: 0;
  z-index: 2;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 8rpx;
  transform: rotate(-18deg);
  font-size: 15rpx;
  line-height: 1.35;
  text-align: center;
  color: rgba(255, 255, 255, .88);
  text-shadow: 0 1rpx 2rpx rgba(0, 0, 0, .55);
  white-space: normal;
  word-break: break-all;
  pointer-events: none;
}
/* 图片 / 视频分组标题 */
.up-hd {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 24rpx;
}
.up-t {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--ink);
}
.up-c {
  font-size: 22rpx;
  color: var(--muted);
}
.upload-item video {
  width: 100%;
  height: 100%;
}
/* 自定义文件名：显示在缩略图底部 */
.upload-item .up-name {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 3;
  padding: 4rpx 8rpx;
  background: rgba(0, 0, 0, .55);
  color: #fff;
  font-size: 18rpx;
  line-height: 1.3;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
/* 命名 / 删除操作 */
.upload-item .up-ops {
  position: absolute;
  top: 6rpx;
  left: 6rpx;
  z-index: 3;
  display: flex;
  gap: 6rpx;
}
.up-btn {
  padding: 2rpx 10rpx;
  border-radius: 8rpx;
  background: rgba(0, 0, 0, .55);
  color: #fff;
  font-size: 18rpx;
  line-height: 1.6;
}
.up-btn.danger {
  background: rgba(192, 57, 43, .82);
}
.upload-add {
  aspect-ratio: 1;
  border-radius: 16rpx;
  border: 2rpx dashed var(--line);
  background: var(--line-2);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
}
.add-ico {
  width: 36rpx;
  height: 36rpx;
  display: block;
}
.add-txt {
  font-size: 22rpx;
  color: var(--muted);
}

/* 底部提交 */
.submit-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #fff;
  border-top: 1rpx solid var(--line);
  padding: 16rpx 24rpx;
  z-index: 100;
  display: flex;
  align-items: center;
  gap: 20rpx;
}
.sb-info {
  flex: 1;
  min-width: 0;
}
.sb-tip {
  font-size: 24rpx;
  color: var(--ink);
  font-weight: 500;
  margin-bottom: 4rpx;
}
.sb-note {
  font-size: 20rpx;
  color: var(--muted);
}
.submit-bar .btn {
  flex: none;
  /* 与商品页 / 需求页底部主操作同一尺寸（.btn.lg） */
  height: 92rpx;
  padding: 0 32rpx;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 18rpx;
}
.submit-bar .btn[disabled] {
  background: var(--line-2);
  border-color: var(--line);
  color: #A1A1AA;
}
