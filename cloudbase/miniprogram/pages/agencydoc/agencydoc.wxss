page {
  background: var(--line-2);
}
.doc {
  padding: 28rpx 24rpx calc(48rpx + env(safe-area-inset-bottom));
}
.doc-hd {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  margin: 0 4rpx 20rpx;
}
.doc-t {
  font-size: 40rpx;
  font-weight: 700;
  color: #18181B;
}
.doc-v {
  font-size: 22rpx;
  color: var(--muted);
}
.doc-hero {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  border-radius: 20rpx;
  background: #EAF6F0;
  border: 1rpx solid #BFE3D2;
}
.dh-t {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--brand);
}
.dh-d {
  font-size: 24rpx;
  line-height: 1.75;
  color: var(--ink-2);
}
.doc-sec {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  border-radius: 20rpx;
  background: #FFFFFF;
  border: 1rpx solid var(--line);
}
.ds-h {
  font-size: 28rpx;
  font-weight: 600;
  color: #18181B;
}
.ds-p {
  font-size: 24rpx;
  line-height: 1.75;
  color: #52525B;
}
.fee-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 14rpx 0;
  border-bottom: 1rpx dashed var(--line);
  font-size: 25rpx;
}
.fee-row:last-of-type {
  border-bottom: none;
}
.fee-k {
  color: var(--muted);
}
.fee-v {
  color: var(--ink);
  font-weight: 600;
}
.step {
  display: flex;
  gap: 16rpx;
}
.step-no {
  flex: none;
  width: 40rpx;
  height: 40rpx;
  margin-top: 2rpx;
  border-radius: 50%;
  background: #EEF0FF;
  color: var(--brand);
  font-size: 22rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}
.step-i {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  padding-bottom: 18rpx;
}
.step:last-child .step-i {
  padding-bottom: 0;
}
.step-t {
  font-size: 26rpx;
  font-weight: 600;
  color: #18181B;
}
.step-d {
  font-size: 24rpx;
  line-height: 1.7;
  color: #52525B;
}
.doc-ft {
  padding: 12rpx 8rpx 0;
  font-size: 21rpx;
  line-height: 1.7;
  color: var(--muted);
  text-align: center;
}
