<view class="login-page">
  <!-- 顶部品牌区：只保留必要信息，避免一进来就被大段说明淹没 -->
  <view class="lg-hero">
    <view class="lg-logo">算</view>
    <view class="lg-title">算力聚合</view>
    <view class="lg-sub">{{loading ? '正在获取微信身份…' : (needPhone ? '微信已登录，补充资料即可开始' : (error ? '登录遇到问题，请重试' : '使用微信身份快速登录'))}}</view>
  </view>

  <view class="lg-card">
    <!-- 登录中 -->
    <view wx:if="{{loading}}" class="lg-state">
      <view class="lg-spinner"></view>
      <text class="lg-state-t">请稍候</text>
    </view>

    <!-- 需要补手机号：头像 / 昵称 / 手机号 三块，一步完成 -->
    <block wx:elif="{{needPhone}}">
      <view class="lg-head">
        <text class="lg-head-t">完善资料</text>
        <text class="lg-head-s">手机号必填</text>
      </view>

      <!-- 头像 + 昵称 -->
      <view class="lg-profile">
        <button class="lg-avatar" open-type="chooseAvatar" hover-class="none" bindchooseavatar="onChooseAvatar">
          <image wx:if="{{avatar}}" class="lg-avatar-img" src="{{avatar}}" mode="aspectFill" show-menu-by-longpress="false"/>
          <view wx:else class="lg-avatar-ph">
            <text class="lg-avatar-plus">＋</text>
            <text class="lg-avatar-t">头像</text>
          </view>
        </button>
        <view class="lg-field">
          <view class="lg-label">昵称 <text class="lg-optional">选填</text></view>
          <input
            class="lg-input"
            type="nickname"
            value="{{nick}}"
            placeholder="点击使用微信昵称"
            bindinput="onNickInput"
          />
        </view>
      </view>

      <!-- 手机号：一行说明 + 授权按钮 -->
      <view class="lg-phone">
        <view class="lg-phone-ic">手</view>
        <view class="lg-phone-main">
          <view class="lg-phone-t">{{phoneMasked || '手机号'}}</view>
          <view class="lg-phone-s">用于交易对接与重要提醒</view>
        </view>
        <text class="lg-phone-tag">必填</text>
      </view>

      <!-- 隐私协议未同意时先走这一步，否则手机号接口会被微信直接拒绝 -->
      <button
        wx:if="{{privacyNeed}}"
        class="btn primary lg-btn"
        open-type="agreePrivacyAuthorization"
        bindagreeprivacyauthorization="onAgreePrivacy"
      >同意隐私保护指引并继续</button>
      <button
        wx:else
        class="btn primary lg-btn"
        open-type="getPhoneNumber"
        bindgetphonenumber="getPhone"
        loading="{{phoneLoading}}"
        disabled="{{phoneLoading}}"
      >微信一键授权手机号</button>

      <!-- 快捷验证不可用时的兜底：手填手机号，不再卡在登录页 -->
      <view wx:if="{{phoneFail}}" class="lg-fail">
        <view class="lg-fail-t">{{phoneFail}}</view>
        <view wx:if="{{manual}}" class="lg-manual">
          <input
            class="lg-manual-i"
            type="number"
            maxlength="11"
            placeholder="请输入 11 位手机号"
            value="{{manualPhone}}"
            bindinput="onManualInput"
          />
          <button class="btn primary lg-btn" bindtap="saveManual" loading="{{manualLoading}}" disabled="{{manualLoading}}">保存并登录</button>
        </view>
        <view wx:else class="lg-manual-link" bindtap="toggleManual">手动填写手机号 ›</view>
      </view>

      <view class="lg-skip" bindtap="skip">暂不登录，先逛逛</view>
      <view class="lg-agree">
        登录即同意<text class="lg-link" bindtap="openTerms">《用户协议》</text>与<text class="lg-link" bindtap="openPrivacy">《隐私政策》</text>
      </view>
    </block>

    <!-- 静默登录失败 -->
    <block wx:else>
      <view wx:if="{{error}}" class="lg-error">{{error}}</view>
      <button class="btn primary lg-btn" bindtap="retry">{{error ? '重新登录' : '微信一键登录'}}</button>
      <view class="lg-skip" bindtap="skip">{{error ? '先逛逛' : '暂不登录，先逛逛'}}</view>
      <view class="lg-agree">
        登录即同意<text class="lg-link" bindtap="openTerms">《用户协议》</text>与<text class="lg-link" bindtap="openPrivacy">《隐私政策》</text>
      </view>
    </block>
  </view>

  <view class="lg-foot">手机号不对外展示</view>
</view>
